    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    <script>

        function calculateDistance(lat1, lon1, lat2, lon2, unit = "km") {
            const R = 6371; // Radius of the Earth in kilometers
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;

            const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                        Math.sin(dLon / 2) * Math.sin(dLon / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

            let distance = R * c; // Distance in kilometers

            // Convert to other units if needed
            if (unit === 'miles') distance = distance * 0.621371;
            if (unit === 'meters') distance = distance * 1000;

            return distance;
        }


        //load trackers
        //var tracker_ids = ;

        // Collect points and format into an efficient map for recall later

        var circleIcon;
        var points = new Map();
        var trackers = [];// ;
        var allTrackers = [];
        var trackerColors = {};
        var disabledTrackers = {};
        var trackerColorPalette = ['#3388ff', '#ff3b30', '#34a853', '#8e44ad', '#f39c12', '#1abc9c', '#e67e22', '#2c3e50'];
        var DTP;
        var map;
        var linesGroup;
        var transitionGroup;
        var liveMarkersGroup;
        var liveTrackerExtensionLines = new Map();
        var segmentLayers = [];
        var renderedPointMarkersById = new Map();
        var highlightedSegment = null;
        var detectedSegments = [];
        var selectedSegmentId = null;
        var selectedSegmentPointIndex = 0;
        var segmentDebugStatusTimer = null;
        var manualUpdatesClientId = null;
        var manualUpdatesKeepAliveTimer = null;
        var manualUpdatesFollowTimer = null;
        var manualUpdatesKeepAliveSeconds = 20;
        var activeSearchFollowsNow = true;
        var isHydratingStartupSettings = true;
        var startupSettingsSnapshot = null;
        var pointsRequestInFlight = null;
        var pendingPointsRequest = null;
        var pointsRequestTimeoutMs = 30000;
        var pointsRequestTimeoutTimer = null;
        var pointsRequestSequence = 0;
        var stopDetectionRadiusMeters = 125;
        var stopDetectionMinPoints = 4;
        var stopDetectionMinSeconds = 180;
        var stopDetectionWindowPoints = 6;
        var stopDetectionExitPoints = 3;
        var stopDetectionSampleIntervalSeconds = 30;

        function createDefaultSettingsState() {
            return {
                trackerId: 'all_trackers',
                quickHoursValue: '',
                quickDaysValue: '',
                quickDaysAgoValue: '',
                liveTrackerScope: 'current',
                manualMqttIntervalSeconds: '30',
                accuracyLimit: '150',
                stopDetectionRadiusMeters: 125,
                stopDetectionMinSeconds: 180,
                stopDetectionWindowPoints: 6,
                stopDetectionExitPoints: 3,
                stopDetectionSampleIntervalSeconds: 30,
                segmentNavigationMode: 'travel',
                showIndividualPoints: true,
                trackerColors: {},
                disabledTrackers: {},
                timeframeStartDate: null,
                timeframeEndDate: null,
                timeframeFollowsNow: false,
                timeframeDurationMs: null,
                timeframeEndOffsetMs: null,
                timeframeAnchoredToDayStart: false,
            };
        }

        var settingsState = createDefaultSettingsState();

        function hydrateSettingsState(settings = {}) {
            const sourceSettings = settings && typeof settings === 'object' ? settings : {};
            const mergedSettings = {
                ...createDefaultSettingsState(),
                ...settingsState,
                ...sourceSettings,
            };
            settingsState = mergedSettings;
            trackerColors = settingsState.trackerColors && typeof settingsState.trackerColors === 'object'
                ? { ...settingsState.trackerColors }
                : {};
            disabledTrackers = settingsState.disabledTrackers && typeof settingsState.disabledTrackers === 'object'
                ? { ...settingsState.disabledTrackers }
                : {};
            return settingsState;
        }

        const Transition = {
            STOP_TO_MOVING: "STOP_TO_MOVING",
            MOVING_TO_STOP: "MOVING_TO_STOP",
        }

        const Mode = {
            MOVING: "MOVING",
            STOP: "STOP",
        }

        function getTrackerColor(trackerId) {
            if (!trackerId) {
                return '#3388ff';
            }
            if (!trackerColors[trackerId]) {
                const paletteIndex = trackers.indexOf(trackerId);
                trackerColors[trackerId] = trackerColorPalette[paletteIndex % trackerColorPalette.length] || '#3388ff';
            }
            return trackerColors[trackerId];
        }

        function isTrackerEnabled(trackerId) {
            if (!trackerId) {
                return true;
            }

            const selectedTrackerId = getCurrentSelectedTrackerId();
            if (selectedTrackerId && selectedTrackerId !== 'all_trackers' && selectedTrackerId === trackerId) {
                return true;
            }

            return !Boolean(disabledTrackers && disabledTrackers[trackerId]);
        }

        function getTrackerShortId(trackerId) {
            if (!trackerId) {
                return '--';
            }
            const compact = String(trackerId).replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
            if (!compact.length) {
                return '--';
            }
            return compact.slice(0, 2);
        }

        function getCurrentSelectedTrackerId() {
            const trackerSelect = document.getElementById('selTrackers');
            if (trackerSelect && trackerSelect.value) {
                return trackerSelect.value;
            }

            const stateTrackerId = settingsState && settingsState.trackerId;
            if (stateTrackerId) {
                return stateTrackerId;
            }

            const savedSettings = loadSettings();
            if (savedSettings && savedSettings.trackerId) {
                return savedSettings.trackerId;
            }

            const queryTrackerId = new URLSearchParams(window.location.search).get('tracker_id');
            return queryTrackerId || 'all_trackers';
        }

        function isAllTrackersSelected() {
            return getCurrentSelectedTrackerId() === 'all_trackers';
        }

        function updatePerformanceModeUi() {
            const status = document.getElementById('performanceModeStatus');
            if (!status) {
                return;
            }

            const enabled = isAllTrackersSelected();
            status.textContent = enabled
                ? 'Performance mode active for all-trackers view'
                : '';
            status.classList.toggle('active', enabled);
            status.classList.toggle('hidden', !enabled);
        }

        function isAutoMqttUpdateEnabled() {
            return getManualMqttIntervalSeconds() > 0;
        }

        function getLiveMarkerTrackerId() {
            if (settingsState && settingsState.liveTrackerScope === 'all') {
                return 'all_trackers';
            }
            const selectedTrackerId = getCurrentSelectedTrackerId();
            return selectedTrackerId || 'all_trackers';
        }

        function createLiveTrackerIcon(trackerId, color) {
            const shortId = getTrackerShortId(trackerId);
            const safeColor = color || '#3388ff';
            const svg = `
                <svg viewBox="0 0 72 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <defs>
                        <filter id="live-shadow-${shortId}" x="-50%" y="-50%" width="200%" height="200%">
                            <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#0f172a" flood-opacity="0.28" />
                        </filter>
                    </defs>
                    <path d="M36 2C19.4 2 6 15.4 6 32c0 21.2 25.8 48.6 29.2 52.1a1 1 0 0 0 1.6 0C40.2 80.6 66 53.2 66 32 66 15.4 52.6 2 36 2z" fill="${safeColor}" filter="url(#live-shadow-${shortId})" />
                    <circle cx="36" cy="32" r="17" fill="#ffffff" fill-opacity="0.96" />
                    <text x="36" y="37" text-anchor="middle" font-size="13" font-family="Arial, sans-serif" font-weight="700" fill="#0f172a">${shortId}</text>
                </svg>
            `;

            return L.divIcon({
                className: 'live-tracker-marker',
                html: `<div class="live-tracker-svg-wrap">${svg}</div>`,
                iconSize: [36, 45],
                iconAnchor: [18, 44],
                popupAnchor: [0, -40],
            });
        }

        function toLatestPointByTracker(pointsMap) {
            const latestPoints = new Map();
            pointsMap.forEach((trackerPoints, trackerId) => {
                const ordered = Array.from(trackerPoints.values()).sort((a, b) => new Date(a.time) - new Date(b.time));
                if (ordered.length) {
                    latestPoints.set(trackerId, ordered[ordered.length - 1]);
                }
            });
            return latestPoints;
        }

        function renderLiveMarkersFromPointsMap(pointsMap) {
            if (!liveMarkersGroup) {
                return;
            }

            liveMarkersGroup.clearLayers();
            const latestPoints = toLatestPointByTracker(pointsMap || new Map());
            latestPoints.forEach((point, trackerId) => {
                const color = getTrackerColor(trackerId);
                const marker = L.marker([point.latitude, point.longitude], {
                    icon: createLiveTrackerIcon(trackerId, color),
                    zIndexOffset: 1000,
                }).addTo(liveMarkersGroup);

                marker.bindPopup(`<strong>${trackerId}</strong><br>Live at ${new Date(point.time).toLocaleString()}`);
            });
        }

        function getActiveTimeRangeSeconds() {
            const picker = $('input[name="datetimes"]').data('daterangepicker');
            return {
                secondsStart: picker.startDate.toDate().getTime() / 1000,
                secondsEnd: picker.endDate.toDate().getTime() / 1000,
            };
        }

        function setPickerToLastOneDay() {
            const picker = $('input[name="datetimes"]').data('daterangepicker');
            if (!picker) {
                return;
            }
            const nowMoment = moment();
            picker.setStartDate(nowMoment.clone().startOf('day'));
            picker.setEndDate(nowMoment);
        }

        function isTimeframeRelativeToNow(endMoment) {
            if (!endMoment) {
                return false;
            }

            const nowMs = Date.now();
            const endMs = endMoment.toDate().getTime();
            const toleranceMs = 90 * 1000;
            return endMs >= (nowMs - toleranceMs);
        }

        function isRangeAnchoredToCurrentDay(startMoment, endMoment, referenceMoment = moment()) {
            if (!startMoment || !endMoment || !referenceMoment) {
                return false;
            }

            return startMoment.isSame(startMoment.clone().startOf('day')) && startMoment.isSame(referenceMoment, 'day') && endMoment.isSame(referenceMoment, 'day');
        }

        function getTimeframeSettingsForSave() {
            const picker = $('input[name="datetimes"]').data('daterangepicker');
            if (!picker || !picker.startDate || !picker.endDate) {
                return {};
            }

            const startDate = picker.startDate.clone();
            const endDate = picker.endDate.clone();
            const followsNow = isTimeframeRelativeToNow(endDate);
            const nowMs = Date.now();

            return {
                timeframeStartDate: startDate.toISOString(),
                timeframeEndDate: endDate.toISOString(),
                timeframeFollowsNow: followsNow,
                timeframeDurationMs: Math.max(0, endDate.valueOf() - startDate.valueOf()),
                timeframeEndOffsetMs: endDate.valueOf() - nowMs,
                timeframeAnchoredToDayStart: followsNow && isRangeAnchoredToCurrentDay(startDate, endDate),
            };
        }

        function applySavedTimeframeSettings(settings) {
            const picker = $('input[name="datetimes"]').data('daterangepicker');
            if (!picker || !settings) {
                return;
            }

            const hasSavedRange = settings.timeframeStartDate && settings.timeframeEndDate;
            if (!hasSavedRange) {
                return;
            }

            const savedStart = moment(settings.timeframeStartDate);
            const savedEnd = moment(settings.timeframeEndDate);
            if (!savedStart.isValid() || !savedEnd.isValid()) {
                return;
            }

            if (settings.timeframeFollowsNow) {
                const nowMoment = moment();
                if (settings.timeframeAnchoredToDayStart) {
                    picker.setStartDate(nowMoment.clone().startOf('day'));
                    picker.setEndDate(nowMoment);
                    return;
                }

                const durationMs = Math.max(0, parseInt(settings.timeframeDurationMs, 10) || 0);
                const endOffsetMs = Number.isFinite(parseInt(settings.timeframeEndOffsetMs, 10))
                    ? parseInt(settings.timeframeEndOffsetMs, 10)
                    : 0;
                const restoredEnd = nowMoment.clone().add(endOffsetMs, 'milliseconds');
                picker.setStartDate(restoredEnd.clone().subtract(durationMs, 'milliseconds'));
                picker.setEndDate(restoredEnd);
                return;
            }

            // Preserve saved historical windows exactly as selected.
            picker.setStartDate(savedStart);
            picker.setEndDate(savedEnd);
        }

        function doesActiveSearchEndNow() {
            const picker = $('input[name="datetimes"]').data('daterangepicker');
            if (!picker || !picker.endDate) {
                return false;
            }

            return isTimeframeRelativeToNow(picker.endDate);
        }

        function shouldFollowTimeframeNow() {
            return doesActiveSearchEndNow() || Boolean(settingsState && settingsState.timeframeFollowsNow);
        }

        function syncPickerRangeToNowPreservingWindow() {
            const picker = $('input[name="datetimes"]').data('daterangepicker');
            if (!picker || !picker.startDate || !picker.endDate) {
                return;
            }

            const currentStart = picker.startDate.clone();
            const currentEnd = picker.endDate.clone();
            const newEnd = moment();

            if (isRangeAnchoredToCurrentDay(currentStart, currentEnd, newEnd)) {
                picker.setStartDate(newEnd.clone().startOf('day'));
                picker.setEndDate(newEnd);
                return;
            }

            const windowMs = Math.max(0, currentEnd.valueOf() - currentStart.valueOf());
            const newStart = newEnd.clone().subtract(windowMs, 'milliseconds');

            picker.setStartDate(newStart);
            picker.setEndDate(newEnd);
        }

        function buildTrackerPointMap(pointsArr, sampleByInterval) {
            const parsedPoints = new Map();
            const safePoints = Array.isArray(pointsArr) ? pointsArr : [];
            safePoints.forEach((tp) => {
                const trackerId = tp && (tp.tracker_id || tp.tid || tp.id);
                const pointItems = Array.isArray(tp && tp.points) ? tp.points : [];
                const filteredPoints = pointItems.reduce((accum, p) => {
                    if (p && p.gps_accuracy <= (document.getElementById('accuracyFilterInput').value || 150)) {
                        p.localTime = new Date(p.time).toLocaleString();
                        accum.set(p.puid, p);
                    }
                    return accum;
                }, new Map());

                const sourcePoints = Array.from(filteredPoints.values());
                const finalPoints = sampleByInterval
                    ? samplePointsByTime(sourcePoints, getStopDetectionSampleIntervalSeconds())
                    : sourcePoints;
                const pointMap = new Map(finalPoints.map((point) => [point.puid, point]));
                if (trackerId && isTrackerEnabled(trackerId)) {
                    parsedPoints.set(trackerId, pointMap);
                }
            });
            return parsedPoints;
        }

        function clearLiveTrackerExtensionLines() {
            if (!(liveTrackerExtensionLines instanceof Map) || !liveTrackerExtensionLines.size) {
                return;
            }

            liveTrackerExtensionLines.forEach((layer) => {
                if (layer && linesGroup && linesGroup.removeLayer) {
                    linesGroup.removeLayer(layer);
                }
            });
            liveTrackerExtensionLines.clear();
        }

        function updateLiveTrackerExtensionLineForTracker(trackerId) {
            if (!linesGroup || !trackerId || trackerId === 'all_trackers') {
                return;
            }

            const trackerPointsMap = points && points.get ? points.get(trackerId) : null;
            const trackerPoints = trackerPointsMap instanceof Map
                ? Array.from(trackerPointsMap.values()).filter(Boolean).sort((left, right) => new Date(left.time) - new Date(right.time))
                : [];

            const existingLayer = liveTrackerExtensionLines.get(trackerId) || null;
            if (trackerPoints.length < 2) {
                if (existingLayer && linesGroup.removeLayer) {
                    linesGroup.removeLayer(existingLayer);
                }
                liveTrackerExtensionLines.delete(trackerId);
                return;
            }

            const latLngs = trackerPoints.map((point) => [point.latitude, point.longitude]);
            if (existingLayer && existingLayer.setLatLngs) {
                existingLayer.setLatLngs(latLngs);
                return;
            }

            const trackerColor = getTrackerColor(trackerId);
            const lineLayer = L.polyline(latLngs, {
                color: trackerColor,
                weight: 2.4,
                opacity: 0.95,
            }).addTo(linesGroup);
            lineLayer._jpBaseStyle = { color: trackerColor, weight: 2.4, opacity: 0.95 };
            liveTrackerExtensionLines.set(trackerId, lineLayer);
        }

        function mergeLatestPointsIntoVisibleTrack(latestTrackerPointsMap) {
            const selectedTrackerId = getCurrentSelectedTrackerId();
            if (!selectedTrackerId || selectedTrackerId === 'all_trackers') {
                return false;
            }

            if (!shouldFollowTimeframeNow()) {
                return false;
            }

            const latestTrackerPoints = latestTrackerPointsMap && latestTrackerPointsMap.get
                ? latestTrackerPointsMap.get(selectedTrackerId)
                : null;
            if (!latestTrackerPoints || !(latestTrackerPoints instanceof Map) || !latestTrackerPoints.size) {
                return false;
            }

            const existingTrackerPoints = points && points.get
                ? points.get(selectedTrackerId)
                : null;
            if (!(existingTrackerPoints instanceof Map)) {
                return false;
            }

            const existingPointList = Array.from(existingTrackerPoints.values()).filter(Boolean);
            const latestExistingPointTime = existingPointList.reduce((max, point) => {
                const pointTime = point && point.time ? new Date(point.time).getTime() : null;
                if (!Number.isFinite(pointTime)) {
                    return max;
                }
                return Math.max(max, pointTime);
            }, Number.NEGATIVE_INFINITY);

            let addedAnyPoint = false;
            latestTrackerPoints.forEach((candidatePoint, candidateKey) => {
                if (!candidatePoint) {
                    return;
                }

                const pointTime = candidatePoint.time ? new Date(candidatePoint.time).getTime() : null;
                const candidatePuid = candidatePoint.puid || candidateKey || `${candidatePoint.time || ''}:${candidatePoint.latitude || ''}:${candidatePoint.longitude || ''}`;
                if (!candidatePuid || !Number.isFinite(pointTime)) {
                    return;
                }

                if (existingTrackerPoints.has(candidatePuid)) {
                    return;
                }

                if (Number.isFinite(latestExistingPointTime) && pointTime <= latestExistingPointTime) {
                    return;
                }

                existingTrackerPoints.set(candidatePuid, {
                    ...candidatePoint,
                    puid: candidatePuid,
                    localTime: candidatePoint.localTime || (candidatePoint.time ? new Date(candidatePoint.time).toLocaleString() : null),
                });
                addedAnyPoint = true;
            });

            return addedAnyPoint;
        }

        function refreshLiveMarkers(options = {}) {
            const mergeIntoTrackLines = options.mergeIntoTrackLines !== false;
            if (!isAutoMqttUpdateEnabled()) {
                renderLiveMarkersFromPointsMap(points);
                return;
            }

            const liveTrackerId = getLiveMarkerTrackerId();
            fetch(`/points/latest?tracker_id=${encodeURIComponent(liveTrackerId)}`)
                .then((response) => response.json())
                .then((response) => {
                    const trackerGroups = Array.isArray(response.trackers) ? response.trackers : [];
                    const latestTrackerPointsMap = buildTrackerPointMap(trackerGroups, false);

                    if (mergeIntoTrackLines && mergeLatestPointsIntoVisibleTrack(latestTrackerPointsMap)) {
                        updateLiveTrackerExtensionLineForTracker(getCurrentSelectedTrackerId());
                        renderLiveMarkersFromPointsMap(latestTrackerPointsMap);
                        return;
                    }

                    renderLiveMarkersFromPointsMap(latestTrackerPointsMap);
                })
                .catch((err) => {
                    console.warn('Unable to load live tracker markers', err);
                    renderLiveMarkersFromPointsMap(points);
                });
        }

        function saveSettings(options = {}) {
            try {
                const saveSource = options && options.source ? options.source : '';
                const forceSave = Boolean(options && options.force);
                if (isHydratingStartupSettings && !forceSave && saveSource !== 'tracker-select') {
                    return;
                }

                const existingSettings = loadSettings() || {};
                const trackerSelect = document.getElementById('selTrackers');
                const selectHasOptions = Boolean(trackerSelect && trackerSelect.options && trackerSelect.options.length);
                let selectedTrackerId = selectHasOptions
                    ? (trackerSelect.value || existingSettings.trackerId || 'all_trackers')
                    : (existingSettings.trackerId || 'all_trackers');

                const existingTrackerId = existingSettings.trackerId || 'all_trackers';
                const preserveExistingSpecificTracker =
                    saveSource !== 'tracker-select' &&
                    selectedTrackerId === 'all_trackers' &&
                    existingTrackerId !== 'all_trackers';

                if (preserveExistingSpecificTracker) {
                    selectedTrackerId = existingTrackerId;
                }

                const timeframeSettings = getTimeframeSettingsForSave();
                const quickHoursInput = document.getElementById('inp_quick_hours');
                const quickDaysInput = document.getElementById('inp_quick_days');
                const quickDaysAgoInput = document.getElementById('inp_quick_days_ago');
                const nextSettings = hydrateSettingsState({
                    ...existingSettings,
                    ...settingsState,
                    trackerId: selectedTrackerId,
                    ...timeframeSettings,
                    quickHoursValue: quickHoursInput ? quickHoursInput.value : '',
                    quickDaysValue: quickDaysInput ? quickDaysInput.value : '',
                    quickDaysAgoValue: quickDaysAgoInput ? quickDaysAgoInput.value : '',
                    liveTrackerScope: document.getElementById('liveTrackerScopeSelect').value || 'current',
                    manualMqttIntervalSeconds: document.getElementById('manualMqttIntervalSelect').value,
                    accuracyLimit: document.getElementById('accuracyFilterInput').value,
                    stopDetectionRadiusMeters: document.getElementById('stopDetectionRadiusInput').value,
                    stopDetectionMinSeconds: document.getElementById('stopDetectionMinSecondsInput').value,
                    stopDetectionWindowPoints: document.getElementById('stopDetectionWindowPointsInput').value,
                    stopDetectionExitPoints: document.getElementById('stopDetectionExitPointsInput').value,
                    stopDetectionSampleIntervalSeconds: document.getElementById('stopDetectionSampleIntervalSecondsInput').value,
                    segmentNavigationMode: document.getElementById('segmentNavigationModeSelect').value,
                    showIndividualPoints: settingsState.showIndividualPoints,
                    trackerColors: { ...(trackerColors || {}) },
                    disabledTrackers: { ...(disabledTrackers || {}) },
                });

                settingsState = nextSettings;
                trackerColors = { ...(settingsState.trackerColors || {}) };
                disabledTrackers = { ...(settingsState.disabledTrackers || {}) };

                const payload = JSON.stringify(settingsState);

                const cookieValue = 'mapViewSettings=' + encodeURIComponent(payload) + '; path=/; max-age=' + (60 * 60 * 24 * 30) + '; SameSite=Lax';

                try {
                    document.cookie = cookieValue;
                } catch (cookieErr) {
                    console.warn('Unable to write cookie, falling back to localStorage', cookieErr);
                }

                try {
                    if (window.localStorage) {
                        window.localStorage.setItem('mapViewSettings', payload);
                    }
                } catch (storageErr) {
                    console.warn('Unable to store settings in localStorage', storageErr);
                }
            } catch (err) {
                console.warn('Unable to save map settings', err);
            }
        }

        function loadSettings() {
            try {
                if (window.localStorage && window.localStorage.getItem('mapViewSettings')) {
                    return JSON.parse(window.localStorage.getItem('mapViewSettings'));
                }
            } catch (err) {
                console.warn('Unable to load saved tracker settings from localStorage', err);
            }

            try {
                const cookieValue = document.cookie.split('; ').find((entry) => entry.startsWith('mapViewSettings='));
                if (cookieValue) {
                    const storedValue = decodeURIComponent(cookieValue.split('=').slice(1).join('='));
                    return JSON.parse(storedValue);
                }
            } catch (err) {
                console.warn('Unable to parse saved tracker settings from cookie', err);
            }

            return null;
        }

        function applySettingsToForm(settings, options = {}) {
            if (!settings) {
                return;
            }
            hydrateSettingsState(settings);
            const trackerSelect = document.getElementById('selTrackers');
            const skipTrackerSelectionRestore = Boolean(options && options.skipTrackerSelectionRestore);
            if (!skipTrackerSelectionRestore && trackerSelect && settingsState.trackerId !== undefined) {
                const requestedTracker = settingsState.trackerId || 'all_trackers';
                const offeredValues = Array.from(trackerSelect.options).map((option) => option.value);
                if (offeredValues.includes(requestedTracker)) {
                    trackerSelect.value = requestedTracker;
                } else if (offeredValues.includes('all_trackers')) {
                    trackerSelect.value = 'all_trackers';
                }
            }
            const accuracyInput = document.getElementById('accuracyFilterInput');
            if (accuracyInput && settingsState.accuracyLimit !== undefined) {
                accuracyInput.value = settingsState.accuracyLimit;
            }
            const radiusInput = document.getElementById('stopDetectionRadiusInput');
            if (radiusInput && settingsState.stopDetectionRadiusMeters !== undefined) {
                radiusInput.value = settingsState.stopDetectionRadiusMeters;
            }
            const minSecondsInput = document.getElementById('stopDetectionMinSecondsInput');
            if (minSecondsInput && settingsState.stopDetectionMinSeconds !== undefined) {
                minSecondsInput.value = settingsState.stopDetectionMinSeconds;
            }
