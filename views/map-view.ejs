                windowPointsInput.value = settingsState.stopDetectionWindowPoints;
            }
            const exitPointsInput = document.getElementById('stopDetectionExitPointsInput');
            if (exitPointsInput && settingsState.stopDetectionExitPoints !== undefined) {
                exitPointsInput.value = settingsState.stopDetectionExitPoints;
            }
            const sampleIntervalInput = document.getElementById('stopDetectionSampleIntervalSecondsInput');
            if (sampleIntervalInput && settingsState.stopDetectionSampleIntervalSeconds !== undefined) {
                sampleIntervalInput.value = settingsState.stopDetectionSampleIntervalSeconds;
            }
            const quickHoursInput = document.getElementById('inp_quick_hours');
            if (quickHoursInput && settingsState.quickHoursValue !== undefined) {
                quickHoursInput.value = settingsState.quickHoursValue;
            }
            const quickDaysInput = document.getElementById('inp_quick_days');
            if (quickDaysInput && settingsState.quickDaysValue !== undefined) {
                quickDaysInput.value = settingsState.quickDaysValue;
            }
            const quickDaysAgoInput = document.getElementById('inp_quick_days_ago');
