                </label>
                <div class="segment-drawer-grabber"></div>
                <div id="segmentNavigator" class="segment-nav" style="display: none;">
                    <button type="button" id="prevTravelSegmentBtn" onclick="event.stopPropagation(); navigateTravelSegment(-1)" onpointerdown="event.stopPropagation()" onpointerup="event.stopPropagation()">←</button>
                    <span id="travelSegmentCounter">0 / 0</span>
                    <button type="button" id="nextTravelSegmentBtn" onclick="event.stopPropagation(); navigateTravelSegment(1)" onpointerdown="event.stopPropagation()" onpointerup="event.stopPropagation()">→</button>
                </div>
                <div id="segmentTimeframe" class="segment-timeframe">No segment selected</div>
                <button type="button" class="segment-drawer-toggle" onclick="event.stopPropagation(); toggleSegmentDrawerFromButton()" onpointerdown="event.stopPropagation()" onpointerup="event.stopPropagation()" aria-label="Toggle segments drawer">▾</button>
            </div>
            <div class="segment-drawer-body">
                <div id="segmentList"></div>
            </div>
        </div>
    </div>
</BODY>
</HTML>