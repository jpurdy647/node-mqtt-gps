            const segmentNavigationModeSelect = document.getElementById('segmentNavigationModeSelect');
            if (segmentNavigationModeSelect && settingsState.segmentNavigationMode !== undefined) {
                segmentNavigationModeSelect.value = settingsState.segmentNavigationMode;
            }
            updatePerformanceModeUi();
            updateLiveTrackerControlsUi();
        }

        function clearSegmentHighlight() {
            segmentLayers.forEach((layer) => {
                if (layer && layer.setStyle) {
                    const baseStyle = layer._jpBaseStyle || { color: '#3388ff', weight: 2, opacity: 0.8 };
                    layer.setStyle(baseStyle);
                }
            });

            detectedSegments.forEach((segment) => {
                const stopRadiusLayers = Array.isArray(segment && segment.stopRadiusCircles)
                    ? segment.stopRadiusCircles
                    : (segment && segment.stopRadiusCircle ? [segment.stopRadiusCircle] : []);
                stopRadiusLayers.forEach((layer) => {
                    if (!layer || !layer.setStyle) {
                        return;
                    }
                    layer.setStyle({
                        color: 'rgba(0, 0, 0, 0.45)',
                        weight: 1.2,
                        dashArray: '5,4',
                        fillColor: 'rgba(90, 90, 90, 0.2)',
                        fillOpacity: 0.35,
                    });
                });

                const stopCenterLayers = Array.isArray(segment && segment.stopCenterDots)
                    ? segment.stopCenterDots
                    : (segment && segment.stopCenterDot ? [segment.stopCenterDot] : []);
                stopCenterLayers.forEach((layer) => {
                    if (!layer || !layer.setStyle) {
                        return;
                    }
                    layer.setStyle({
                        radius: 5,
                        color: 'rgba(75, 75, 75, 0.55)',
                        fillColor: 'rgba(100, 100, 100, 0.32)',
                        fillOpacity: 0.8,
                        weight: 1,
                    });
                });
            });

            renderedPointMarkersById.forEach((marker) => {
                if (!marker || !marker.setIcon) {
                    return;
                }

                const baseColor = marker._jpBaseColor || '#3388ff';
                const course = Number.isFinite(marker._jpCourse) ? marker._jpCourse : 0;
                marker.setIcon(L.divIcon({
                    className: 'jpico',
                    html: "<div style='background-color:" + baseColor + ";' class='marker-pin'></div><i style='color:" + baseColor + "; transform: rotate(" + course + "deg)' class='fa-regular fa-circle-up'></i>",
                    iconSize: [10, 10],
                    iconAnchor: [5, 5],
                    popupAnchor: [-3, -76],
                }));
            });
            highlightedSegment = null;
        }

        function getDrawerOcclusionHeight(options = {}) {
            const includeCollapsed = Boolean(options && options.includeCollapsed);
            const drawer = document.getElementById('segmentDrawer');
            if (!drawer) {
                return 0;
            }

            const isExpanded = drawer.classList.contains('expanded');
            const isCollapsed = drawer.classList.contains('collapsed');
            if (!isExpanded && !(includeCollapsed && isCollapsed)) {
                return 0;
            }

            const bounds = drawer.getBoundingClientRect();
            return Math.max(0, Math.round(bounds.height || 0));
        }

        function fitBoundsVisible(bounds, options = {}) {
            if (!map || !bounds) {
                return;
            }

            const drawerOcclusion = getDrawerOcclusionHeight();
            const basePadding = 40;
            const mergedOptions = {
                ...options,
                paddingTopLeft: options.paddingTopLeft || [basePadding, basePadding],
                paddingBottomRight: options.paddingBottomRight || [basePadding, basePadding + drawerOcclusion],
            };

            map.fitBounds(bounds, mergedOptions);
        }

        function setViewVisible(latLng, zoomLevel, options = {}) {
            if (!map) {
                return;
            }

            map.setView(latLng, zoomLevel);
            const drawerOcclusion = getDrawerOcclusionHeight({
                includeCollapsed: Boolean(options && options.includeCollapsedDrawer),
            });
            if (drawerOcclusion > 0) {
                map.panBy([0, -Math.round(drawerOcclusion / 2)], { animate: false });
            }
        }

        function getCurrentSelectedSegmentContext() {
            if (!selectedSegmentId || !Array.isArray(detectedSegments) || !detectedSegments.length) {
                return null;
            }

            const segment = detectedSegments.find((entry) => entry.id === selectedSegmentId);
            if (!segment) {
                return null;
            }

            return {
                id: segment.id,
                trackerId: segment.trackerId || null,
                type: segment.type || null,
                startTime: Number.isFinite(segment.startTime) ? segment.startTime : null,
                endTime: Number.isFinite(segment.endTime) ? segment.endTime : null,
            };
        }

        function getCurrentSelectedSegment() {
            if (!selectedSegmentId || !Array.isArray(detectedSegments) || !detectedSegments.length) {
                return null;
            }
            return detectedSegments.find((entry) => entry.id === selectedSegmentId) || null;
        }

        function getSegmentRawPoints(segment) {
            return Array.isArray(segment && segment.rawPoints) ? segment.rawPoints.filter(Boolean) : [];
        }

        function setSegmentDebugStatus(message, isError = false) {
            const statusElement = document.getElementById('segmentDebugStatus');
            if (!statusElement) {
                return;
            }

            statusElement.textContent = message || '';
            statusElement.classList.toggle('error', Boolean(isError));

            if (segmentDebugStatusTimer) {
                clearTimeout(segmentDebugStatusTimer);
                segmentDebugStatusTimer = null;
            }

            if (!message) {
                return;
            }

            segmentDebugStatusTimer = setTimeout(() => {
                if (statusElement.textContent === message) {
                    statusElement.textContent = '';
                    statusElement.classList.remove('error');
                }
            }, 2800);
        }

        function focusSelectedSegmentPoint(options = {}) {
            const segment = getCurrentSelectedSegment();
            const rawPoints = getSegmentRawPoints(segment);
            if (!segment || !rawPoints.length) {
                return;
            }

            selectedSegmentPointIndex = Math.max(0, Math.min(selectedSegmentPointIndex, rawPoints.length - 1));
            const point = rawPoints[selectedSegmentPointIndex];
            if (!point || !Number.isFinite(point.latitude) || !Number.isFinite(point.longitude)) {
                return;
            }

            if (map && options.focusMap !== false) {
                setViewVisible([point.latitude, point.longitude], Math.max(map.getZoom() || 0, 16), {
                    includeCollapsedDrawer: true,
                });
            }

            const marker = point.puid ? renderedPointMarkersById.get(point.puid) : null;
            if (marker && marker.fire) {
                marker.fire('click');
                return;
            }

            if (map && L && L.popup) {
                const popupContent = point.puid
                    ? loadPopupContentforPoint(point.puid)
                    : `<strong>${new Date(point.time).toLocaleString()}</strong><br>Latitude: ${point.latitude}<br>Longitude: ${point.longitude}`;
                L.popup([point.latitude, point.longitude], {
                    content: `<p>${popupContent}</p>`,
                }).openOn(map);
            }
        }

        function updateSegmentDebugControls() {
            const prevPointButton = document.getElementById('prevSegmentPointBtn');
            const nextPointButton = document.getElementById('nextSegmentPointBtn');
            const pointCounter = document.getElementById('segmentPointCounter');
            const pointTimestamp = document.getElementById('segmentPointTimestamp');
            const copyPointButton = document.getElementById('copySegmentPointBtn');
            const copyStopButton = document.getElementById('copySegmentStopBtn');
            const copySegmentButton = document.getElementById('copySegmentDebugBtn');
            if (!prevPointButton || !nextPointButton || !pointCounter || !pointTimestamp || !copyPointButton || !copyStopButton || !copySegmentButton) {
                return;
            }

            const segment = getCurrentSelectedSegment();
            const rawPoints = getSegmentRawPoints(segment);
            const hasSegment = Boolean(segment);
            const hasPoints = rawPoints.length > 0;

            if (!hasPoints) {
                selectedSegmentPointIndex = 0;
                pointCounter.textContent = 'Point 0 / 0';
                pointTimestamp.textContent = hasSegment ? 'No points on selected segment' : 'Select a segment';
                prevPointButton.disabled = true;
                nextPointButton.disabled = true;
                copyPointButton.disabled = true;
                copyStopButton.disabled = !(hasSegment && segment.type === 'stop');
                copySegmentButton.disabled = !hasSegment;
                return;
            }

            selectedSegmentPointIndex = Math.max(0, Math.min(selectedSegmentPointIndex, rawPoints.length - 1));
            const activePoint = rawPoints[selectedSegmentPointIndex];
            const activeTime = activePoint && activePoint.time ? new Date(activePoint.time) : null;

            pointCounter.textContent = `Point ${selectedSegmentPointIndex + 1} / ${rawPoints.length}`;
            pointTimestamp.textContent = activeTime && Number.isFinite(activeTime.getTime())
                ? activeTime.toLocaleString()
                : 'Point time unavailable';

            prevPointButton.disabled = selectedSegmentPointIndex <= 0;
            nextPointButton.disabled = selectedSegmentPointIndex >= rawPoints.length - 1;
            copyPointButton.disabled = false;
            copyStopButton.disabled = segment.type !== 'stop';
            copySegmentButton.disabled = false;
        }

        function navigateSegmentPoint(direction) {
            const segment = getCurrentSelectedSegment();
            const rawPoints = getSegmentRawPoints(segment);
            if (!segment || !rawPoints.length) {
                setSegmentDebugStatus('No segment point available.', true);
                return;
            }

            const nextIndex = selectedSegmentPointIndex + (direction > 0 ? 1 : -1);
            selectedSegmentPointIndex = Math.max(0, Math.min(nextIndex, rawPoints.length - 1));
            updateSegmentDebugControls();
            focusSelectedSegmentPoint({ focusMap: true });
        }

        function distanceFromPointToCenterMeters(point, center) {
            if (!point || !center) {
                return null;
            }
            return calculateDistance(point.latitude, point.longitude, center.latitude, center.longitude, 'meters');
        }

        function buildCurrentSegmentDebugPayload() {
            const segment = getCurrentSelectedSegment();
            if (!segment) {
                return null;
            }

            const rawPoints = getSegmentRawPoints(segment);
            const activeIndex = Math.max(0, Math.min(selectedSegmentPointIndex, Math.max(0, rawPoints.length - 1)));
            const activePoint = rawPoints.length ? rawPoints[activeIndex] : null;
            const primaryCenter = Array.isArray(segment.centers) && segment.centers.length
                ? segment.centers[0]
                : (segment.center || null);

            return {
                segment: {
                    id: segment.id || null,
                    trackerId: segment.trackerId || null,
                    type: segment.type || null,
                    label: segment.label || null,
                    startTimeMs: Number.isFinite(segment.startTime) ? segment.startTime : null,
                    endTimeMs: Number.isFinite(segment.endTime) ? segment.endTime : null,
                    startTimeIso: Number.isFinite(segment.startTime) ? new Date(segment.startTime).toISOString() : null,
                    endTimeIso: Number.isFinite(segment.endTime) ? new Date(segment.endTime).toISOString() : null,
                    pointCount: rawPoints.length,
                    points: rawPoints.map((point, index) => ({
                        index,
                        puid: point && point.puid ? point.puid : null,
                        time: point && point.time ? point.time : null,
                        localTime: point && point.localTime ? point.localTime : null,
                        latitude: point ? point.latitude : null,
                        longitude: point ? point.longitude : null,
                        velocity: point ? point.velocity : null,
                        course: point ? point.course : null,
                        gps_accuracy: point ? point.gps_accuracy : null,
                        distanceToPrimaryStopCenterMeters: primaryCenter ? distanceFromPointToCenterMeters(point, primaryCenter) : null,
                    })),
                },
                stop: {
                    radiusMeters: getStopDetectionRadiusMeters(),
                    center: segment.center || null,
                    centers: Array.isArray(segment.centers) ? segment.centers : (segment.center ? [segment.center] : []),
                },
                point: activePoint ? {
                    index: activeIndex,
                    of: rawPoints.length,
                    puid: activePoint.puid || null,
                    time: activePoint.time || null,
                    localTime: activePoint.localTime || null,
                    latitude: activePoint.latitude,
                    longitude: activePoint.longitude,
                    velocity: activePoint.velocity,
                    course: activePoint.course,
                    gps_accuracy: activePoint.gps_accuracy,
                    distanceToPrimaryStopCenterMeters: primaryCenter ? distanceFromPointToCenterMeters(activePoint, primaryCenter) : null,
                } : null,
            };
        }

        function copyTextToClipboard(text) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                return navigator.clipboard.writeText(text);
            }

            return new Promise((resolve, reject) => {
                try {
                    const textArea = document.createElement('textarea');
                    textArea.value = text;
                    textArea.setAttribute('readonly', 'readonly');
                    textArea.style.position = 'absolute';
                    textArea.style.left = '-9999px';
                    document.body.appendChild(textArea);
                    textArea.select();
                    const copied = document.execCommand('copy');
                    document.body.removeChild(textArea);
                    if (!copied) {
                        reject(new Error('copy command failed'));
                        return;
                    }
                    resolve();
                } catch (err) {
                    reject(err);
                }
            });
        }

        async function copyCurrentSegmentDebugInfo(kind) {
            const payload = buildCurrentSegmentDebugPayload();
            if (!payload || !payload.segment) {
                setSegmentDebugStatus('Select a segment first.', true);
                return;
            }

            let valueToCopy = null;
            if (kind === 'point') {
                valueToCopy = payload.point;
            } else if (kind === 'stop') {
                if (payload.segment.type !== 'stop') {
                    setSegmentDebugStatus('Selected segment is not a stop.', true);
                    return;
                }
                valueToCopy = {
                    segment: payload.segment,
                    stop: payload.stop,
                };
            } else {
                valueToCopy = payload;
            }

            if (!valueToCopy) {
                setSegmentDebugStatus('No debug data available.', true);
                return;
            }

            try {
                await copyTextToClipboard(JSON.stringify(valueToCopy, null, 2));
                setSegmentDebugStatus(`Copied ${kind} debug info.`);
            } catch (err) {
                console.warn('Unable to copy debug info', err);
                setSegmentDebugStatus('Copy failed.', true);
            }
        }

        function findBestSegmentMatch(context) {
            if (!context || !Array.isArray(detectedSegments) || !detectedSegments.length) {
                return null;
            }

            const exactById = detectedSegments.find((segment) => segment.id === context.id);
            if (exactById) {
                return exactById;
            }

            const candidates = detectedSegments.filter((segment) => {
                if (context.type && segment.type !== context.type) {
                    return false;
                }
                if (context.trackerId && segment.trackerId !== context.trackerId) {
                    return false;
                }
                return Number.isFinite(segment.startTime) && Number.isFinite(segment.endTime);
            });

            if (!candidates.length) {
                return null;
            }

            if (!Number.isFinite(context.startTime) && !Number.isFinite(context.endTime)) {
                return candidates[0];
            }

            let bestSegment = null;
            let bestScore = Number.POSITIVE_INFINITY;
            candidates.forEach((segment) => {
                const startDelta = Number.isFinite(context.startTime)
                    ? Math.abs(segment.startTime - context.startTime)
                    : 0;
                const endDelta = Number.isFinite(context.endTime)
                    ? Math.abs(segment.endTime - context.endTime)
                    : 0;
                const score = startDelta + endDelta;
                if (score < bestScore) {
                    bestScore = score;
                    bestSegment = segment;
                }
            });

            return bestSegment;
        }

        function isSameTrackPoint(leftPoint, rightPoint) {
            if (!leftPoint || !rightPoint) {
                return false;
            }

            if (leftPoint.puid && rightPoint.puid) {
                return leftPoint.puid === rightPoint.puid;
            }

            return (
                leftPoint.time === rightPoint.time &&
                Number(leftPoint.latitude) === Number(rightPoint.latitude) &&
                Number(leftPoint.longitude) === Number(rightPoint.longitude)
            );
        }

        function getTravelRenderPoints(segment) {
            const basePoints = Array.isArray(segment && segment.rawPoints) ? segment.rawPoints.filter(Boolean) : [];
            if (!segment || segment.type !== 'travel' || !basePoints.length) {
                return basePoints;
            }

            const timelineSegments = detectedSegments
                .filter((entry) =>
                    entry &&
                    entry.trackerId === segment.trackerId &&
                    (entry.type === 'travel' || entry.type === 'stop') &&
                    Array.isArray(entry.rawPoints) &&
                    entry.rawPoints.length
                )
                .sort((left, right) => {
                    const leftStart = Number.isFinite(left.startTime) ? left.startTime : Number.POSITIVE_INFINITY;
                    const rightStart = Number.isFinite(right.startTime) ? right.startTime : Number.POSITIVE_INFINITY;
                    if (leftStart !== rightStart) {
                        return leftStart - rightStart;
                    }
                    const leftEnd = Number.isFinite(left.endTime) ? left.endTime : Number.POSITIVE_INFINITY;
                    const rightEnd = Number.isFinite(right.endTime) ? right.endTime : Number.POSITIVE_INFINITY;
                    return leftEnd - rightEnd;
                });

            const currentIndex = timelineSegments.findIndex((entry) => entry.id === segment.id);
            if (currentIndex < 0) {
                return basePoints;
            }

            let renderPoints = basePoints.slice();
            const previousSegment = timelineSegments[currentIndex - 1];
            if (previousSegment && previousSegment.type === 'stop') {
                const previousStopPoints = Array.isArray(previousSegment.rawPoints) ? previousSegment.rawPoints.filter(Boolean) : [];
                if (previousStopPoints.length) {
                    renderPoints = [previousStopPoints[previousStopPoints.length - 1]].concat(renderPoints);
                }
            }

            const nextSegment = timelineSegments[currentIndex + 1];
            if (nextSegment && nextSegment.type === 'stop') {
                const nextStopPoints = Array.isArray(nextSegment.rawPoints) ? nextSegment.rawPoints.filter(Boolean) : [];
                if (nextStopPoints.length) {
                    renderPoints = renderPoints.concat(nextStopPoints[0]);
                }
            }

            return renderPoints.reduce((accumulator, point) => {
                if (!accumulator.length || !isSameTrackPoint(accumulator[accumulator.length - 1], point)) {
                    accumulator.push(point);
                }
                return accumulator;
            }, []);
        }

        function highlightSegment(segmentId, options = {}) {
            const focusMap = options.focusMap !== false;
            clearSegmentHighlight();
            const segment = detectedSegments.find((entry) => entry.id === segmentId);
            if (!segment) {
                return;
            }
            const wasSameSegment = selectedSegmentId === segmentId;
            highlightedSegment = segmentId;
            selectedSegmentId = segmentId;
            if (!wasSameSegment) {
                selectedSegmentPointIndex = 0;
            }

            if (segment.type === 'travel' && !segment.polyline && Array.isArray(segment.rawPoints) && segment.rawPoints.length >= 2) {
                const travelRenderPoints = getTravelRenderPoints(segment);
                const trackerColor = getTrackerColor(segment.trackerId);
                segment.polyline = L.polyline(travelRenderPoints.map((point) => [point.latitude, point.longitude]), { color: trackerColor, weight: 2, opacity: 0.8 }).addTo(transitionGroup);
                segment.polyline._jpBaseStyle = { color: trackerColor, weight: 2, opacity: 0.8 };
                segmentLayers.push(segment.polyline);
            }

            if (segment.type === 'stop' && (!Array.isArray(segment.stopRadiusCircles) || !segment.stopRadiusCircles.length)) {
                const centers = Array.isArray(segment.centers) && segment.centers.length
                    ? segment.centers
                    : (segment.center ? [segment.center] : []);
                const stopRadiusMeters = getStopDetectionRadiusMeters();
                const stopCircles = [];
                const centerDots = [];

                centers.forEach((center) => {
                    const stopCircle = L.circle([center.latitude, center.longitude], {
                        radius: stopRadiusMeters,
                        color: 'rgba(0, 0, 0, 0.45)',
                        weight: 1.2,
                        dashArray: '5,4',
                        fillColor: 'rgba(90, 90, 90, 0.2)',
                        fillOpacity: 0.35,
                    }).addTo(transitionGroup);
                    stopCircles.push(stopCircle);
                    segmentLayers.push(stopCircle);

                    const centerDot = L.circleMarker([center.latitude, center.longitude], {
                        radius: 5,
                        color: 'rgba(75, 75, 75, 0.55)',
                        fillColor: 'rgba(100, 100, 100, 0.32)',
                        fillOpacity: 0.8,
                        weight: 1,
                    }).addTo(transitionGroup);
                    centerDots.push(centerDot);
                    segmentLayers.push(centerDot);
                });

                segment.stopRadiusCircles = stopCircles;
                segment.stopCenterDots = centerDots;
                segment.stopRadiusCircle = stopCircles.length ? L.featureGroup(stopCircles) : null;
                segment.stopCenterDot = centerDots.length ? L.featureGroup(centerDots) : null;
            }

            if (segment.polyline) {
                segment.polyline.setStyle({ color: '#ff3b30', weight: 5, opacity: 1 });
                if (focusMap && segment.polyline.getBounds) {
                    fitBoundsVisible(segment.polyline.getBounds());
                }
            }
            if (segment.points) {
                segment.points.forEach((marker) => {
                    if (marker && marker.setStyle) {
                        marker.setStyle({ radius: 7, color: '#ff3b30', fillColor: '#ff3b30' });
                    }
                });
            }

            if (segment.type === 'stop') {
                const stopRadiusLayers = Array.isArray(segment.stopRadiusCircles)
                    ? segment.stopRadiusCircles
                    : (segment.stopRadiusCircle ? [segment.stopRadiusCircle] : []);
                stopRadiusLayers.forEach((layer) => {
                    if (!layer || !layer.setStyle) {
                        return;
                    }
                    layer.setStyle({
                        color: '#ff3b30',
                        weight: 2.4,
                        dashArray: null,
                        fillColor: 'rgba(255, 59, 48, 0.18)',
                        fillOpacity: 0.42,
                    });
                });

                const stopCenterLayers = Array.isArray(segment.stopCenterDots)
                    ? segment.stopCenterDots
                    : (segment.stopCenterDot ? [segment.stopCenterDot] : []);
                stopCenterLayers.forEach((layer) => {
                    if (!layer || !layer.setStyle) {
                        return;
                    }
                    layer.setStyle({
                        radius: 6,
                        color: '#ff3b30',
                        fillColor: '#ff3b30',
                        fillOpacity: 0.95,
                        weight: 1.5,
                    });
                });

                if (focusMap && segment.stopRadiusCircle && segment.stopRadiusCircle.getBounds && map) {
                    fitBoundsVisible(segment.stopRadiusCircle.getBounds(), {
                        paddingTopLeft: [50, 50],
                        paddingBottomRight: [50, 50 + getDrawerOcclusionHeight()],
                    });
                } else if (focusMap && segment.center && map && map.setView) {
                    setViewVisible([segment.center.latitude, segment.center.longitude], Math.max(map.getZoom(), 16));
                }

                const stopRawPoints = Array.isArray(segment.rawPoints) ? segment.rawPoints : [];
                stopRawPoints.forEach((stopPoint) => {
                    if (!stopPoint || !stopPoint.puid) {
                        return;
                    }

                    const marker = renderedPointMarkersById.get(stopPoint.puid);
                    if (!marker || !marker.setIcon) {
                        return;
                    }

                    const course = Number.isFinite(marker._jpCourse) ? marker._jpCourse : 0;
                    marker.setIcon(L.divIcon({
                        className: 'jpico',
                        html: "<div style='background-color:#ff3b30;' class='marker-pin'></div><i style='color:#ff3b30; transform: rotate(" + course + "deg)' class='fa-regular fa-circle-up'></i>",
                        iconSize: [10, 10],
                        iconAnchor: [5, 5],
                        popupAnchor: [-3, -76],
                    }));
                });
            }
            renderSegmentList();
            updateSegmentDebugControls();
        }

        function restoreSelectedSegmentAfterRefresh(previousSegmentContext, preserveViewport) {
            if (!previousSegmentContext) {
                selectedSegmentId = null;
                highlightedSegment = null;
                renderSegmentList();
                return;
            }

            const matchedSegment = findBestSegmentMatch(previousSegmentContext);
            if (!matchedSegment) {
                selectedSegmentId = null;
                highlightedSegment = null;
                renderSegmentList();
                return;
            }

            highlightSegment(matchedSegment.id, { focusMap: !preserveViewport });
        }

        function formatSegmentTimeRange(startTime, endTime, options = {}) {
            const startDate = startTime ? new Date(startTime) : null;
            const endDate = endTime ? new Date(endTime) : null;

            if (!startDate || !endDate || !Number.isFinite(startDate.getTime()) || !Number.isFinite(endDate.getTime())) {
                return '';
            }

            const sameDay = startDate.toDateString() === endDate.toDateString();
            const timeFormatter = new Intl.DateTimeFormat([], {
                hour: 'numeric',
                minute: '2-digit',
            });
            const datetimeFormatter = new Intl.DateTimeFormat([], {
                month: 'short',
                day: 'numeric',
                hour: 'numeric',
                minute: '2-digit',
            });
            const dateOnlyFormatter = new Intl.DateTimeFormat([], {
                month: 'short',
                day: 'numeric',
            });
            const dateWithWeekdayFormatter = new Intl.DateTimeFormat([], {
                weekday: 'short',
                month: 'short',
                day: 'numeric',
            });
            const nowDate = options.nowDate instanceof Date ? options.nowDate : new Date();
            const startIsToday = Number.isFinite(nowDate.getTime()) && startDate.toDateString() === nowDate.toDateString();
            const includeDateForNonToday = Boolean(options.includeDateForNonToday) && !startIsToday;
            const includeWeekdayOnDesktop = Boolean(
                options.includeWeekdayOnDesktop &&
                typeof window !== 'undefined' &&
                window.matchMedia &&
                window.matchMedia('(min-width: 769px)').matches
            );
            const collapsedDateFormatter = includeWeekdayOnDesktop ? dateWithWeekdayFormatter : dateOnlyFormatter;

            if (options.includeDate === false) {
                return `${timeFormatter.format(startDate)} – ${timeFormatter.format(endDate)}`;
            }

            if (includeDateForNonToday) {
                if (sameDay) {
                    return `${collapsedDateFormatter.format(startDate)} ${timeFormatter.format(startDate)} – ${timeFormatter.format(endDate)}`;
                }
                return `${collapsedDateFormatter.format(startDate)} ${timeFormatter.format(startDate)} – ${collapsedDateFormatter.format(endDate)} ${timeFormatter.format(endDate)}`;
            }

            if (options.includeDateOnlyIfMultiDay && sameDay) {
                return `${timeFormatter.format(startDate)} – ${timeFormatter.format(endDate)}`;
            }

            if (options.includeDateOnlyIfMultiDay && !sameDay) {
                return `${dateOnlyFormatter.format(startDate)} ${timeFormatter.format(startDate)} – ${dateOnlyFormatter.format(endDate)} ${timeFormatter.format(endDate)}`;
            }

            if (sameDay) {
                return `${timeFormatter.format(startDate)} – ${timeFormatter.format(endDate)}`;
            }

            return `${datetimeFormatter.format(startDate)} – ${datetimeFormatter.format(endDate)}`;
        }

        function updateSegmentNavigator() {
            const navigator = document.getElementById('segmentNavigator');
            const counter = document.getElementById('travelSegmentCounter');
            const timeframe = document.getElementById('segmentTimeframe');
            const prevButton = document.getElementById('prevTravelSegmentBtn');
            const nextButton = document.getElementById('nextTravelSegmentBtn');
            if (!navigator || !counter || !prevButton || !nextButton || !timeframe) {
                return;
            }

            const filteredSegments = getNavigableSegments();
            if (!filteredSegments.length) {
                navigator.style.display = 'none';
                timeframe.textContent = 'No segment selected';
                updateSegmentDebugControls();
                return;
            }

            navigator.style.display = 'flex';
            const currentIndex = filteredSegments.findIndex((segment) => segment.id === selectedSegmentId);
            const activeIndex = currentIndex >= 0 ? currentIndex : 0;
            const activeSegment = filteredSegments[activeIndex];
            const hasTimes = activeSegment && activeSegment.startTime && activeSegment.endTime;
            const drawer = document.getElementById('segmentDrawer');
            const isCollapsed = Boolean(drawer && drawer.classList.contains('collapsed'));
            if (hasTimes) {
                const formattedRange = formatSegmentTimeRange(activeSegment.startTime, activeSegment.endTime, {
                    includeDate: isCollapsed,
                    includeDateOnlyIfMultiDay: true,
                    includeDateForNonToday: isCollapsed,
                    includeWeekdayOnDesktop: isCollapsed,
                });
                timeframe.textContent = `${activeSegment.type === 'stop' ? 'Stop' : 'Travel'} • ${formattedRange || 'Time range unavailable'}`;
            } else {
                timeframe.textContent = 'Time range unavailable';
            }
            counter.textContent = `${activeIndex + 1} / ${filteredSegments.length}`;
            prevButton.disabled = activeIndex <= 0;
            nextButton.disabled = activeIndex >= filteredSegments.length - 1;
            updateSegmentDebugControls();
        }

        function getSegmentNavigationMode() {
            const modeSelect = document.getElementById('segmentNavigationModeSelect');
            const selectedMode = modeSelect && modeSelect.value ? modeSelect.value : settingsState.segmentNavigationMode;
            if (selectedMode === 'stops' || selectedMode === 'both') {
                return selectedMode;
            }
            return 'travel';
        }

        function getNavigableSegments() {
            const mode = getSegmentNavigationMode();
            const timedSegments = detectedSegments.filter((segment) =>
                (segment.type === 'travel' || segment.type === 'stop') &&
                Number.isFinite(segment.startTime) &&
                Number.isFinite(segment.endTime)
            );

            if (mode === 'travel') {
                return timedSegments.filter((segment) => segment.type === 'travel');
            }
            if (mode === 'stops') {
                return timedSegments.filter((segment) => segment.type === 'stop');
            }
            return timedSegments;
        }

        function onSegmentNavigationModeChanged() {
            settingsState.segmentNavigationMode = getSegmentNavigationMode();
            saveSettings();
            updateSegmentNavigator();
        }

        function navigateTravelSegment(direction) {
            const filteredSegments = getNavigableSegments();
            if (!filteredSegments.length) {
                return;
            }

            const currentIndex = filteredSegments.findIndex((segment) => segment.id === selectedSegmentId);
            let targetIndex = currentIndex >= 0 ? currentIndex + direction : (direction > 0 ? 0 : filteredSegments.length - 1);
            if (targetIndex < 0 || targetIndex >= filteredSegments.length) {
                return;
            }

            highlightSegment(filteredSegments[targetIndex].id);
        }

        function renderSegmentList() {
            const container = document.getElementById("segmentList");
            if (!container) {
                return;
            }
            if (!detectedSegments.length) {
                container.innerHTML = "<div class='segment-empty'>No segments detected yet.</div>";
                updateSegmentNavigator();
                return;
            }

            const groupedSegments = detectedSegments.reduce((accumulator, segment) => {
                const trackerId = segment.trackerId || 'Unassigned';
                if (!accumulator[trackerId]) {
                    accumulator[trackerId] = [];
                }
                accumulator[trackerId].push(segment);
                return accumulator;
            }, {});

            const drawer = document.getElementById('segmentDrawer');
            const isExpanded = Boolean(drawer && drawer.classList.contains('expanded'));

            container.innerHTML = Object.entries(groupedSegments).map(([trackerId, segments]) => {
                const trackerLabel = trackerId === 'Unassigned' ? 'Unassigned' : trackerId;
                const trackerColor = getTrackerColor(trackerId);
                const groupedByDate = isExpanded
                    ? segments.reduce((groups, segment) => {
                        const dateKey = segment && segment.startTime ? new Date(segment.startTime).toDateString() : 'unknown';
                        if (!groups[dateKey]) {
                            groups[dateKey] = [];
                        }
                        groups[dateKey].push(segment);
                        return groups;
                    }, {})
                    : null;

                const dateSections = isExpanded
                    ? Object.entries(groupedByDate || {}).map(([dateKey, dateSegments]) => {
                        const dateLabel = dateKey === 'unknown'
                            ? 'Unknown date'
                            : new Intl.DateTimeFormat([], { month: 'short', day: 'numeric', weekday: 'short' }).format(new Date(dateKey));
                        return `<div style='margin-bottom: 10px;'>
                            <div style='font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 6px;'>${dateLabel}</div>
                            ${dateSegments.map((segment) => {
                                const isSelected = selectedSegmentId === segment.id;
                                const title = segment.type === 'stop' ? `Stop • ${segment.label}` : `Travel • ${segment.label}`;
                                const count = Number.isFinite(segment.pointCount)
                                    ? segment.pointCount
                                    : (Array.isArray(segment.rawPoints) ? segment.rawPoints.length : 0);
                                const pointCountText = `<div style='font-size: 11px; color: #64748b; margin-top: 2px;'>${count} point${count === 1 ? '' : 's'}</div>`;
                                const timeText = segment.startTime && segment.endTime
                                    ? `<div style='font-size: 11px; color: #666; margin-top: 4px;'>${formatSegmentTimeRange(segment.startTime, segment.endTime, { includeDate: false })}</div>`
                                    : '';
                                const selectedStyle = isSelected ? "border-color: #3388ff; background: #eef6ff; box-shadow: inset 0 0 0 1px #3388ff;" : "";
                                return `<button class='segment-item ${isSelected ? 'selected' : ''}' onclick='highlightSegment("${segment.id}")' style='display: block; width: 100%; text-align: left; margin-bottom: 8px; padding: 8px; border: 1px solid #ddd; border-radius: 4px; background: #fff; ${selectedStyle}'>${title}${pointCountText}${timeText}</button>`;
                            }).join('')}
                        </div>`;
                    }).join('')
                    : segments.map((segment) => {
                        const isSelected = selectedSegmentId === segment.id;
                        const title = segment.type === 'stop' ? `Stop • ${segment.label}` : `Travel • ${segment.label}`;
                        const count = Number.isFinite(segment.pointCount)
                            ? segment.pointCount
                            : (Array.isArray(segment.rawPoints) ? segment.rawPoints.length : 0);
                        const pointCountText = `<div style='font-size: 11px; color: #64748b; margin-top: 2px;'>${count} point${count === 1 ? '' : 's'}</div>`;
                        const timeText = segment.startTime && segment.endTime
                            ? `<div style='font-size: 11px; color: #666; margin-top: 4px;'>${formatSegmentTimeRange(segment.startTime, segment.endTime, { includeDate: false })}</div>`
                            : '';
                        const selectedStyle = isSelected ? "border-color: #3388ff; background: #eef6ff; box-shadow: inset 0 0 0 1px #3388ff;" : "";
                        return `<button class='segment-item ${isSelected ? 'selected' : ''}' onclick='highlightSegment("${segment.id}")' style='display: block; width: 100%; text-align: left; margin-bottom: 8px; padding: 8px; border: 1px solid #ddd; border-radius: 4px; background: #fff; ${selectedStyle}'>${title}${pointCountText}${timeText}</button>`;
                    }).join('');

                return `<div style='margin-bottom: 12px;'>
                    <div style='font-weight: 600; color: ${trackerColor}; margin-bottom: 6px;'>${trackerLabel}</div>
                    ${dateSections}
                </div>`;
            }).join('');
            updateSegmentNavigator();
        }

        function showPoints(options = {}){
            const preserveViewport = Boolean(options && options.preserveViewport);
            const previousSelectedSegmentContext = getCurrentSelectedSegmentContext();
            linesGroup.clearLayers(); // Clear existing lines from the map
            clearLiveTrackerExtensionLines();
            transitionGroup.clearLayers(); // Clear existing transition markers from the map
            renderedPointMarkersById = new Map();
            segmentLayers = [];
            detectedSegments = [];
            clearSegmentHighlight();

            if (points.size === 0) {
                restoreSelectedSegmentAfterRefresh(previousSelectedSegmentContext, preserveViewport);
                return; // No points to display
            }

            let viewportBounds = null;
            const extendViewportBounds = (bounds) => {
                if (!bounds || !bounds.isValid || !bounds.isValid()) {
                    return;
                }
                viewportBounds = viewportBounds ? viewportBounds.extend(bounds) : bounds;
            };

            processSegments2(points);
            const stopPointIds = new Set();

            detectedSegments.forEach((segment) => {
                if (segment.type !== 'stop') {
                    return;
                }

                const stopRawPoints = Array.isArray(segment.rawPoints) ? segment.rawPoints : [];
                stopRawPoints.forEach((stopPoint) => {
                    if (stopPoint && stopPoint.puid) {
                        stopPointIds.add(stopPoint.puid);
                    }
                });
            });

            points.forEach((trackerPoints, trackerId) => {
                const color = getTrackerColor(trackerId);
                const trackerLinePoints = Array.from(trackerPoints.values()).filter((p) => {
                    if (settingsState.showIndividualPoints) {
                        return true;
                    }
                    return !stopPointIds.has(p.puid);
                }).sort((left, right) => new Date(left.time) - new Date(right.time));

                const trackerTravelSegments = detectedSegments.filter((segment) =>
                    segment &&
                    segment.type === 'travel' &&
                    segment.trackerId === trackerId &&
                    Array.isArray(segment.rawPoints) &&
                    segment.rawPoints.length >= 2
                );

                var polyline = null;
                if (settingsState.showIndividualPoints && trackerLinePoints.length >= 2) {
                    polyline = L.polyline(trackerLinePoints.map((p) => [p.latitude, p.longitude]), { color, weight: 2, opacity: 0.8 }).addTo(linesGroup);
                    polyline._jpBaseStyle = { color, weight: 2, opacity: 0.8 };
                    segmentLayers.push(polyline);
                    if (!preserveViewport && polyline.getBounds) {
                        extendViewportBounds(polyline.getBounds());
                    }
                } else if (!settingsState.showIndividualPoints && trackerTravelSegments.length) {
                    const segmentPolylines = [];
                    trackerTravelSegments.forEach((segment) => {
                        const travelRenderPoints = getTravelRenderPoints(segment);
                        if (travelRenderPoints.length < 2) {
                            return;
                        }
                        const segmentPolyline = L.polyline(travelRenderPoints.map((point) => [point.latitude, point.longitude]), { color, weight: 2, opacity: 0.8 }).addTo(linesGroup);
                        segmentPolyline._jpBaseStyle = { color, weight: 2, opacity: 0.8 };
                        segmentLayers.push(segmentPolyline);
                        segmentPolylines.push(segmentPolyline);
                    });

                    if (!preserveViewport && segmentPolylines.length) {
                        const segmentGroup = L.featureGroup(segmentPolylines);
                        extendViewportBounds(segmentGroup.getBounds());
                    }

                    polyline = segmentPolylines.length === 1
                        ? segmentPolylines[0]
                        : (segmentPolylines.length ? L.featureGroup(segmentPolylines) : null);
                } else if (!settingsState.showIndividualPoints && trackerLinePoints.length >= 2) {
                    // Fallback for sparse/transition states where travel segmentation has not yielded drawable segments yet.
                    polyline = L.polyline(trackerLinePoints.map((point) => [point.latitude, point.longitude]), { color, weight: 2, opacity: 0.8 }).addTo(linesGroup);
                    polyline._jpBaseStyle = { color, weight: 2, opacity: 0.8 };
                    segmentLayers.push(polyline);
                    if (!preserveViewport && polyline.getBounds) {
                        extendViewportBounds(polyline.getBounds());
                    }
                }

                // Keep detectedSegments limited to true stop/travel segments produced by processSegments2.
                // Synthetic per-tracker line summaries caused empty debug payloads like track-* with null times.
            });

            if (settingsState.showIndividualPoints) {
                points.forEach((trackerPoints, trackerId) => {
                    const color = getTrackerColor(trackerId);
                    trackerPoints.forEach(function(point) {
                        const isStopPoint = stopPointIds.has(point.puid);
                        const pointColor = isStopPoint ? 'rgba(0, 0, 0, 0.5)' : color;
                        var pointIcon = L.divIcon({
                            className: 'jpico',
                            html: "<div style='background-color:" + pointColor + ";' class='marker-pin'></div><i style='color:" + pointColor + "; transform: rotate(" + point.course + "deg)' class='fa-regular fa-circle-up'></i>",
                            iconSize: [10, 10],
                            iconAnchor: [5, 5],
                            popupAnchor: [-3, -76],
                        });

                        var marker = L.marker([point.latitude, point.longitude], {icon: pointIcon}).addTo(linesGroup);
                        marker._jpBaseColor = pointColor;
                        marker._jpCourse = Number.isFinite(point.course) ? point.course : 0;
                        renderedPointMarkersById.set(point.puid, marker);
                        marker.on('click', function(event){
                            var accuracyCircle = L.circle([point.latitude, point.longitude], {
                                color: 'blue',
                                fillColor: '#f03',
                                fillOpacity: 0.5,
                                radius: point.gps_accuracy
                            }).addTo(map);
                            var popup = L.popup([point.latitude, point.longitude], {content: "<p>" + loadPopupContentforPoint(point.puid) + "</p>"});
                            popup.on('remove', function() {
                                accuracyCircle.remove();
                            });
                            popup.openOn(map);
                            loadPopupContentforPoint(point.puid);
                        });

                    });
                });
            }

            if (!preserveViewport && viewportBounds && viewportBounds.isValid && viewportBounds.isValid()) {
                fitBoundsVisible(viewportBounds, {
                    paddingTopLeft: [20, 20],
                    paddingBottomRight: [20, 20 + getDrawerOcclusionHeight()],
                });
            }

            refreshLiveMarkers({ mergeIntoTrackLines: false });

            restoreSelectedSegmentAfterRefresh(previousSelectedSegmentContext, preserveViewport);
        }

        function loadPopupContentforPoint(pointPIUD) {
            let point;
            points.forEach((trackerPoints) => {
                if (trackerPoints.has(pointPIUD)) {
                    point = trackerPoints.get(pointPIUD);
                }
            });
            if (!point) {
                return "Point not found";
            }   
            var result = "";

            result += "<strong>" + new Date(point.time).toLocaleString() + "</strong><br>";
            result += "Latitude: " + point.latitude + "<br>";
            result += "Longitude: " + point.longitude + "<br>";
            result += "Velocity: " + point.velocity + "<br>";
            result += "Course: " + point.course + " degrees<br>";
            result += "Altitude: " + point.altitude + "<br>";
            result += "Accuracy: " + point.gps_accuracy + "<br>";
            result += "Battery: " + point.battery + "%<br>";
            result += "Acceleration: " + point.acceleration + "<br>";
            result += "Mode: " + point.mode + "<br>";
            return result;

        }

        function getEffectivePointsTimeRange() {
            const picker = $('input[name="datetimes"]').data('daterangepicker');
            if (!picker || !picker.startDate || !picker.endDate) {
                return null;
            }

            let startDate = picker.startDate.clone();
            let endDate = picker.endDate.clone();

            if (isAllTrackersSelected()) {
                const maxSpanMs = 24 * 60 * 60 * 1000;
                const requestedSpanMs = Math.max(0, endDate.valueOf() - startDate.valueOf());
                if (requestedSpanMs > maxSpanMs) {
                    endDate = endDate.clone();
                    startDate = endDate.clone().subtract(maxSpanMs, 'milliseconds');
                    picker.setStartDate(startDate);
                    picker.setEndDate(endDate);
                }
            }

            return {
                startDate,
                endDate,
            };
        }

        function beginPendingPointsRequest() {
            if (!pendingPointsRequest) {
                return;
            }

            const request = pendingPointsRequest;
            pendingPointsRequest = null;
            loadTrackersAndPoints(request.options, request.requestToken);
        }

        function clearPointsRequestTimeout() {
            if (pointsRequestTimeoutTimer) {
                clearTimeout(pointsRequestTimeoutTimer);
                pointsRequestTimeoutTimer = null;
            }
        }

        function abortActivePointsRequest() {
            if (!pointsRequestInFlight) {
                return;
            }

            clearPointsRequestTimeout();
            pointsRequestInFlight.abort();
            pointsRequestInFlight = null;
        }

        function loadTrackersAndPoints(options = {}, requestToken = null) {
            if (!requestToken) {
                pointsRequestSequence += 1;
                requestToken = pointsRequestSequence;
            }

            const shouldQueueRequest = Boolean(pointsRequestInFlight);
            if (shouldQueueRequest) {
                pendingPointsRequest = { options, requestToken };
                return;
            }

            saveSettings({ source: 'auto' });
            if (!options || options.evaluateFollowMode !== false) {
                activeSearchFollowsNow = doesActiveSearchEndNow();
            }
            if (options && options.followNow) {
                syncPickerRangeToNowPreservingWindow();
                activeSearchFollowsNow = true;
            }

            const effectiveRange = getEffectivePointsTimeRange();
            const startTimeSeconds = effectiveRange && effectiveRange.startDate
                ? effectiveRange.startDate.toDate().getTime() / 1000
                : 0;
            const endTimeSeconds = effectiveRange && effectiveRange.endDate
                ? effectiveRange.endDate.toDate().getTime() / 1000
                : 0;

            const xhttp = new XMLHttpRequest();
            pointsRequestInFlight = xhttp;
            clearPointsRequestTimeout();
            pointsRequestTimeoutTimer = setTimeout(() => {
                if (pointsRequestInFlight !== xhttp) {
                    return;
                }
                console.warn('Points request timed out; aborting request.');
                window.alert('The points request took too long and was cancelled. Please try again.');
                abortActivePointsRequest();
                if (pendingPointsRequest) {
                    beginPendingPointsRequest();
                }
            }, pointsRequestTimeoutMs);

            xhttp.onload = function() {
                clearPointsRequestTimeout();
                if (pointsRequestInFlight !== xhttp) {
                    return;
                }
                pointsRequestInFlight = null;
                try {
                    const response = JSON.parse(this.responseText);
                    const trackerGroups = Array.isArray(response.trackers) ? response.trackers : [];
                    processPoints(trackerGroups);
                    showPoints(options);
                    if (isHydratingStartupSettings) {
                        applySettingsToForm(startupSettingsSnapshot || loadSettings() || {}, { skipTrackerSelectionRestore: true });
                        isHydratingStartupSettings = false;
                    }
                } catch (err) {
                    console.error("Failed to load points", err);
                    points = new Map();
                    showPoints(options);
                    if (isHydratingStartupSettings) {
                        applySettingsToForm(startupSettingsSnapshot || loadSettings() || {}, { skipTrackerSelectionRestore: true });
                        isHydratingStartupSettings = false;
                    }
                }

                if (pendingPointsRequest) {
                    beginPendingPointsRequest();
                }
            };

            xhttp.onerror = function() {
                clearPointsRequestTimeout();
                if (pointsRequestInFlight !== xhttp) {
                    return;
                }
                pointsRequestInFlight = null;
                console.error('Points request failed.');
                if (pendingPointsRequest) {
                    beginPendingPointsRequest();
                }
            };

            xhttp.onabort = function() {
                clearPointsRequestTimeout();
                if (pointsRequestInFlight !== xhttp) {
                    return;
                }
                pointsRequestInFlight = null;
                console.warn('Points request was aborted.');
                if (pendingPointsRequest) {
                    beginPendingPointsRequest();
                }
            };

            const selectedTrackerId = getCurrentSelectedTrackerId() || "all_trackers";
            xhttp.open("GET", "/points?tracker_id=" + encodeURIComponent(selectedTrackerId) + "&seconds_start=" + startTimeSeconds + "&seconds_end=" + endTimeSeconds, true);
            xhttp.send();
        }

    
        function processPoints(pointsArr) {
            points = buildTrackerPointMap(pointsArr, true);
        }

        function getStopDetectionRadiusMeters() {
            const stateValue = Number(settingsState.stopDetectionRadiusMeters);
            if (Number.isFinite(stateValue) && stateValue > 0) {
                return stateValue;
            }
            const input = document.getElementById("stopDetectionRadiusInput");
            const value = parseFloat(input && input.value);
            return Number.isFinite(value) && value > 0 ? value : stopDetectionRadiusMeters;
        }

        function getStopDetectionMinSeconds() {
            const stateValue = Number(settingsState.stopDetectionMinSeconds);
            if (Number.isFinite(stateValue) && stateValue > 0) {
                return stateValue;
            }
            const input = document.getElementById("stopDetectionMinSecondsInput");
            const value = parseInt(input && input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : stopDetectionMinSeconds;
        }

        function getStopDetectionWindowPoints() {
            const stateValue = Number(settingsState.stopDetectionWindowPoints);
            if (Number.isFinite(stateValue) && stateValue > 0) {
                return stateValue;
            }
            const input = document.getElementById("stopDetectionWindowPointsInput");
            const value = parseInt(input && input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : stopDetectionWindowPoints;
        }

        function getStopDetectionExitPoints() {
            const stateValue = Number(settingsState.stopDetectionExitPoints);
            if (Number.isFinite(stateValue) && stateValue > 0) {
                return stateValue;
            }
            const input = document.getElementById("stopDetectionExitPointsInput");
            const value = parseInt(input && input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : stopDetectionExitPoints;
        }

        function getStopDetectionSampleIntervalSeconds() {
            const stateValue = Number(settingsState.stopDetectionSampleIntervalSeconds);
            if (Number.isFinite(stateValue) && stateValue > 0) {
                return stateValue;
            }
            const input = document.getElementById("stopDetectionSampleIntervalSecondsInput");
            const value = parseInt(input && input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : stopDetectionSampleIntervalSeconds;
        }

        function samplePointsByTime(pointsList, intervalSeconds) {
            const sortedPoints = Array.from(pointsList).sort((a, b) => new Date(a.time) - new Date(b.time));
            if (sortedPoints.length <= 1 || intervalSeconds <= 0) {
                return sortedPoints;
            }

            const sampledPoints = [];
            let lastAcceptedTime = null;
            sortedPoints.forEach((point) => {
                const pointTime = new Date(point.time).getTime();
                if (lastAcceptedTime === null || (pointTime - lastAcceptedTime) >= intervalSeconds * 1000) {
                    sampledPoints.push(point);
                    lastAcceptedTime = pointTime;
                }
            });

            return sampledPoints;
        }

        function getCentroid(points) {
            if (!points.length) {
                return null;
            }
            const centerLat = points.reduce((sum, point) => sum + point.latitude, 0) / points.length;
            const centerLon = points.reduce((sum, point) => sum + point.longitude, 0) / points.length;
            return { latitude: centerLat, longitude: centerLon };
        }

        function processSegments2(pointsMap){
            const radiusMeters = getStopDetectionRadiusMeters();
            const minPoints = stopDetectionMinPoints;
            const minSeconds = getStopDetectionMinSeconds();
            const windowPoints = getStopDetectionWindowPoints();
            const exitPoints = getStopDetectionExitPoints();
            const sampleIntervalSeconds = getStopDetectionSampleIntervalSeconds();
            const allTrackersSelected = isAllTrackersSelected();
            const effectiveSampleIntervalSeconds = allTrackersSelected
                ? Math.max(sampleIntervalSeconds, sampleIntervalSeconds * 2)
                : sampleIntervalSeconds;
            const entryPoints = Math.max(2, minPoints, windowPoints);

            let warnedAboutOutOfOrder = false;

            const warnAboutOutOfOrder = (trackerId, orderedPoints) => {
                if (warnedAboutOutOfOrder) {
                    return;
                }

                const timestamps = orderedPoints.map((point) => new Date(point.time).getTime());
                for (let index = 1; index < timestamps.length; index++) {
                    if (timestamps[index] < timestamps[index - 1]) {
                        warnedAboutOutOfOrder = true;
                        console.warn(`Timestamps are out of order for tracker ${trackerId}.`);
                        window.alert(`Warning: timestamps are out of order for tracker ${trackerId}. Segment timing may be inaccurate.`);
                        break;
                    }
                }
            };

            pointsMap.forEach((trackerPoints, trackerId) => {
                const pointsArr = samplePointsByTime(trackerPoints.values(), effectiveSampleIntervalSeconds);
                if (pointsArr.length < minPoints) {
                    return;
                }

                warnAboutOutOfOrder(trackerId, pointsArr);
                const rawSegments = [];

                const normalizeSegmentTime = (timeValue) => {
                    const time = new Date(timeValue).getTime();
                    return Number.isFinite(time) ? time : null;
                };

                const getPointTime = (point) => normalizeSegmentTime(point && point.time);

                const analyzeCluster = (clusterPoints) => {
                    const safePoints = Array.isArray(clusterPoints) ? clusterPoints.filter(Boolean) : [];
                    if (!safePoints.length) {
                        return { valid: false, center: null, maxDistance: Infinity };
                    }

                    const center = getCentroid(safePoints);
                    if (!center) {
                        return { valid: false, center: null, maxDistance: Infinity };
                    }

                    const maxDistance = safePoints.reduce((max, candidate) => {
                        const distance = calculateDistance(candidate.latitude, candidate.longitude, center.latitude, center.longitude, 'meters');
                        return Math.max(max, distance);
                    }, 0);

                    return {
                        valid: maxDistance <= radiusMeters,
                        center,
                        maxDistance,
                    };
                };

                const finalizeSegment = (type, points, startTime, endTime, center = null) => {
                    if (!points.length) {
                        return;
                    }

                    const startValue = normalizeSegmentTime(startTime);
                    const endValue = normalizeSegmentTime(endTime);
                    const segmentStartTime = startValue !== null && endValue !== null
                        ? Math.min(startValue, endValue)
                        : (startValue !== null ? startValue : endValue);
                    const segmentEndTime = startValue !== null && endValue !== null
                        ? Math.max(startValue, endValue)
                        : (endValue !== null ? endValue : startValue);

                    rawSegments.push({
                        trackerId: trackerId,
                        type: type === Mode.STOP ? 'stop' : 'travel',
                        pointCount: points.length,
                        rawPoints: points.slice(),
                        center: center,
                        centers: center ? [center] : [],
                        startTime: segmentStartTime,
                        endTime: segmentEndTime,
                    });
                };

                const isPointWithinCenterRadius = (point, center) => {
                    if (!point || !center) {
                        return false;
                    }
                    return calculateDistance(point.latitude, point.longitude, center.latitude, center.longitude, 'meters') <= radiusMeters;
                };

                const dedupeCenters = (centersList) => {
                    const seen = new Set();
                    return (Array.isArray(centersList) ? centersList : []).filter((center) => {
                        if (!center) {
                            return false;
                        }
                        const centerKey = `${Number(center.latitude).toFixed(6)}:${Number(center.longitude).toFixed(6)}`;
                        if (seen.has(centerKey)) {
                            return false;
                        }
                        seen.add(centerKey);
                        return true;
                    });
                };

                const clampNumber = (value, min, max) => {
                    if (!Number.isFinite(value)) {
                        return min;
                    }
                    return Math.min(max, Math.max(min, value));
                };

                const getPointDistanceFromCenter = (point, center) => {
                    if (!point || !center) {
                        return null;
                    }
                    return calculateDistance(point.latitude, point.longitude, center.latitude, center.longitude, 'meters');
                };

                const computeAverageRadialSpeed = (center, pointsList, direction) => {
                    if (!center || !Array.isArray(pointsList) || pointsList.length < 2) {
                        return null;
                    }

                    const radialSpeeds = [];
                    for (let index = 1; index < pointsList.length; index++) {
                        const previousPoint = pointsList[index - 1];
                        const currentPoint = pointsList[index];
                        const previousTime = getPointTime(previousPoint);
                        const currentTime = getPointTime(currentPoint);
                        if (previousTime === null || currentTime === null || currentTime <= previousTime) {
                            continue;
                        }

                        const previousDistance = getPointDistanceFromCenter(previousPoint, center);
                        const currentDistance = getPointDistanceFromCenter(currentPoint, center);
                        if (!Number.isFinite(previousDistance) || !Number.isFinite(currentDistance)) {
                            continue;
                        }

                        const radialDelta = currentDistance - previousDistance;
                        const deltaSeconds = (currentTime - previousTime) / 1000;
                        if (deltaSeconds <= 0) {
                            continue;
                        }

                        if (direction === 'outbound' && radialDelta > 0) {
                            radialSpeeds.push(radialDelta / deltaSeconds);
                        }
                        if (direction === 'inbound' && radialDelta < 0) {
                            radialSpeeds.push(Math.abs(radialDelta) / deltaSeconds);
                        }
                    }

                    if (!radialSpeeds.length) {
                        return null;
                    }

                    return radialSpeeds.reduce((sum, speed) => sum + speed, 0) / radialSpeeds.length;
                };

                const estimateBoundaryCrossingTime = (center, insidePoint, outsidePoints, direction) => {
                    const insideTime = getPointTime(insidePoint);
                    if (!center || !insidePoint || insideTime === null) {
                        return insideTime;
                    }

                    const insideDistance = getPointDistanceFromCenter(insidePoint, center);
                    if (!Number.isFinite(insideDistance)) {
                        return insideTime;
                    }

                    const candidates = (Array.isArray(outsidePoints) ? outsidePoints : []).filter((point) => getPointTime(point) !== null);
                    if (!candidates.length) {
                        return insideTime;
                    }

                    const boundaryReferencePoints = direction === 'outbound'
                        ? candidates.slice(0, Math.max(1, exitPoints))
                        : candidates.slice(Math.max(0, candidates.length - Math.max(1, exitPoints)));

                    const speedSeries = direction === 'outbound'
                        ? [insidePoint].concat(boundaryReferencePoints)
                        : boundaryReferencePoints.concat([insidePoint]);
                    const averageRadialSpeed = computeAverageRadialSpeed(center, speedSeries, direction);

                    const distanceToRadius = Math.max(0, radiusMeters - insideDistance);
                    let estimatedCrossingTime = null;

                    if (Number.isFinite(averageRadialSpeed) && averageRadialSpeed > 0 && distanceToRadius > 0) {
                        const crossingDeltaMs = (distanceToRadius / averageRadialSpeed) * 1000;
                        estimatedCrossingTime = direction === 'outbound'
                            ? insideTime + crossingDeltaMs
                            : insideTime - crossingDeltaMs;
                    }

                    const nearestOutsidePoint = direction === 'outbound'
                        ? boundaryReferencePoints[0]
                        : boundaryReferencePoints[boundaryReferencePoints.length - 1];
                    const nearestOutsideTime = getPointTime(nearestOutsidePoint);
                    const nearestOutsideDistance = getPointDistanceFromCenter(nearestOutsidePoint, center);

                    if (
                        !Number.isFinite(estimatedCrossingTime) &&
                        nearestOutsideTime !== null &&
                        Number.isFinite(nearestOutsideDistance) &&
                        Math.abs(nearestOutsideDistance - insideDistance) > 0.001
                    ) {
                        const interpolationRatio = clampNumber(
                            (radiusMeters - insideDistance) / (nearestOutsideDistance - insideDistance),
                            0,
                            1
                        );
                        estimatedCrossingTime = insideTime + ((nearestOutsideTime - insideTime) * interpolationRatio);
                    }

                    if (!Number.isFinite(estimatedCrossingTime)) {
                        return insideTime;
                    }

                    if (nearestOutsideTime !== null) {
                        const minBound = Math.min(insideTime, nearestOutsideTime);
                        const maxBound = Math.max(insideTime, nearestOutsideTime);
                        estimatedCrossingTime = clampNumber(estimatedCrossingTime, minBound, maxBound);
                    }

                    return estimatedCrossingTime;
                };

                const canMergeStopBridge = (leftStop, bridgeSegment, rightStop) => {
                    if (!leftStop || !bridgeSegment || !rightStop) {
                        return false;
                    }
                    if (leftStop.type !== 'stop' || bridgeSegment.type !== 'travel' || rightStop.type !== 'stop') {
                        return false;
                    }

                    const stopCenters = dedupeCenters([
                        ...(Array.isArray(leftStop.centers) ? leftStop.centers : []),
                        ...(Array.isArray(rightStop.centers) ? rightStop.centers : []),
                    ]);

                    if (!stopCenters.length) {
                        return false;
                    }

                    const bridgePoints = Array.isArray(bridgeSegment.rawPoints) ? bridgeSegment.rawPoints.filter(Boolean) : [];
                    const maxMergeBridgePoints = Math.max(exitPoints * 3, 12);
                    if (!bridgePoints.length || bridgePoints.length > maxMergeBridgePoints) {
                        return false;
                    }

                    return bridgePoints.every((point) => stopCenters.some((center) => isPointWithinCenterRadius(point, center)));
                };

                const mergeStopBridgeSegments = (segmentsList) => {
                    const mergedSegments = [];

                    for (let segmentIndex = 0; segmentIndex < segmentsList.length; segmentIndex++) {
                        const currentSegment = segmentsList[segmentIndex];
                        const previousSegment = mergedSegments[mergedSegments.length - 1];
                        const nextSegment = segmentsList[segmentIndex + 1];

                        if (previousSegment && canMergeStopBridge(previousSegment, currentSegment, nextSegment)) {
                            previousSegment.rawPoints = previousSegment.rawPoints.concat(currentSegment.rawPoints || [], nextSegment.rawPoints || []);
                            previousSegment.pointCount = previousSegment.rawPoints.length;
                            previousSegment.endTime = nextSegment.endTime;
                            previousSegment.centers = dedupeCenters([
                                ...(Array.isArray(previousSegment.centers) ? previousSegment.centers : []),
                                ...(Array.isArray(nextSegment.centers) ? nextSegment.centers : []),
                            ]);
                            previousSegment.center = previousSegment.centers[0] || previousSegment.center || nextSegment.center || null;
                            segmentIndex += 1;
                            continue;
                        }

                        mergedSegments.push({
                            ...currentSegment,
                            rawPoints: Array.isArray(currentSegment.rawPoints) ? currentSegment.rawPoints.slice() : [],
                            centers: Array.isArray(currentSegment.centers) ? currentSegment.centers.slice() : [],
                        });
                    }

                    return mergedSegments;
                };

                const getSegmentPoints = (segment) => {
                    return Array.isArray(segment && segment.rawPoints) ? segment.rawPoints.filter(Boolean) : [];
                };

                const syncSegmentFromPoints = (segment) => {
                    if (!segment) {
                        return;
                    }

                    const segmentPoints = getSegmentPoints(segment);
                    segment.rawPoints = segmentPoints;
                    segment.pointCount = segmentPoints.length;

                    if (!segmentPoints.length) {
                        segment.startTime = null;
                        segment.endTime = null;
                        return;
                    }

                    const firstPointTime = getPointTime(segmentPoints[0]);
                    const lastPointTime = getPointTime(segmentPoints[segmentPoints.length - 1]);
                    if (firstPointTime !== null) {
                        segment.startTime = firstPointTime;
                    }
                    if (lastPointTime !== null) {
                        segment.endTime = lastPointTime;
                    }
                };

                const pointWithinAnyCenter = (point, centers) => {
                    return (Array.isArray(centers) ? centers : []).some((center) => isPointWithinCenterRadius(point, center));
                };

                const absorbStopRadiusBoundaryPoints = (segmentsList) => {
                    const normalizedSegments = (Array.isArray(segmentsList) ? segmentsList : []).map((segment) => ({
                        ...segment,
                        rawPoints: Array.isArray(segment.rawPoints) ? segment.rawPoints.slice() : [],
                        centers: Array.isArray(segment.centers) ? segment.centers.slice() : [],
                    }));

                    for (let index = 0; index < normalizedSegments.length - 1; index++) {
                        const leftSegment = normalizedSegments[index];
                        const rightSegment = normalizedSegments[index + 1];
                        if (!leftSegment || !rightSegment) {
                            continue;
                        }

                        if (leftSegment.type === 'stop' && rightSegment.type === 'travel') {
                            const stopCenters = dedupeCenters([
                                ...(Array.isArray(leftSegment.centers) ? leftSegment.centers : []),
                                ...(leftSegment.center ? [leftSegment.center] : []),
                            ]);
                            if (!stopCenters.length) {
                                continue;
                            }

                            const travelPoints = getSegmentPoints(rightSegment);
                            if (travelPoints.length <= 2) {
                                continue;
                            }

                            const maxAbsorbCount = Math.max(0, travelPoints.length - 2);
                            let absorbCount = 0;
                            while (absorbCount < maxAbsorbCount && pointWithinAnyCenter(travelPoints[absorbCount], stopCenters)) {
                                absorbCount += 1;
                            }

                            if (absorbCount > 0) {
                                leftSegment.rawPoints = getSegmentPoints(leftSegment).concat(travelPoints.slice(0, absorbCount));
                                rightSegment.rawPoints = travelPoints.slice(absorbCount);
                                syncSegmentFromPoints(leftSegment);
                                syncSegmentFromPoints(rightSegment);
                            }
                        }

                        if (leftSegment.type === 'travel' && rightSegment.type === 'stop') {
                            const stopCenters = dedupeCenters([
                                ...(Array.isArray(rightSegment.centers) ? rightSegment.centers : []),
                                ...(rightSegment.center ? [rightSegment.center] : []),
                            ]);
                            if (!stopCenters.length) {
                                continue;
                            }

                            const travelPoints = getSegmentPoints(leftSegment);
                            if (travelPoints.length <= 2) {
                                continue;
                            }

                            const maxAbsorbCount = Math.max(0, travelPoints.length - 2);
                            let absorbCount = 0;
                            while (
                                absorbCount < maxAbsorbCount &&
                                pointWithinAnyCenter(travelPoints[travelPoints.length - 1 - absorbCount], stopCenters)
                            ) {
                                absorbCount += 1;
                            }

                            if (absorbCount > 0) {
                                const splitIndex = travelPoints.length - absorbCount;
                                leftSegment.rawPoints = travelPoints.slice(0, splitIndex);
                                rightSegment.rawPoints = travelPoints.slice(splitIndex).concat(getSegmentPoints(rightSegment));
                                syncSegmentFromPoints(leftSegment);
                                syncSegmentFromPoints(rightSegment);
                            }
                        }
                    }

                    return normalizedSegments.filter((segment) => getSegmentPoints(segment).length > 0);
                };

                const renderSegment = (segment) => {
                    if (!segment || !Array.isArray(segment.rawPoints) || !segment.rawPoints.length) {
                        return;
                    }

                    const segmentId = `segment-${detectedSegments.length + 1}`;
                    const label = segment.type === 'stop'
                        ? `Stop ${new Date(segment.startTime).toLocaleString()}`
                        : `Travel ${new Date(segment.startTime).toLocaleString()}`;

                    detectedSegments.push({
                        id: segmentId,
                        trackerId: trackerId,
                        type: segment.type,
                        label: label,
                        pointCount: segment.rawPoints.length,
                        points: [],
                        rawPoints: segment.rawPoints,
                        center: segment.center,
                        centers: Array.isArray(segment.centers) ? segment.centers : (segment.center ? [segment.center] : []),
                        polyline: null,
                        startTime: segment.startTime,
                        endTime: segment.endTime,
                    });
                };

                let currentMode = Mode.MOVING;
                let movingPoints = [];
                let candidateStopPoints = [];
                let stopPoints = [];
                let stopCenter = null;
                let pendingExitPoints = [];
                let movingStartBoundaryTime = null;
                let stopStartBoundaryTime = null;

                const pushMovingPoint = (point) => {
                    if (!point) {
                        return;
                    }
                    movingPoints.push(point);
                };

                pointsArr.forEach((point) => {
                    const pointTime = getPointTime(point);
                    if (pointTime === null) {
                        return;
                    }

                    if (currentMode === Mode.MOVING) {
                        candidateStopPoints.push(point);

                        let candidateState = analyzeCluster(candidateStopPoints);
                        while (candidateStopPoints.length > 1 && !candidateState.valid) {
                            pushMovingPoint(candidateStopPoints.shift());
                            candidateState = analyzeCluster(candidateStopPoints);
                        }

                        const candidateStartTime = getPointTime(candidateStopPoints[0]);
                        const candidateDurationSeconds = candidateStartTime === null
                            ? 0
                            : Math.max(0, (pointTime - candidateStartTime) / 1000);

                        if (candidateStopPoints.length >= entryPoints && candidateState.valid && candidateDurationSeconds >= minSeconds) {
                            const stopEntryPoint = candidateStopPoints[0] || null;
                            const inboundOutsidePoints = movingPoints.slice(Math.max(0, movingPoints.length - Math.max(1, exitPoints)));
                            const entryBoundaryTime = stopEntryPoint
                                ? estimateBoundaryCrossingTime(candidateState.center, stopEntryPoint, inboundOutsidePoints, 'inbound')
                                : pointTime;

                            if (movingPoints.length) {
                                const movingSegmentPoints = stopEntryPoint
                                    ? movingPoints.concat(stopEntryPoint)
                                    : movingPoints;
                                finalizeSegment(
                                    Mode.MOVING,
                                    movingSegmentPoints,
                                    Number.isFinite(movingStartBoundaryTime) ? movingStartBoundaryTime : getPointTime(movingSegmentPoints[0]),
                                    Number.isFinite(entryBoundaryTime) ? entryBoundaryTime : getPointTime(movingSegmentPoints[movingSegmentPoints.length - 1])
                                );
                                movingStartBoundaryTime = null;
                            }

                            stopPoints = candidateStopPoints.slice();
                            stopCenter = candidateState.center;
                            stopStartBoundaryTime = entryBoundaryTime;
                            candidateStopPoints = [];
                            pendingExitPoints = [];
                            currentMode = Mode.STOP;
                        }

                        return;
                    }

                    if (pendingExitPoints.length) {
                        const recoveredCluster = stopPoints.concat(pendingExitPoints, point);
                        const recoveredState = analyzeCluster(recoveredCluster);
                        if (recoveredState.valid) {
                            stopPoints = recoveredCluster;
                            stopCenter = recoveredState.center;
                            pendingExitPoints = [];
                            return;
                        }

                        const resumedStopCluster = stopPoints.concat(point);
                        const resumedStopState = analyzeCluster(resumedStopCluster);
                        if (resumedStopState.valid) {
                            stopPoints = stopPoints.concat(pendingExitPoints, point);
                            stopCenter = resumedStopState.center;
                            pendingExitPoints = [];
                            return;
                        }
                    }

                    const expandedStopCluster = stopPoints.concat(point);
                    const expandedStopState = analyzeCluster(expandedStopCluster);
                    if (expandedStopState.valid) {
                        stopPoints = expandedStopCluster;
                        stopCenter = expandedStopState.center;
                        pendingExitPoints = [];
                        return;
                    }

                    pendingExitPoints.push(point);
                    if (pendingExitPoints.length < exitPoints) {
                        return;
                    }

                    if (stopPoints.length) {
                        const finalizedStopCenter = stopCenter || analyzeCluster(stopPoints).center;
                        const stopExitPoint = stopPoints[stopPoints.length - 1] || null;
                        const stopCorePoints = stopPoints.length > 2
                            ? stopPoints.slice(1, -1)
                            : [];
                        const exitBoundaryTime = stopExitPoint
                            ? estimateBoundaryCrossingTime(finalizedStopCenter, stopExitPoint, pendingExitPoints, 'outbound')
                            : getPointTime(pendingExitPoints[0]);

                        finalizeSegment(
                            Mode.STOP,
                            stopCorePoints,
                            Number.isFinite(stopStartBoundaryTime) ? stopStartBoundaryTime : getPointTime(stopPoints[0]),
                            Number.isFinite(exitBoundaryTime) ? exitBoundaryTime : getPointTime(stopPoints[stopPoints.length - 1]),
                            finalizedStopCenter
                        );

                        movingPoints = stopExitPoint
                            ? [stopExitPoint].concat(pendingExitPoints)
                            : pendingExitPoints.slice();
                        movingStartBoundaryTime = exitBoundaryTime;
                    } else {
                        movingPoints = pendingExitPoints.slice();
                        movingStartBoundaryTime = null;
                    }
                    candidateStopPoints = [];
                    stopPoints = [];
                    stopCenter = null;
                    stopStartBoundaryTime = null;
                    pendingExitPoints = [];
                    currentMode = Mode.MOVING;
                });

                if (currentMode === Mode.STOP) {
                    const trailingStopPoints = stopPoints.concat(pendingExitPoints);
                    const trailingStopState = analyzeCluster(trailingStopPoints);
                    const finalizedStopPoints = trailingStopState.valid
                        ? trailingStopPoints
                        : stopPoints;
                    const finalizedStopCenter = trailingStopState.valid
                        ? trailingStopState.center
                        : stopCenter;
                    const stopCorePoints = finalizedStopPoints.length > 2
                        ? finalizedStopPoints.slice(1, -1)
                        : [];

                    finalizeSegment(
                        Mode.STOP,
                        stopCorePoints,
                        Number.isFinite(stopStartBoundaryTime) ? stopStartBoundaryTime : getPointTime(finalizedStopPoints[0]),
                        getPointTime(finalizedStopPoints[finalizedStopPoints.length - 1]),
                        finalizedStopCenter
                    );
                    const boundaryNormalizedSegments = absorbStopRadiusBoundaryPoints(rawSegments);
                    (allTrackersSelected ? boundaryNormalizedSegments : mergeStopBridgeSegments(boundaryNormalizedSegments)).forEach(renderSegment);
                    return;
                }

                const trailingMovingPoints = movingPoints.concat(candidateStopPoints);
                finalizeSegment(
                    Mode.MOVING,
                    trailingMovingPoints,
                    Number.isFinite(movingStartBoundaryTime) ? movingStartBoundaryTime : getPointTime(trailingMovingPoints[0]),
                    getPointTime(trailingMovingPoints[trailingMovingPoints.length - 1])
                );

                const boundaryNormalizedSegments = absorbStopRadiusBoundaryPoints(rawSegments);
                (allTrackersSelected ? boundaryNormalizedSegments : mergeStopBridgeSegments(boundaryNormalizedSegments)).forEach(renderSegment);
            });
        }

        function processSegments(pointsMap) {

            var pointsArr = Array.from(pointsMap.values());

            var mode = Mode.MOVING; // Initial mode

            const runningAverageWindow = 5; // Number of points to consider for the running average
            var runningAveragePoints = [];
            var runningAverageLoc = {
                latitude: 0,
                longitude: 0,
            };
            var stoppedPointCount = 0;
            var movingPointCount = 0;
            const stoppedPointDistanceThreshold = 100; // Number of consecutive points below speed threshold to consider as stopped

            for (let i = 0; i < pointsArr.length; i++) {
                console.log(`Processing point ${i} with puid ${pointsArr[i].puid} in mode ${mode}`);
                console.log(`Current point: `, pointsArr[i]);
                console.log(`Running average location: `, runningAverageLoc);
                console.log(`Distance from running average: `, calculateDistance(pointsArr[i].latitude, pointsArr[i].longitude, runningAverageLoc.latitude, runningAverageLoc.longitude, 'meters'));
                console.log(`Stopped point count: ${stoppedPointCount}`);
                console.log(`Moving point count: ${movingPointCount}`);

                if (mode ===Mode.MOVING) {
                    runningAveragePoints.push(pointsArr[i]);
                    if (runningAveragePoints.length > runningAverageWindow) {
                        runningAveragePoints.shift(); // Remove the oldest point to maintain the window size
                    }
                    runningAverageLoc.latitude = runningAveragePoints.reduce((sum, p) => sum + p.latitude, 0) / runningAveragePoints.length;
                    runningAverageLoc.longitude = runningAveragePoints.reduce((sum, p) => sum + p.longitude, 0) / runningAveragePoints.length;

                    var distance = calculateDistance(pointsArr[i].latitude, pointsArr[i].longitude, runningAverageLoc.latitude, runningAverageLoc.longitude, 'meters');

                    if ((runningAverageLoc.latitude != 0) && (distance < stoppedPointDistanceThreshold)) {
                        stoppedPointCount++;
                    } else {
                        stoppedPointCount = 0; // Reset count if movement is detected
                    }

                    if (stoppedPointCount > runningAverageWindow) { // Threshold for stopping, adjust as needed
                        console.log(`Transition from STOP to MOVING at point ${pointsArr[i- runningAverageWindow].puid}`);
                        console.log(pointsArr[i- runningAverageWindow]);
                        //add a marker to the map for the stopped point
                        map.addLayer(L.marker([pointsArr[i- runningAverageWindow].latitude, pointsArr[i- runningAverageWindow].longitude]).bindPopup("Stopping Point: " + new Date(pointsArr[i- runningAverageWindow].time).toLocaleString()).addTo(map));
                        mode = Mode.STOP;
                        //i -= runningAverageWindow; // Re-evaluate points in the new moderunningAvergaePoints = [];
                        
                        // runningAveragePoints = [];
                        // runningAverageLoc = {
                        //     latitude: 0,
                        //     longitude: 0,
                        // }; //reset running average and location when stopping
                    }
                } else if (mode === Mode.STOP) {
                    runningAveragePoints.push(pointsArr[i]);
                    if (runningAveragePoints.length > runningAverageWindow) {
                        runningAveragePoints.shift(); // Remove the oldest point to maintain the window size
                    }
                    runningAverageLoc.latitude = runningAveragePoints.reduce((sum, p) => sum + p.latitude, 0) / runningAveragePoints.length;
                    runningAverageLoc.longitude = runningAveragePoints.reduce((sum, p) => sum + p.longitude, 0) / runningAveragePoints.length;

                    var distance = calculateDistance(pointsArr[i].latitude, pointsArr[i].longitude, runningAverageLoc.latitude, runningAverageLoc.longitude, 'meters');

                    if (distance >= stoppedPointDistanceThreshold) {
                        movingPointCount++;
                    } else {
                        movingPointCount = 0; // Reset count if movement is detected
                    }

                    if (movingPointCount > runningAverageWindow) { // Threshold for stopping, adjust as needed
                        console.log(`Transition from MOVING to STOP at point ${pointsArr[i- runningAverageWindow].puid}`);
                        console.log(pointsArr[i- runningAverageWindow]);
                        //add a marker to the map for the stopped point
                        map.addLayer(L.marker([pointsArr[i- runningAverageWindow].latitude, pointsArr[i- runningAverageWindow].longitude]).bindPopup("Moving Point: " + new Date(pointsArr[i- runningAverageWindow].time).toLocaleString()).addTo(map));
                        mode = Mode.MOVING;
                        //i -= runningAverageWindow; // Re-evaluate points in the new moderunningAvergaePoints = [];
                        
                        // runningAveragePoints = [];
                        // runningAverageLoc = {
                        //     latitude: 0,
                        //     longitude: 0,
                        // }; //reset running average and location when stopping
                    }
                }
            }
        }

        function renderTrackerColorControls() {
            const container = document.getElementById("trackerColorControls");
            if (!container) {
                return;
            }
            if (!trackers.length) {
                container.innerHTML = "<div style='font-size: 12px; color: #666;'>No trackers loaded yet.</div>";
                renderTrackerLegend();
                return;
            }

            container.innerHTML = trackers.map((trackerId) => {
                const color = getTrackerColor(trackerId);
                return `<label style='display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-size: 12px;'>
                    <span style='flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;'>${trackerId}</span>
                    <input type='color' value='${color}' data-tracker-id='${trackerId}' onchange='updateTrackerColor(this.getAttribute("data-tracker-id"), this.value); saveSettings(); refreshPoints();' />
                </label>`;
            }).join('');

            renderTrackerLegend();
        }

        function renderTrackerLegend() {
            const container = document.getElementById('trackerLegendBody');
            if (!container) {
                return;
            }

            const liveScopeLabel = settingsState.liveTrackerScope === 'all' ? 'All trackers in DB' : 'Current tracker only';
            const liveRefreshLabel = isAutoMqttUpdateEnabled() ? 'Live markers refreshing' : 'Live markers off';
            const selectedTrackerId = getCurrentSelectedTrackerId();
            const performanceModeLabel = isAllTrackersSelected() ? 'Active (all trackers selected)' : 'Inactive';
            const pointTrackers = Array.from((points && points.keys ? points.keys() : []));
            const knownTrackers = Array.isArray(allTrackers) ? allTrackers : [];
            const legendTrackerCandidates = selectedTrackerId === 'all_trackers'
                ? Array.from(new Set([...knownTrackers, ...pointTrackers]))
                : [selectedTrackerId];
            const activeLegendTrackers = legendTrackerCandidates
                .filter((trackerId) => Boolean(trackerId) && trackerId !== 'all_trackers')
                .sort((left, right) => String(left).localeCompare(String(right)));

            const trackerRows = activeLegendTrackers.length
                ? activeLegendTrackers.map((trackerId) => {
                    const color = getTrackerColor(trackerId);
                    const disabledClass = isTrackerEnabled(trackerId) ? '' : ' disabled';
                    const toggleVerb = isTrackerEnabled(trackerId) ? 'Disable' : 'Enable';
                    return `<button type='button' class='tracker-legend-row tracker-legend-toggle-row${disabledClass}' onclick='toggleTrackerLegendItem("${encodeURIComponent(trackerId)}")' title='${toggleVerb} ${trackerId}'>
                        <span class='tracker-legend-line' style='background:${color};'></span>
                        <span class='tracker-legend-label'>${trackerId}</span>
                    </button>`;
                }).join('')
                : "<div class='tracker-legend-empty'>No tracker lines in current results.</div>";

            container.innerHTML = `
                <div class='tracker-legend-section'>
                    <div class='tracker-legend-title'>Tracker Lines</div>
                    <div class='tracker-legend-list'>${trackerRows}</div>
                </div>
                <div class='tracker-legend-section'>
                    <div class='tracker-legend-title'>Stops</div>
                    <div class='tracker-legend-row'>
                        <span class='tracker-legend-stop-circle'>
                            <span class='tracker-legend-stop-center'></span>
                        </span>
                        <span class='tracker-legend-label'>Stop circle + center</span>
                    </div>
                    <div class='tracker-legend-row'>
                        <span class='tracker-legend-stop-point'></span>
                        <span class='tracker-legend-label'>Stop point</span>
                    </div>
                </div>
                <div class='tracker-legend-section'>
                    <div class='tracker-legend-title'>Live Markers</div>
                    <div class='tracker-legend-status'>${liveRefreshLabel}</div>
                    <div class='tracker-legend-substatus'>Scope: ${liveScopeLabel}</div>
                    <div class='tracker-legend-substatus'>Performance mode: ${performanceModeLabel}</div>
                    <div class='tracker-legend-substatus'>Visible line trackers: ${activeLegendTrackers.length}</div>
                    <div class='tracker-legend-substatus'>Known trackers: ${trackers.length}</div>
                </div>
            `;
        }

        function toggleTrackerLegend() {
            const legend = document.getElementById('trackerLegend');
            const button = document.getElementById('trackerLegendToggle');
            if (!legend || !button) {
                return;
            }

            const collapsed = legend.classList.toggle('collapsed');
            button.textContent = collapsed ? 'Show' : 'Hide';
            button.setAttribute('aria-expanded', String(!collapsed));
        }

        function toggleTrackerLegendItem(encodedTrackerId) {
            const trackerId = decodeURIComponent(encodedTrackerId || '');
            if (!trackerId) {
                return;
            }

            if (isTrackerEnabled(trackerId)) {
                disabledTrackers[trackerId] = true;
            } else {
                delete disabledTrackers[trackerId];
            }

            saveSettings();
            renderTrackerLegend();
            refreshPoints();
        }

        function updateTrackerColor(trackerId, color) {
            if (!trackerId) {
                return;
            }
            trackerColors[trackerId] = color;
            saveSettings();
            renderTrackerLegend();
        }

        function fetchTrackersCatalog(options = {}) {
            const xhttp = new XMLHttpRequest();
            xhttp.onload = function() {
                try {
                    const response = JSON.parse(this.responseText);
                    processTrackers(Array.isArray(response) ? response : response.trackers || []);
                    if (options && typeof options.onLoaded === 'function') {
                        options.onLoaded();
                    }
                } catch (err) {
                    console.error("Failed to load trackers", err);
                }
            }
            xhttp.open("GET", "/trackers", true);
            xhttp.send();
        }

        function processTrackers(trackersList) {
            // Process trackers as needed
            console.log("Received Trackers: ", trackersList);
            const incomingTrackers = Array.isArray(trackersList) ? trackersList : [];
            if (incomingTrackers.length) {
                const mergedTrackers = new Set([...(Array.isArray(allTrackers) ? allTrackers : []), ...incomingTrackers]);
                allTrackers = Array.from(mergedTrackers).sort((left, right) => String(left).localeCompare(String(right)));
            }
            trackers = Array.isArray(allTrackers) ? allTrackers : [];
            const savedSettings = loadSettings();
            const queryTrackerId = new URLSearchParams(window.location.search).get('tracker_id');
            const existingSelectedTracker = document.getElementById("selTrackers").value;
            const previouslySelectedTracker = existingSelectedTracker || (savedSettings && savedSettings.trackerId) || queryTrackerId || "";
            const selectedTrackerId = previouslySelectedTracker || "all_trackers";
            
            const selTrackers = document.getElementById("selTrackers");
            selTrackers.innerHTML = ""; // Clear existing options

            let option = document.createElement("option");
            option.value = "all_trackers";
            option.text = "All Trackers";
            if (selectedTrackerId === "all_trackers") {
                option.selected = true;
            }
            selTrackers.appendChild(option);
            
            trackers.forEach(function(tracker_id) {
                option = document.createElement("option");
                option.value = tracker_id;
                option.text = tracker_id;
                if (tracker_id === selectedTrackerId) {
                    option.selected = true;
                }
                selTrackers.appendChild(option);
            });
            if (!trackers.includes(selectedTrackerId) && trackers.length > 0) {
                selTrackers.value = "all_trackers";
            }
            applySettingsToForm(savedSettings || {}, { skipTrackerSelectionRestore: true });
            renderTrackerColorControls();
        }

        function openSettingsOverlay() {
            const overlay = document.getElementById('settingsOverlay');
            if (overlay) {
                overlay.classList.add('open');
            }
            if (map && map.invalidateSize) {
                setTimeout(() => map.invalidateSize(), 0);
            }
        }

        function closeSettingsOverlay() {
            const overlay = document.getElementById('settingsOverlay');
            if (overlay) {
                overlay.classList.remove('open');
            }
            if (map && map.invalidateSize) {
                setTimeout(() => map.invalidateSize(), 0);
            }
        }

        function toggleSettingsOverlay() {
            const overlay = document.getElementById('settingsOverlay');
            if (overlay && overlay.classList.contains('open')) {
                closeSettingsOverlay();
            } else {
                openSettingsOverlay();
            }
        }

        function setSegmentDrawerExpanded(expanded) {
            const drawer = document.getElementById('segmentDrawer');
            const toggleButton = document.getElementById('segmentDrawerToggleButton');
            if (!drawer) {
                return;
            }
            drawer.classList.toggle('expanded', expanded);
            drawer.classList.toggle('collapsed', !expanded);
            if (toggleButton) {
                toggleButton.textContent = expanded ? '▾' : '▴';
                toggleButton.setAttribute('aria-label', expanded ? 'Collapse segments drawer' : 'Expand segments drawer');
                toggleButton.setAttribute('title', expanded ? 'Collapse segments drawer' : 'Expand segments drawer');
                toggleButton.setAttribute('aria-expanded', String(expanded));
            }
            if (map && map.invalidateSize) {
                setTimeout(() => map.invalidateSize(), 50);
                if (selectedSegmentId) {
                    setTimeout(() => highlightSegment(selectedSegmentId), 90);
                }
            }
        }

        function toggleSegmentDrawer() {
            const drawer = document.getElementById('segmentDrawer');
            if (!drawer) {
                return;
            }
            setSegmentDrawerExpanded(!drawer.classList.contains('expanded'));
        }

        function toggleSegmentDrawerFromButton() {
            toggleSegmentDrawer();
        }

        let segmentDrawerDragStartY = null;
        let segmentDrawerDragStartExpanded = false;

        function handleSegmentDrawerPointerDown(event) {
            const drawer = document.getElementById('segmentDrawer');
            if (!drawer || event.button === 2) {
                return;
            }
            if (event.target && event.target.closest && (event.target.closest('button') || event.target.closest('select'))) {
                return;
            }
            segmentDrawerDragStartY = event.clientY;
            segmentDrawerDragStartExpanded = drawer.classList.contains('expanded');
            if (event.currentTarget && event.currentTarget.setPointerCapture) {
                event.currentTarget.setPointerCapture(event.pointerId);
            }
        }

        function handleSegmentDrawerPointerUp(event) {
            if (segmentDrawerDragStartY === null) {
                return;
            }
            if (event.target && event.target.closest && (event.target.closest('button') || event.target.closest('select'))) {
                segmentDrawerDragStartY = null;
                return;
            }
            const drawer = document.getElementById('segmentDrawer');
            if (!drawer) {
                segmentDrawerDragStartY = null;
                return;
            }
            const deltaY = segmentDrawerDragStartY - event.clientY;
            const shouldExpand = deltaY < -40 ? true : deltaY > 40 ? false : !segmentDrawerDragStartExpanded;
            setSegmentDrawerExpanded(shouldExpand);
            segmentDrawerDragStartY = null;
        }

        function initMap() {
            const mapContainer = document.getElementById('theMap');
            if (mapContainer) {
                const isMobile = window.innerWidth <= 900;
                mapContainer.style.display = 'block';
                mapContainer.style.position = 'absolute';
                mapContainer.style.inset = '0';
                mapContainer.style.zIndex = '0';
                mapContainer.style.background = '#e5e5e5';
                mapContainer.style.borderRadius = '0';
                mapContainer.style.overflow = 'hidden';
                mapContainer.style.width = '100vw';
                mapContainer.style.maxWidth = '100vw';
                mapContainer.style.height = '100vh';
                mapContainer.style.minHeight = '100vh';
                mapContainer.style.marginLeft = '0';
            }

            const initializeLeaflet = () => {
                if (!mapContainer || map) {
                    return;
                }
                map = L.map(mapContainer, { zoomControl: true, preferCanvas: true }).setView([0, 0], 2);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                }).addTo(map);
            };
            
             // Define a custom circle icon
            circleIcon = L.divIcon({
                className: 'jpico',
                html: "<div style='background-color:#4838cc;' class='marker-pin'></div><i style='transform: rotate(GPS_COURSEdeg)' class='fa-regular fa-circle-up' style='--fa-rotate-angle: 25deg;'></i>",
                iconSize: [10, 10],
                iconAnchor: [5, 5],
                popupAnchor: [-3, -76],
            });

            const refreshMapLayout = () => {
                if (mapContainer) {
                    mapContainer.style.width = '100vw';
                    mapContainer.style.maxWidth = '100vw';
                    mapContainer.style.height = '100vh';
                    mapContainer.style.minHeight = '100vh';
                    mapContainer.style.marginLeft = '0';
                }
                if (map && map.invalidateSize) {
                    setTimeout(() => map.invalidateSize(), 0);
                    setTimeout(() => map.invalidateSize(), 100);
                }
            };

            setTimeout(refreshMapLayout, 0);
            setTimeout(refreshMapLayout, 150);
            setTimeout(() => {
                if (mapContainer) {
                    mapContainer.style.height = '100vh';
                    mapContainer.style.minHeight = '100vh';
                    mapContainer.style.width = '100vw';
                    mapContainer.style.maxWidth = '100vw';
                    mapContainer.style.marginLeft = '0';
                    initializeLeaflet();
                }
            }, 300);

            window.addEventListener('resize', refreshMapLayout);

            const drawerHandle = document.getElementById('segmentDrawerHandle');
            if (drawerHandle) {
                drawerHandle.addEventListener('pointerdown', handleSegmentDrawerPointerDown);
                drawerHandle.addEventListener('pointerup', handleSegmentDrawerPointerUp);
                drawerHandle.addEventListener('pointercancel', () => {
                    segmentDrawerDragStartY = null;
                });
            }

            // var circleIcon = L.icon({
            //     iconUrl: '/map-point.png',
            //     iconSize: [10, 10],
            //     iconAnchor: [5, 5],
            //     popupAnchor: [-3, -76],
            //     className: 'jpico'
            // });
        }

        function initDateTimePicker() {
            const picker = $('input[name="datetimes"]').daterangepicker({
                timePicker: true,
                startDate: moment().startOf('day'),
                endDate: moment(),
                locale: {
                    format: 'M/DD hh:mm A'
                }
            });

            picker.on('apply.daterangepicker', function() {
                saveSettings();
            });
        }

        function loadTrackers() {
            fetchTrackersCatalog({ onLoaded: () => loadTrackersAndPoints() });
        }

        function getOrCreateManualUpdatesClientId() {
            if (manualUpdatesClientId) {
                return manualUpdatesClientId;
            }

            const storageKey = 'manualMqttUpdatesClientId';
            try {
                if (window.localStorage) {
                    const existingId = window.localStorage.getItem(storageKey);
                    if (existingId) {
                        manualUpdatesClientId = existingId;
                        return manualUpdatesClientId;
                    }
                }
            } catch (err) {
                console.warn('Unable to read manual update client ID from localStorage', err);
            }

            const randomPart = Math.random().toString(16).slice(2);
            manualUpdatesClientId = `viewer-${Date.now()}-${randomPart}`;
            try {
                if (window.localStorage) {
                    window.localStorage.setItem(storageKey, manualUpdatesClientId);
                }
            } catch (err) {
                console.warn('Unable to store manual update client ID to localStorage', err);
            }

            return manualUpdatesClientId;
        }

        function postJson(url, payload) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload || {}),
            });
        }

        function stopManualUpdatesKeepAlive() {
            if (manualUpdatesKeepAliveTimer) {
                clearInterval(manualUpdatesKeepAliveTimer);
                manualUpdatesKeepAliveTimer = null;
            }
        }

        function stopManualUpdatesFollow() {
            if (manualUpdatesFollowTimer) {
                clearInterval(manualUpdatesFollowTimer);
                manualUpdatesFollowTimer = null;
            }
        }

        function sendManualUpdatesKeepAlive() {
            const clientId = getOrCreateManualUpdatesClientId();
            postJson('/api/mqtt/manual-updates/keepalive', { clientId }).catch((err) => {
                console.warn('Manual MQTT keepalive failed', err);
            });
        }

        function startManualUpdatesKeepAlive() {
            stopManualUpdatesKeepAlive();
            sendManualUpdatesKeepAlive();
            manualUpdatesKeepAliveTimer = setInterval(sendManualUpdatesKeepAlive, manualUpdatesKeepAliveSeconds * 1000);
        }

        function startManualUpdatesFollow(intervalSeconds) {
            stopManualUpdatesFollow();
            const safeIntervalSeconds = Math.max(5, parseInt(intervalSeconds, 10) || 0);
            if (!safeIntervalSeconds) {
                return;
            }

            activeSearchFollowsNow = shouldFollowTimeframeNow();
            fetchTrackersCatalog();
            if (activeSearchFollowsNow) {
                loadTrackersAndPoints({ preserveViewport: true, followNow: true, evaluateFollowMode: false });
            } else {
                refreshLiveMarkers();
            }

            manualUpdatesFollowTimer = setInterval(() => {
                if (!map || !linesGroup || !transitionGroup) {
                    return;
                }
                activeSearchFollowsNow = shouldFollowTimeframeNow();
                fetchTrackersCatalog();
                if (activeSearchFollowsNow) {
                    loadTrackersAndPoints({ preserveViewport: true, followNow: true, evaluateFollowMode: false });
                    return;
                }
                refreshLiveMarkers();
            }, safeIntervalSeconds * 1000);
        }

        function getManualMqttIntervalSeconds() {
            const stateValue = Number(settingsState.manualMqttIntervalSeconds);
            if (Number.isFinite(stateValue) && stateValue >= 0) {
                return stateValue;
            }
            const select = document.getElementById('manualMqttIntervalSelect');
            const intervalSeconds = parseInt(select && select.value, 10);
            return Number.isFinite(intervalSeconds) ? intervalSeconds : 0;
        }

        function updateLiveTrackerControlsUi() {
            const intervalSeconds = getManualMqttIntervalSeconds();
            const isEnabled = intervalSeconds > 0;
            const liveTrackerScopeSelect = document.getElementById('liveTrackerScopeSelect');
            const liveTrackerStatus = document.getElementById('liveTrackerSettingsStatus');
            const liveTrackerSettingsGroup = document.getElementById('liveTrackerSettingsGroup');

            if (liveTrackerScopeSelect) {
                liveTrackerScopeSelect.disabled = !isEnabled;
            }

            if (liveTrackerStatus) {
                liveTrackerStatus.textContent = isEnabled
                    ? `Enabled via MQTT refresh every ${intervalSeconds}s`
                    : 'Enable MQTT refresh to update live tracker markers';
            }

            if (liveTrackerSettingsGroup) {
                liveTrackerSettingsGroup.classList.toggle('disabled', !isEnabled);
            }

            renderTrackerLegend();
        }

        function updateManualUpdateWatcherFromUi() {
            const clientId = getOrCreateManualUpdatesClientId();
            const intervalSeconds = getManualMqttIntervalSeconds();
            updateLiveTrackerControlsUi();

            if (intervalSeconds > 0) {
                postJson('/api/mqtt/manual-updates/watch', { clientId, intervalSeconds })
                    .then(() => {
                        startManualUpdatesKeepAlive();
                        startManualUpdatesFollow(intervalSeconds);
                    })
                    .catch((err) => {
                        console.warn('Unable to register manual MQTT updates watcher', err);
                    });
                return;
            }

            stopManualUpdatesKeepAlive();
            stopManualUpdatesFollow();
            postJson('/api/mqtt/manual-updates/unwatch', { clientId }).catch((err) => {
                console.warn('Unable to unregister manual MQTT updates watcher', err);
            });
        }

        window.addEventListener('beforeunload', function() {
            const clientId = getOrCreateManualUpdatesClientId();
            stopManualUpdatesKeepAlive();
            stopManualUpdatesFollow();

            if (navigator.sendBeacon) {
                const payload = new Blob([JSON.stringify({ clientId })], { type: 'application/json' });
                navigator.sendBeacon('/api/mqtt/manual-updates/unwatch', payload);
                return;
            }

            fetch('/api/mqtt/manual-updates/unwatch', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ clientId }),
                keepalive: true,
            });
        });

        $(function(){

            initMap();
            initDateTimePicker();

            startupSettingsSnapshot = loadSettings();
            applySettingsToForm(startupSettingsSnapshot);
            updateManualUpdateWatcherFromUi();

            const ensureMapReady = () => {
                if (!map) {
                    setTimeout(ensureMapReady, 50);
                    return;
                }
                linesGroup = L.layerGroup();
                linesGroup.addTo(map);
                transitionGroup = L.layerGroup();
                transitionGroup.addTo(map);
                liveMarkersGroup = L.layerGroup();
                liveMarkersGroup.addTo(map);
                loadTrackers();
            };

            ensureMapReady();

        });
        
        function debounce(callback, wait = 1000) {
            let timeout;
            return function executedFunction(...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => callback.apply(this, args), wait);
            };
        }

        // Usage
        const refreshPoints = debounce(() => {
            saveSettings();
            loadTrackersAndPoints();
        }, 150);

        function quickDaysAgoUpdated() {
            $("#inp_quick_days").val('')
            $("#inp_quick_hours").val('')
            let inputX = parseInt($("#inp_quick_days_ago").val());
            
            if (typeof inputX !== 'number' || inputX < 0) {
                console.error("Input must be >= 0");
                return;
            }

            $('#sel_datetimes').data('daterangepicker').setStartDate(moment().subtract(inputX, 'days').startOf('day'));
            $('#sel_datetimes').data('daterangepicker').setEndDate(moment().subtract(inputX-1, 'days').startOf('day'));

            refreshPoints();
        }

        function quickDaysUpdated() {
            $("#inp_quick_days_ago").val('')
            $("#inp_quick_hours").val('')
            let inputX = parseInt($("#inp_quick_days").val());
            
            if (typeof inputX !== 'number' || inputX < 1) {
                console.error("Input must be >= 1");
                return;
            }

            $('#sel_datetimes').data('daterangepicker').setStartDate(moment().subtract(inputX-1, 'days').startOf('day'));
            $('#sel_datetimes').data('daterangepicker').setEndDate(moment());

            refreshPoints();
        }

        function quickHoursUpdated() {
            $("#inp_quick_days").val('')
            $("#inp_quick_days_ago").val('')
            let inputX = parseInt($("#inp_quick_hours").val());
            
            if (typeof inputX !== 'number' || inputX < 1) {
                console.error("Input must be >= 1");
                return;
            }

            $('#sel_datetimes').data('daterangepicker').setStartDate(moment().subtract(inputX-1, 'hours').startOf('hour'));
            $('#sel_datetimes').data('daterangepicker').setEndDate(moment());

            refreshPoints();
        }



