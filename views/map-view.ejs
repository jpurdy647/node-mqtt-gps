            padding: 9px 10px;
            background: linear-gradient(180deg, rgba(248, 250, 252, 0.98), rgba(241, 245, 249, 0.94));
            border-bottom: 1px solid rgba(148, 163, 184, 0.28);
        }
        .tracker-legend-header span {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.02em;
            color: #0f172a;
        }
        .tracker-legend-toggle {
            border: 1px solid #d0d7de;
            border-radius: 999px;
            background: #fff;
            color: #334155;
            font-size: 11px;
            font-weight: 600;
            min-height: 24px;
            padding: 0 10px;
            cursor: pointer;
        }
        .tracker-legend-body {
            max-height: 280px;
            overflow: auto;
            padding: 9px 10px 10px;
        }
        .tracker-legend.collapsed {
            width: auto;
            min-width: 0;
            max-width: calc(100vw - 24px);
        }
        .tracker-legend.collapsed .tracker-legend-body {
            display: none;
        }
        .tracker-legend.collapsed .tracker-legend-header {
            padding: 7px 8px;
            gap: 6px;
        }
        .tracker-legend-section {
            margin-bottom: 10px;
        }
        .tracker-legend-section:last-child {
            margin-bottom: 0;
        }
        .tracker-legend-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: #475569;
            margin-bottom: 6px;
        }
        .tracker-legend-list {
            display: grid;
            gap: 4px;
        }
        .tracker-legend-row {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 20px;
        }
        .tracker-legend-toggle-row {
            width: 100%;
            border: 1px solid transparent;
            border-radius: 8px;
            background: transparent;
            padding: 3px 4px;
            cursor: pointer;
            text-align: left;
        }
        .tracker-legend-toggle-row:hover {
            background: rgba(148, 163, 184, 0.14);
            border-color: rgba(148, 163, 184, 0.3);
        }
        .tracker-legend-toggle-row.disabled {
            background: rgba(148, 163, 184, 0.16);
            border-color: rgba(148, 163, 184, 0.34);
        }
        .tracker-legend-toggle-row.disabled .tracker-legend-line {
            background: #94a3b8 !important;
        }
        .tracker-legend-toggle-row.disabled .tracker-legend-label {
            color: #64748b;
        }
        .tracker-legend-line {
            display: inline-block;
            width: 24px;
            height: 4px;
            border-radius: 999px;
            flex: 0 0 auto;
        }
        .tracker-legend-label {
            font-size: 12px;
            color: #1e293b;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .tracker-legend-stop-circle {
            position: relative;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 1.5px dashed rgba(0, 0, 0, 0.45);
            background: rgba(90, 90, 90, 0.2);
            display: inline-block;
            flex: 0 0 auto;
        }
        .tracker-legend-stop-center {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(100, 100, 100, 0.5);
            border: 1px solid rgba(75, 75, 75, 0.6);
        }
        .tracker-legend-stop-point {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.5);
            display: inline-block;
            flex: 0 0 auto;
        }
        .tracker-legend-empty {
            font-size: 12px;
            color: #64748b;
        }
        .tracker-legend-status {
            font-size: 12px;
            font-weight: 600;
            color: #0f172a;
            margin-bottom: 2px;
        }
        .tracker-legend-substatus {
            font-size: 11px;
            color: #64748b;
            margin-bottom: 2px;
        }
        .performance-mode-status {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            font-weight: 600;
            color: #64748b;
            line-height: 1.3;
        }
        .performance-mode-status.active {
            color: #1d4ed8;
        }
        .performance-mode-status.hidden {
            display: none;
        }
        .live-tracker-settings-group {
            grid-column: 1 / -1;
            display: grid;
            gap: 8px;
            padding: 10px 12px;
            border: 1px solid rgba(148, 163, 184, 0.35);
            border-radius: 12px;
            background: linear-gradient(180deg, rgba(248, 250, 252, 0.98), rgba(241, 245, 249, 0.96));
        }
        .live-tracker-settings-group.disabled {
            opacity: 0.72;
        }
        .live-tracker-settings-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 10px;
        }
        .live-tracker-settings-title {
            font-size: 13px;
            font-weight: 700;
            color: #0f172a;
        }
        .live-tracker-settings-status {
            font-size: 12px;
            font-weight: 600;
            color: #334155;
        }
        .live-tracker-settings-help {
            font-size: 11px;
            color: #64748b;
            line-height: 1.4;
        }
        .live-tracker-settings-body {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 10px 12px;
        }
        .settings-overlay {
            position: fixed;
            inset: 0;
            z-index: 30;
            display: none;
            align-items: flex-start;
            justify-content: center;
            padding: 16px;
            background: rgba(15, 23, 42, 0.35);
            backdrop-filter: blur(2px);
        }
        .settings-overlay.open {
            display: flex;
        }
        .settings-card {
            width: min(760px, 100%);
            max-height: calc(100vh - 32px);
            overflow: auto;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 12px 32px rgba(0,0,0,0.22);
            padding: 16px;
        }
        .settings-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
        }
        .settings-card-header h2 {
            margin: 0;
            font-size: 18px;
        }
        .settings-card .map-controls {
            display: grid;
            gap: 10px;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            align-items: start;
        }
        .settings-card .map-controls label,
        .settings-card .map-controls input,
        .settings-card .map-controls select,
        .settings-card .map-controls button {
            width: 100%;
            max-width: none;
        }
        .settings-card .map-controls label {
            justify-content: flex-start;
        }
        .segment-drawer {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 25;
            background: rgba(255,255,255,0.97);
            border-radius: 16px 16px 0 0;
            box-shadow: 0 -8px 24px rgba(0,0,0,0.18);
            backdrop-filter: blur(4px);
            transition: height 180ms ease;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .segment-drawer.collapsed {
            height: 86px;
        }
        .segment-drawer.expanded {
            height: min(72vh, 560px);
        }
        .segment-drawer-handle {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 64px;
            padding: 10px 12px 12px;
            cursor: pointer;
            touch-action: none;
            user-select: none;
            background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(248,250,252,0.96));
            border-top: 1px solid rgba(148, 163, 184, 0.25);
        }
        .segment-drawer-grabber {
            width: 54px;
            height: 6px;
            border-radius: 999px;
            background: linear-gradient(90deg, #94a3b8, #64748b);
            box-shadow: inset 0 1px 1px rgba(255,255,255,0.5);
        }
        .segment-drawer-toggle {
            position: absolute;
            right: 12px;
            top: 12px;
            border: 1px solid #d0d7de;
            border-radius: 999px;
            width: 32px;
            height: 32px;
            background: #fff;
            color: #334155;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.12);
            z-index: 2;
        }
        .segment-nav-mode {
            position: absolute;
            left: 12px;
            top: 10px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            color: #475569;
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid #d0d7de;
            border-radius: 8px;
            padding: 2px 6px;
        }
        .segment-nav-mode select {
            border: none;
            background: transparent;
            color: #1f2937;
            font-size: 11px;
            font-weight: 600;
            outline: none;
            padding: 0 2px;
            min-height: 24px;
        }
        .segment-drawer-body {
            padding: 0 12px 12px;
            flex: 1 1 auto;
            min-height: 0;
            overflow: auto;
            display: block;
        }
        .segment-drawer.collapsed .segment-drawer-body {
            display: none;
        }
        .segment-drawer.collapsed .segment-drawer-handle {
            padding-bottom: 24px;
        }
        .segment-drawer .segment-nav {
            display: flex;
            margin-bottom: 0;
        }
        .segment-timeframe {
            font-size: 12px;
            color: #475569;
            line-height: 1.2;
            margin-top: 2px;
        }
        .segment-debug-controls {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 6px;
            width: 100%;
            margin-top: 2px;
        }
        .segment-debug-controls button {
            border: 1px solid #d0d7de;
            border-radius: 6px;
            background: #fff;
            color: #1f2937;
            font-size: 11px;
            font-weight: 600;
            min-height: 26px;
            padding: 2px 8px;
            cursor: pointer;
        }
        .segment-debug-controls button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .segment-point-counter {
            font-size: 11px;
            color: #475569;
            min-width: 80px;
            text-align: center;
            font-variant-numeric: tabular-nums;
        }
        .segment-point-time {
            width: 100%;
            text-align: center;
            font-size: 11px;
            color: #64748b;
            line-height: 1.2;
        }
        .segment-debug-status {
            width: 100%;
            min-height: 14px;
            text-align: center;
            font-size: 11px;
            color: #1d4ed8;
            line-height: 1.2;
        }
        .segment-debug-status.error {
            color: #b91c1c;
        }
        .segment-drawer.collapsed .segment-nav {
            margin-bottom: 0;
        }
        .segment-drawer.collapsed .segment-debug-controls,
        .segment-drawer.collapsed .segment-debug-status {
            display: none;
        }
        @media (max-width: 900px) {
            #settingsToggleBtn {
                top: 8px;
                right: 8px;
                padding: 8px 12px;
            }
            .tracker-legend {
                top: 8px;
                left: 8px;
                width: min(300px, calc(100vw - 16px));
            }
            .tracker-legend-header {
                justify-content: flex-start;
                gap: 10px;
            }
            .tracker-legend-toggle {
                order: -1;
            }
            .settings-card {
                padding: 12px;
            }
            .segment-drawer-handle {
                display: grid;
                grid-template-columns: minmax(120px, 1fr) minmax(120px, 1fr) minmax(44px, 1fr);
                grid-template-areas:
                    "mode nav toggle"
                    "time time time"
                    "debug debug debug"
                    "grabber grabber grabber";
                align-items: center;
                justify-items: center;
                row-gap: 6px;
                column-gap: 8px;
                min-height: 82px;
                padding: 8px 10px 10px;
            }
            .segment-nav-mode {
                position: static;
                grid-area: mode;
                justify-self: start;
                margin: 0;
            }
            .segment-drawer .segment-nav {
                grid-area: nav;
                justify-self: center;
                margin: 0;
            }
            .segment-drawer-toggle {
                position: static;
                grid-area: toggle;
                justify-self: end;
            }
            .segment-timeframe {
                grid-area: time;
                width: 100%;
                text-align: center;
                margin-top: 0;
            }
            .segment-debug-controls {
                grid-area: debug;
                margin-top: 0;
            }
            .segment-drawer-grabber {
                grid-area: grabber;
                margin-top: 0;
            }
            .segment-drawer.expanded {
                height: min(78vh, 620px);
            }
        }
    </style>

    <link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/npm/datetimepicker@latest/dist/DateTimePicker.min.css" />

</head>
<BODY>
    <div id="mapShell">
        <div id="theMap"></div>
        <div id="trackerLegend" class="tracker-legend">
            <div class="tracker-legend-header">
                <span>Map Legend</span>
                <button type="button" id="trackerLegendToggle" class="tracker-legend-toggle" onclick="toggleTrackerLegend()" aria-expanded="true">Hide</button>
            </div>
            <div id="trackerLegendBody" class="tracker-legend-body"></div>
        </div>
        <button type="button" id="settingsToggleBtn" onclick="toggleSettingsOverlay()">⚙ Settings</button>

        <div id="settingsOverlay" class="settings-overlay" onclick="closeSettingsOverlay()">
            <div class="settings-card" onclick="event.stopPropagation()">
                <div class="settings-card-header">
                    <h2>Map Settings</h2>
                    <button type="button" onclick="closeSettingsOverlay()">Close</button>
                </div>
                <div class="quick-range-row">
                    <label for="inp_quick_hours">Last X Hours
                        <input id="inp_quick_hours" type="number" oninput="quickHoursUpdated(); saveSettings();">
                    </label>
                    <label for="inp_quick_days">Last X Days
                        <input id="inp_quick_days" type="number" value="1" oninput="quickDaysUpdated(); saveSettings();">
                    </label>
                    <label for="inp_quick_days_ago">X Days Ago
                        <input id="inp_quick_days_ago" type="number" oninput="quickDaysAgoUpdated(); saveSettings();">
                    </label>
                </div>
                <div class="map-controls">
                    <label for="sel_datetimes">Date range
                        <input type="text" id="sel_datetimes" name="datetimes"/>
                    </label>
                    <label for="selTrackers">Tracker
                        <select id="selTrackers" oninput="saveSettings({ source: 'tracker-select' }); updatePerformanceModeUi(); refreshPoints()"></select>
                        <span id="performanceModeStatus" class="performance-mode-status hidden"></span>
                    </label>
                    <label for="accuracyFilterInput">Accuracy Limit
                        <input id="accuracyFilterInput" type="number" value="150" oninput="saveSettings(); refreshPoints()">
                    </label>
                    <div id="liveTrackerSettingsGroup" class="live-tracker-settings-group">
                        <div class="live-tracker-settings-header">
                            <div class="live-tracker-settings-title">Live Tracker Updates</div>
                            <div id="liveTrackerSettingsStatus" class="live-tracker-settings-status">Enabled via MQTT refresh every 30s</div>
                        </div>
                        <div class="live-tracker-settings-help">MQTT refresh turns live tracker updates on. When refresh is off, live markers stay static and scope selection is disabled.</div>
                        <div id="liveTrackerSettingsBody" class="live-tracker-settings-body">
                            <label for="manualMqttIntervalSelect">MQTT Refresh Interval
                                <select id="manualMqttIntervalSelect" oninput="saveSettings(); updateManualUpdateWatcherFromUi()">
                                    <option value="10">Every 10s</option>
                                    <option value="30" selected>Every 30s</option>
                                    <option value="60">Every 60s</option>
                                    <option value="120">Every 2m</option>
                                    <option value="300">Every 5m</option>
                                    <option value="600">Every 10m</option>
                                    <option value="0">Off</option>
                                </select>
                            </label>
                            <label for="liveTrackerScopeSelect">Live Tracker Scope
                                <select id="liveTrackerScopeSelect" oninput="saveSettings(); refreshLiveMarkers()">
                                    <option value="current">Current tracker only</option>
                                    <option value="all">All trackers in DB</option>
                                </select>
                            </label>
                        </div>
                    </div>
                    <label for="stopDetectionRadiusInput">Stop Radius (m)
                        <input id="stopDetectionRadiusInput" type="number" value="125" min="1" oninput="saveSettings(); refreshPoints()">
                    </label>
                    <label for="stopDetectionMinSecondsInput">Min Stop (s)
                        <input id="stopDetectionMinSecondsInput" type="number" value="180" min="1" oninput="saveSettings(); refreshPoints()">
                    </label>
                    <label for="stopDetectionWindowPointsInput">Window Points
                        <input id="stopDetectionWindowPointsInput" type="number" value="6" min="1" oninput="saveSettings(); refreshPoints()">
                    </label>
                    <label for="stopDetectionExitPointsInput">Exit Tolerance
                        <input id="stopDetectionExitPointsInput" type="number" value="3" min="1" oninput="saveSettings(); refreshPoints()">
                    </label>
                    <label for="stopDetectionSampleIntervalSecondsInput">Sample Every (s)
                        <input id="stopDetectionSampleIntervalSecondsInput" type="number" value="30" min="1" oninput="saveSettings(); refreshPoints()">
                    </label>
                    <label for="showIndividualPointsToggle" style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 10px; border: 1px solid #ddd; border-radius: 8px; background: #fff; min-height: 38px;">
                        <input id="showIndividualPointsToggle" type="checkbox" checked onchange="settingsState.showIndividualPoints = this.checked; saveSettings(); refreshPoints();">
                        Show points
                    </label>
                    <button type="button" id="btnSubmit" onclick="saveSettings(); closeSettingsOverlay(); loadTrackersAndPoints()">Apply</button>
                </div>
                <div id="trackerColorControls" class="tracker-color-controls"></div>
            </div>
        </div>

        <div id="segmentDrawer" class="segment-drawer collapsed">
            <div id="segmentDrawerHandle" class="segment-drawer-handle">
                <label class="segment-nav-mode" for="segmentNavigationModeSelect" onpointerdown="event.stopPropagation()" onpointerup="event.stopPropagation()" onclick="event.stopPropagation()">
                    Jump:
                    <select id="segmentNavigationModeSelect" onchange="onSegmentNavigationModeChanged()">
                        <option value="travel">Travel</option>
                        <option value="stops">Stops</option>
                        <option value="both">Both</option>
                    </select>
                </label>
                <div class="segment-drawer-grabber"></div>
                <div id="segmentNavigator" class="segment-nav" style="display: none;">
                    <button type="button" id="prevTravelSegmentBtn" onclick="event.stopPropagation(); navigateTravelSegment(-1)" onpointerdown="event.stopPropagation()" onpointerup="event.stopPropagation()">←</button>
                    <span id="travelSegmentCounter">0 / 0</span>
                    <button type="button" id="nextTravelSegmentBtn" onclick="event.stopPropagation(); navigateTravelSegment(1)" onpointerdown="event.stopPropagation()" onpointerup="event.stopPropagation()">→</button>
                </div>
                <div id="segmentTimeframe" class="segment-timeframe">No segment selected</div>
                <div id="segmentDebugControls" class="segment-debug-controls" onpointerdown="event.stopPropagation()" onpointerup="event.stopPropagation()" onclick="event.stopPropagation()">
                    <button type="button" id="prevSegmentPointBtn" onclick="navigateSegmentPoint(-1)">Point ←</button>
                    <span id="segmentPointCounter" class="segment-point-counter">Point 0 / 0</span>
                    <button type="button" id="nextSegmentPointBtn" onclick="navigateSegmentPoint(1)">Point →</button>
                    <button type="button" id="copySegmentPointBtn" onclick="copyCurrentSegmentDebugInfo('point')">Copy Point</button>
                    <button type="button" id="copySegmentStopBtn" onclick="copyCurrentSegmentDebugInfo('stop')">Copy Stop</button>
                    <button type="button" id="copySegmentDebugBtn" onclick="copyCurrentSegmentDebugInfo('segment')">Copy Segment</button>
                    <div id="segmentPointTimestamp" class="segment-point-time">Select a segment</div>
                </div>
                <div id="segmentDebugStatus" class="segment-debug-status" aria-live="polite"></div>
                <button type="button" id="segmentDrawerToggleButton" class="segment-drawer-toggle" onclick="event.stopPropagation(); toggleSegmentDrawerFromButton()" onpointerdown="event.stopPropagation()" onpointerup="event.stopPropagation()" aria-label="Expand segments drawer" aria-expanded="false" title="Expand segments drawer">▴</button>
            </div>
            <div class="segment-drawer-body">
                <div id="segmentList"></div>
            </div>
        </div>
    </div>
</BODY>
</HTML>