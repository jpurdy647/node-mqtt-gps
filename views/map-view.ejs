                overlay.classList.add('open');
            }
            if (map && map.invalidateSize) {
                setTimeout(() => map.invalidateSize(), 0);
            }
        }

        function closeSettingsOverlay() {
            const overlay = document.getElementById('settingsOverlay');
            if (overlay) {
                overlay.classList.remove('open');
            }
            if (map && map.invalidateSize) {
                setTimeout(() => map.invalidateSize(), 0);
            }
        }

