<HTML>
<head>
    <title>Map View</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />    

    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    <script>

        function calculateDistance(lat1, lon1, lat2, lon2, unit = "km") {
            const R = 6371; // Radius of the Earth in kilometers
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;

            const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                        Math.sin(dLon / 2) * Math.sin(dLon / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

            let distance = R * c; // Distance in kilometers

            // Convert to other units if needed
            if (unit === 'miles') distance = distance * 0.621371;
            if (unit === 'meters') distance = distance * 1000;

            return distance;
        }


        //load trackers
        //var tracker_ids = ;

        // Collect points and format into an efficient map for recall later

        var circleIcon;
        var points = new Map();
        var trackers = [];// ;
        var allTrackers = [];
        var trackerColors = {};
        var trackerColorPalette = ['#3388ff', '#ff3b30', '#34a853', '#8e44ad', '#f39c12', '#1abc9c', '#e67e22', '#2c3e50'];
        var DTP;
        var map;
        var linesGroup;
        var transitionGroup;
        var liveMarkersGroup;
        var segmentLayers = [];
        var renderedPointMarkersById = new Map();
        var highlightedSegment = null;
        var detectedSegments = [];
        var showIndividualPoints = true;
        var selectedSegmentId = null;
        var segmentNavigationMode = 'travel';
        var manualUpdatesClientId = null;
        var manualUpdatesKeepAliveTimer = null;
        var manualUpdatesKeepAliveSeconds = 20;
        var stopDetectionRadiusMeters = 125;
        var stopDetectionMinPoints = 4;
        var stopDetectionMinSeconds = 180;
        var stopDetectionWindowPoints = 6;
        var stopDetectionExitPoints = 3;
        var stopDetectionSampleIntervalSeconds = 30;

        const Transition = {
            STOP_TO_MOVING: "STOP_TO_MOVING",
            MOVING_TO_STOP: "MOVING_TO_STOP",
        }

        const Mode = {
            MOVING: "MOVING",
            STOP: "STOP",
        }

        function getTrackerColor(trackerId) {
            if (!trackerId) {
                return '#3388ff';
            }
            if (!trackerColors[trackerId]) {
                const paletteIndex = trackers.indexOf(trackerId);
                trackerColors[trackerId] = trackerColorPalette[paletteIndex % trackerColorPalette.length] || '#3388ff';
            }
            return trackerColors[trackerId];
        }

        function getTrackerShortId(trackerId) {
            if (!trackerId) {
                return '--';
            }
            const compact = String(trackerId).replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
            if (!compact.length) {
                return '--';
            }
            return compact.slice(0, 2);
        }

        function getCurrentSelectedTrackerId() {
            const trackerSelect = document.getElementById('selTrackers');
            return trackerSelect && trackerSelect.value ? trackerSelect.value : 'all_trackers';
        }

        function isAutoMqttUpdateEnabled() {
            return getManualMqttIntervalSeconds() > 0;
        }

        function shouldShowAllTrackersLiveOverlay() {
            const selectedTrackerId = getCurrentSelectedTrackerId();
            return isAutoMqttUpdateEnabled() && selectedTrackerId && selectedTrackerId !== 'all_trackers';
        }

        function createLiveTrackerIcon(trackerId, color) {
            const shortId = getTrackerShortId(trackerId);
            const safeColor = color || '#3388ff';
            const svg = `
                <svg viewBox="0 0 72 90" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <defs>
                        <filter id="live-shadow-${shortId}" x="-50%" y="-50%" width="200%" height="200%">
                            <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#0f172a" flood-opacity="0.28" />
                        </filter>
                    </defs>
                    <path d="M36 2C19.4 2 6 15.4 6 32c0 21.2 25.8 48.6 29.2 52.1a1 1 0 0 0 1.6 0C40.2 80.6 66 53.2 66 32 66 15.4 52.6 2 36 2z" fill="${safeColor}" filter="url(#live-shadow-${shortId})" />
                    <circle cx="36" cy="32" r="17" fill="#ffffff" fill-opacity="0.96" />
                    <text x="36" y="37" text-anchor="middle" font-size="13" font-family="Arial, sans-serif" font-weight="700" fill="#0f172a">${shortId}</text>
                </svg>
            `;

            return L.divIcon({
                className: 'live-tracker-marker',
                html: `<div class="live-tracker-svg-wrap">${svg}</div>`,
                iconSize: [36, 45],
                iconAnchor: [18, 44],
                popupAnchor: [0, -40],
            });
        }

        function toLatestPointByTracker(pointsMap) {
            const latestPoints = new Map();
            pointsMap.forEach((trackerPoints, trackerId) => {
                const ordered = Array.from(trackerPoints.values()).sort((a, b) => new Date(a.time) - new Date(b.time));
                if (ordered.length) {
                    latestPoints.set(trackerId, ordered[ordered.length - 1]);
                }
            });
            return latestPoints;
        }

        function renderLiveMarkersFromPointsMap(pointsMap) {
            if (!liveMarkersGroup) {
                return;
            }

            liveMarkersGroup.clearLayers();
            const latestPoints = toLatestPointByTracker(pointsMap || new Map());
            latestPoints.forEach((point, trackerId) => {
                const color = getTrackerColor(trackerId);
                const marker = L.marker([point.latitude, point.longitude], {
                    icon: createLiveTrackerIcon(trackerId, color),
                    zIndexOffset: 1000,
                }).addTo(liveMarkersGroup);

                marker.bindPopup(`<strong>${trackerId}</strong><br>Live at ${new Date(point.time).toLocaleString()}`);
            });
        }

        function getActiveTimeRangeSeconds() {
            const picker = $('input[name="datetimes"]').data('daterangepicker');
            return {
                secondsStart: picker.startDate.toDate().getTime() / 1000,
                secondsEnd: picker.endDate.toDate().getTime() / 1000,
            };
        }

        function buildTrackerPointMap(pointsArr, sampleByInterval) {
            const parsedPoints = new Map();
            const safePoints = Array.isArray(pointsArr) ? pointsArr : [];
            safePoints.forEach((tp) => {
                const trackerId = tp && (tp.tracker_id || tp.tid || tp.id);
                const pointItems = Array.isArray(tp && tp.points) ? tp.points : [];
                const filteredPoints = pointItems.reduce((accum, p) => {
                    if (p && p.gps_accuracy <= (document.getElementById('accuracyFilterInput').value || 150)) {
                        p.localTime = new Date(p.time).toLocaleString();
                        accum.set(p.puid, p);
                    }
                    return accum;
                }, new Map());

                const sourcePoints = Array.from(filteredPoints.values());
                const finalPoints = sampleByInterval
                    ? samplePointsByTime(sourcePoints, getStopDetectionSampleIntervalSeconds())
                    : sourcePoints;
                const pointMap = new Map(finalPoints.map((point) => [point.puid, point]));
                if (trackerId) {
                    parsedPoints.set(trackerId, pointMap);
                }
            });
            return parsedPoints;
        }

        function refreshLiveMarkers() {
            if (!shouldShowAllTrackersLiveOverlay()) {
                renderLiveMarkersFromPointsMap(points);
                return;
            }

            const { secondsStart, secondsEnd } = getActiveTimeRangeSeconds();
            fetch(`/points?tracker_id=all_trackers&seconds_start=${encodeURIComponent(secondsStart)}&seconds_end=${encodeURIComponent(secondsEnd)}`)
                .then((response) => response.json())
                .then((response) => {
                    const trackerGroups = Array.isArray(response.trackers) ? response.trackers : [];
                    const allTrackerPointsMap = buildTrackerPointMap(trackerGroups, false);
                    renderLiveMarkersFromPointsMap(allTrackerPointsMap);
                })
                .catch((err) => {
                    console.warn('Unable to load all-tracker live markers', err);
                    renderLiveMarkersFromPointsMap(points);
                });
        }

        function saveSettings() {
            try {
                const selectedTrackerId = document.getElementById('selTrackers').value || '';
                const picker = $('input[name="datetimes"]').data('daterangepicker');
                const settings = {
                    trackerId: selectedTrackerId,
                    startDate: picker && picker.startDate ? picker.startDate.toISOString() : '',
                    endDate: picker && picker.endDate ? picker.endDate.toISOString() : '',
                    manualMqttIntervalSeconds: document.getElementById('manualMqttIntervalSelect').value,
                    accuracyLimit: document.getElementById('accuracyFilterInput').value,
                    stopDetectionRadiusMeters: document.getElementById('stopDetectionRadiusInput').value,
                    stopDetectionMinSeconds: document.getElementById('stopDetectionMinSecondsInput').value,
                    stopDetectionWindowPoints: document.getElementById('stopDetectionWindowPointsInput').value,
                    stopDetectionExitPoints: document.getElementById('stopDetectionExitPointsInput').value,
                    stopDetectionSampleIntervalSeconds: document.getElementById('stopDetectionSampleIntervalSecondsInput').value,
                    segmentNavigationMode: document.getElementById('segmentNavigationModeSelect').value,
                    showIndividualPoints,
                    trackerColors,
                };

                const payload = JSON.stringify(settings);

                const cookieValue = 'mapViewSettings=' + encodeURIComponent(payload) + '; path=/; max-age=' + (60 * 60 * 24 * 30) + '; SameSite=Lax';

                try {
                    document.cookie = cookieValue;
                } catch (cookieErr) {
                    console.warn('Unable to write cookie, falling back to localStorage', cookieErr);
                }

                try {
                    if (window.localStorage) {
                        window.localStorage.setItem('mapViewSettings', payload);
                    }
                } catch (storageErr) {
                    console.warn('Unable to store settings in localStorage', storageErr);
                }
            } catch (err) {
                console.warn('Unable to save map settings', err);
            }
        }

        function loadSettings() {
            try {
                if (window.localStorage && window.localStorage.getItem('mapViewSettings')) {
                    return JSON.parse(window.localStorage.getItem('mapViewSettings'));
                }
            } catch (err) {
                console.warn('Unable to load saved tracker settings from localStorage', err);
            }

            try {
                const cookieValue = document.cookie.split('; ').find((entry) => entry.startsWith('mapViewSettings='));
                if (cookieValue) {
                    const storedValue = decodeURIComponent(cookieValue.split('=').slice(1).join('='));
                    return JSON.parse(storedValue);
                }
            } catch (err) {
                console.warn('Unable to parse saved tracker settings from cookie', err);
            }

            return null;
        }

        function applySettingsToForm(settings) {
            if (!settings) {
                return;
            }
            showIndividualPoints = settings.showIndividualPoints !== false;
            if (settings.trackerColors) {
                trackerColors = { ...settings.trackerColors };
            }
            const trackerSelect = document.getElementById('selTrackers');
            if (trackerSelect && settings.trackerId !== undefined) {
                const requestedTracker = settings.trackerId || 'all_trackers';
                const offeredValues = Array.from(trackerSelect.options).map((option) => option.value);
                if (offeredValues.includes(requestedTracker)) {
                    trackerSelect.value = requestedTracker;
                } else if (offeredValues.includes('all_trackers')) {
                    trackerSelect.value = 'all_trackers';
                }
            }
            const accuracyInput = document.getElementById('accuracyFilterInput');
            if (accuracyInput && settings.accuracyLimit !== undefined) {
                accuracyInput.value = settings.accuracyLimit;
            }
            const radiusInput = document.getElementById('stopDetectionRadiusInput');
            if (radiusInput && settings.stopDetectionRadiusMeters !== undefined) {
                radiusInput.value = settings.stopDetectionRadiusMeters;
            }
            const minSecondsInput = document.getElementById('stopDetectionMinSecondsInput');
            if (minSecondsInput && settings.stopDetectionMinSeconds !== undefined) {
                minSecondsInput.value = settings.stopDetectionMinSeconds;
            }
            const windowPointsInput = document.getElementById('stopDetectionWindowPointsInput');
            if (windowPointsInput && settings.stopDetectionWindowPoints !== undefined) {
                windowPointsInput.value = settings.stopDetectionWindowPoints;
            }
            const exitPointsInput = document.getElementById('stopDetectionExitPointsInput');
            if (exitPointsInput && settings.stopDetectionExitPoints !== undefined) {
                exitPointsInput.value = settings.stopDetectionExitPoints;
            }
            const sampleIntervalInput = document.getElementById('stopDetectionSampleIntervalSecondsInput');
            if (sampleIntervalInput && settings.stopDetectionSampleIntervalSeconds !== undefined) {
                sampleIntervalInput.value = settings.stopDetectionSampleIntervalSeconds;
            }
            const showPointsToggle = document.getElementById('showIndividualPointsToggle');
            if (showPointsToggle && settings.showIndividualPoints !== undefined) {
                showPointsToggle.checked = settings.showIndividualPoints;
                showIndividualPoints = settings.showIndividualPoints;
            }
            const manualIntervalSelect = document.getElementById('manualMqttIntervalSelect');
            if (manualIntervalSelect && settings.manualMqttIntervalSeconds !== undefined) {
                manualIntervalSelect.value = settings.manualMqttIntervalSeconds;
            }
            const segmentNavigationModeSelect = document.getElementById('segmentNavigationModeSelect');
            if (segmentNavigationModeSelect && settings.segmentNavigationMode !== undefined) {
                segmentNavigationModeSelect.value = settings.segmentNavigationMode;
                segmentNavigationMode = segmentNavigationModeSelect.value || 'travel';
            }
            const picker = $('input[name="datetimes"]').data('daterangepicker');
            if (picker && settings.startDate && settings.endDate) {
                const startMoment = moment(settings.startDate);
                const endMoment = moment(settings.endDate);
                if (startMoment.isValid()) {
                    picker.setStartDate(startMoment);
                }
                if (endMoment.isValid()) {
                    picker.setEndDate(endMoment);
                }
            }
        }

        function clearSegmentHighlight() {
            segmentLayers.forEach((layer) => {
                if (layer && layer.setStyle) {
                    layer.setStyle({ color: '#3388ff', weight: 2, opacity: 0.7 });
                }
            });

            detectedSegments.forEach((segment) => {
                if (segment && segment.stopRadiusCircle && segment.stopRadiusCircle.setStyle) {
                    segment.stopRadiusCircle.setStyle({
                        color: 'rgba(0, 0, 0, 0.45)',
                        weight: 1.2,
                        dashArray: '5,4',
                        fillColor: 'rgba(90, 90, 90, 0.2)',
                        fillOpacity: 0.35,
                    });
                }
                if (segment && segment.stopCenterDot && segment.stopCenterDot.setStyle) {
                    segment.stopCenterDot.setStyle({
                        radius: 5,
                        color: 'rgba(75, 75, 75, 0.55)',
                        fillColor: 'rgba(100, 100, 100, 0.32)',
                        fillOpacity: 0.8,
                        weight: 1,
                    });
                }
            });

            renderedPointMarkersById.forEach((marker) => {
                if (!marker || !marker.setIcon) {
                    return;
                }

                const baseColor = marker._jpBaseColor || '#3388ff';
                const course = Number.isFinite(marker._jpCourse) ? marker._jpCourse : 0;
                marker.setIcon(L.divIcon({
                    className: 'jpico',
                    html: "<div style='background-color:" + baseColor + ";' class='marker-pin'></div><i style='color:" + baseColor + "; transform: rotate(" + course + "deg)' class='fa-regular fa-circle-up'></i>",
                    iconSize: [10, 10],
                    iconAnchor: [5, 5],
                    popupAnchor: [-3, -76],
                }));
            });
            highlightedSegment = null;
        }

        function getDrawerOcclusionHeight() {
            const drawer = document.getElementById('segmentDrawer');
            if (!drawer || !drawer.classList.contains('expanded')) {
                return 0;
            }
            const bounds = drawer.getBoundingClientRect();
            return Math.max(0, Math.round(bounds.height || 0));
        }

        function fitBoundsVisible(bounds, options = {}) {
            if (!map || !bounds) {
                return;
            }

            const drawerOcclusion = getDrawerOcclusionHeight();
            const basePadding = 40;
            const mergedOptions = {
                ...options,
                paddingTopLeft: options.paddingTopLeft || [basePadding, basePadding],
                paddingBottomRight: options.paddingBottomRight || [basePadding, basePadding + drawerOcclusion],
            };

            map.fitBounds(bounds, mergedOptions);
        }

        function setViewVisible(latLng, zoomLevel) {
            if (!map) {
                return;
            }

            map.setView(latLng, zoomLevel);
            const drawerOcclusion = getDrawerOcclusionHeight();
            if (drawerOcclusion > 0) {
                map.panBy([0, -Math.round(drawerOcclusion / 2)], { animate: false });
            }
        }

        function highlightSegment(segmentId) {
            clearSegmentHighlight();
            const segment = detectedSegments.find((entry) => entry.id === segmentId);
            if (!segment) {
                return;
            }
            highlightedSegment = segmentId;
            selectedSegmentId = segmentId;
            if (segment.polyline) {
                segment.polyline.setStyle({ color: '#ff3b30', weight: 5, opacity: 1 });
                if (segment.polyline.getBounds) {
                    fitBoundsVisible(segment.polyline.getBounds());
                }
            }
            if (segment.points) {
                segment.points.forEach((marker) => {
                    if (marker && marker.setStyle) {
                        marker.setStyle({ radius: 7, color: '#ff3b30', fillColor: '#ff3b30' });
                    }
                });
            }

            if (segment.type === 'stop') {
                if (segment.stopRadiusCircle && segment.stopRadiusCircle.setStyle) {
                    segment.stopRadiusCircle.setStyle({
                        color: '#ff3b30',
                        weight: 2.4,
                        dashArray: null,
                        fillColor: 'rgba(255, 59, 48, 0.18)',
                        fillOpacity: 0.42,
                    });
                }

                if (segment.stopCenterDot && segment.stopCenterDot.setStyle) {
                    segment.stopCenterDot.setStyle({
                        radius: 6,
                        color: '#ff3b30',
                        fillColor: '#ff3b30',
                        fillOpacity: 0.95,
                        weight: 1.5,
                    });
                }

                if (segment.stopRadiusCircle && segment.stopRadiusCircle.getBounds && map) {
                    fitBoundsVisible(segment.stopRadiusCircle.getBounds(), {
                        paddingTopLeft: [50, 50],
                        paddingBottomRight: [50, 50 + getDrawerOcclusionHeight()],
                    });
                } else if (segment.center && map && map.setView) {
                    setViewVisible([segment.center.latitude, segment.center.longitude], Math.max(map.getZoom(), 16));
                }

                const stopRawPoints = Array.isArray(segment.rawPoints) ? segment.rawPoints : [];
                stopRawPoints.forEach((stopPoint) => {
                    if (!stopPoint || !stopPoint.puid) {
                        return;
                    }

                    const marker = renderedPointMarkersById.get(stopPoint.puid);
                    if (!marker || !marker.setIcon) {
                        return;
                    }

                    const course = Number.isFinite(marker._jpCourse) ? marker._jpCourse : 0;
                    marker.setIcon(L.divIcon({
                        className: 'jpico',
                        html: "<div style='background-color:#ff3b30;' class='marker-pin'></div><i style='color:#ff3b30; transform: rotate(" + course + "deg)' class='fa-regular fa-circle-up'></i>",
                        iconSize: [10, 10],
                        iconAnchor: [5, 5],
                        popupAnchor: [-3, -76],
                    }));
                });
            }
            renderSegmentList();
        }

        function updateSegmentNavigator() {
            const navigator = document.getElementById('segmentNavigator');
            const counter = document.getElementById('travelSegmentCounter');
            const timeframe = document.getElementById('segmentTimeframe');
            const prevButton = document.getElementById('prevTravelSegmentBtn');
            const nextButton = document.getElementById('nextTravelSegmentBtn');
            if (!navigator || !counter || !prevButton || !nextButton || !timeframe) {
                return;
            }

            const filteredSegments = getNavigableSegments();
            if (!filteredSegments.length) {
                navigator.style.display = 'none';
                timeframe.textContent = 'No segment selected';
                return;
            }

            navigator.style.display = 'flex';
            const currentIndex = filteredSegments.findIndex((segment) => segment.id === selectedSegmentId);
            const activeIndex = currentIndex >= 0 ? currentIndex : 0;
            const activeSegment = filteredSegments[activeIndex];
            const hasTimes = activeSegment && activeSegment.startTime && activeSegment.endTime;
            if (hasTimes) {
                const startTime = new Date(activeSegment.startTime).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
                const endTime = new Date(activeSegment.endTime).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
                timeframe.textContent = `${activeSegment.type === 'stop' ? 'Stop' : 'Travel'} • ${startTime} to ${endTime}`;
            } else {
                timeframe.textContent = 'Time range unavailable';
            }
            counter.textContent = `${activeIndex + 1} / ${filteredSegments.length}`;
            prevButton.disabled = activeIndex <= 0;
            nextButton.disabled = activeIndex >= filteredSegments.length - 1;
        }

        function getSegmentNavigationMode() {
            const modeSelect = document.getElementById('segmentNavigationModeSelect');
            const selectedMode = modeSelect && modeSelect.value ? modeSelect.value : segmentNavigationMode;
            if (selectedMode === 'stops' || selectedMode === 'both') {
                return selectedMode;
            }
            return 'travel';
        }

        function getNavigableSegments() {
            const mode = getSegmentNavigationMode();
            const timedSegments = detectedSegments.filter((segment) =>
                (segment.type === 'travel' || segment.type === 'stop') &&
                Number.isFinite(segment.startTime) &&
                Number.isFinite(segment.endTime)
            );

            if (mode === 'travel') {
                return timedSegments.filter((segment) => segment.type === 'travel');
            }
            if (mode === 'stops') {
                return timedSegments.filter((segment) => segment.type === 'stop');
            }
            return timedSegments;
        }

        function onSegmentNavigationModeChanged() {
            segmentNavigationMode = getSegmentNavigationMode();
            saveSettings();
            updateSegmentNavigator();
        }

        function navigateTravelSegment(direction) {
            const filteredSegments = getNavigableSegments();
            if (!filteredSegments.length) {
                return;
            }

            const currentIndex = filteredSegments.findIndex((segment) => segment.id === selectedSegmentId);
            let targetIndex = currentIndex >= 0 ? currentIndex + direction : (direction > 0 ? 0 : filteredSegments.length - 1);
            if (targetIndex < 0 || targetIndex >= filteredSegments.length) {
                return;
            }

            highlightSegment(filteredSegments[targetIndex].id);
        }

        function renderSegmentList() {
            const container = document.getElementById("segmentList");
            if (!container) {
                return;
            }
            if (!detectedSegments.length) {
                container.innerHTML = "<div class='segment-empty'>No segments detected yet.</div>";
                updateSegmentNavigator();
                return;
            }

            const groupedSegments = detectedSegments.reduce((accumulator, segment) => {
                const trackerId = segment.trackerId || 'Unassigned';
                if (!accumulator[trackerId]) {
                    accumulator[trackerId] = [];
                }
                accumulator[trackerId].push(segment);
                return accumulator;
            }, {});

            container.innerHTML = Object.entries(groupedSegments).map(([trackerId, segments]) => {
                const trackerLabel = trackerId === 'Unassigned' ? 'Unassigned' : trackerId;
                const trackerColor = getTrackerColor(trackerId);
                return `<div style='margin-bottom: 12px;'>
                    <div style='font-weight: 600; color: ${trackerColor}; margin-bottom: 6px;'>${trackerLabel}</div>
                    ${segments.map((segment) => {
                        const isSelected = selectedSegmentId === segment.id;
                        const title = segment.type === 'stop' ? `Stop • ${segment.label}` : `Travel • ${segment.label}`;
                        const count = Number.isFinite(segment.pointCount)
                            ? segment.pointCount
                            : (Array.isArray(segment.rawPoints) ? segment.rawPoints.length : 0);
                        const pointCountText = `<div style='font-size: 11px; color: #64748b; margin-top: 2px;'>${count} point${count === 1 ? '' : 's'}</div>`;
                        const timeText = segment.startTime && segment.endTime
                            ? `<div style='font-size: 11px; color: #666; margin-top: 4px;'>${new Date(segment.startTime).toLocaleString()} → ${new Date(segment.endTime).toLocaleString()}</div>`
                            : '';
                        const selectedStyle = isSelected ? "border-color: #3388ff; background: #eef6ff; box-shadow: inset 0 0 0 1px #3388ff;" : "";
                        return `<button class='segment-item ${isSelected ? 'selected' : ''}' onclick='highlightSegment("${segment.id}")' style='display: block; width: 100%; text-align: left; margin-bottom: 8px; padding: 8px; border: 1px solid #ddd; border-radius: 4px; background: #fff; ${selectedStyle}'>${title}${pointCountText}${timeText}</button>`;
                    }).join('')}
                </div>`;
            }).join('');
            updateSegmentNavigator();
        }

        function showPoints(){
            linesGroup.clearLayers(); // Clear existing lines from the map
            transitionGroup.clearLayers(); // Clear existing transition markers from the map
            renderedPointMarkersById = new Map();
            segmentLayers = [];
            detectedSegments = [];
            clearSegmentHighlight();

            if (points.size === 0) {
                renderSegmentList();
                return; // No points to display
            }

            processSegments2(points);
            const stopPointIds = new Set();
            const stopRadiusMeters = getStopDetectionRadiusMeters();

            detectedSegments.forEach((segment) => {
                if (segment.type !== 'stop') {
                    return;
                }

                const stopRawPoints = Array.isArray(segment.rawPoints) ? segment.rawPoints : [];
                stopRawPoints.forEach((stopPoint) => {
                    if (stopPoint && stopPoint.puid) {
                        stopPointIds.add(stopPoint.puid);
                    }
                });

                const center = segment.center;
                if (!center) {
                    return;
                }

                const stopCircle = L.circle([center.latitude, center.longitude], {
                    radius: stopRadiusMeters,
                    color: 'rgba(0, 0, 0, 0.45)',
                    weight: 1.2,
                    dashArray: '5,4',
                    fillColor: 'rgba(90, 90, 90, 0.2)',
                    fillOpacity: 0.35,
                }).addTo(transitionGroup);
                segmentLayers.push(stopCircle);
                segment.stopRadiusCircle = stopCircle;

                const centerDot = L.circleMarker([center.latitude, center.longitude], {
                    radius: 5,
                    color: 'rgba(75, 75, 75, 0.55)',
                    fillColor: 'rgba(100, 100, 100, 0.32)',
                    fillOpacity: 0.8,
                    weight: 1,
                }).addTo(transitionGroup);
                segmentLayers.push(centerDot);
                segment.stopCenterDot = centerDot;
            });

            points.forEach((trackerPoints, trackerId) => {
                const color = getTrackerColor(trackerId);
                const trackerLinePoints = Array.from(trackerPoints.values()).filter((p) => {
                    if (showIndividualPoints) {
                        return true;
                    }
                    return !stopPointIds.has(p.puid);
                });

                var polyline = null;
                if (trackerLinePoints.length >= 2) {
                    polyline = L.polyline(trackerLinePoints.map((p) => [p.latitude, p.longitude]), { color, weight: 2, opacity: 0.8 }).addTo(linesGroup);
                    segmentLayers.push(polyline);
                    if (polyline.getBounds) {
                        fitBoundsVisible(polyline.getBounds(), {
                            paddingTopLeft: [20, 20],
                            paddingBottomRight: [20, 20 + getDrawerOcclusionHeight()],
                        });
                    }
                }

                detectedSegments.push({
                    id: `track-${detectedSegments.length + 1}`,
                    trackerId: trackerId,
                    type: 'travel',
                    label: trackerId || 'Tracker',
                    pointCount: trackerLinePoints.length,
                    points: [],
                    polyline: polyline,
                });
            });

            if (showIndividualPoints) {
                points.forEach((trackerPoints, trackerId) => {
                    const color = getTrackerColor(trackerId);
                    trackerPoints.forEach(function(point) {
                        const isStopPoint = stopPointIds.has(point.puid);
                        const pointColor = isStopPoint ? 'rgba(0, 0, 0, 0.5)' : color;
                        var pointIcon = L.divIcon({
                            className: 'jpico',
                            html: "<div style='background-color:" + pointColor + ";' class='marker-pin'></div><i style='color:" + pointColor + "; transform: rotate(" + point.course + "deg)' class='fa-regular fa-circle-up'></i>",
                            iconSize: [10, 10],
                            iconAnchor: [5, 5],
                            popupAnchor: [-3, -76],
                        });

                        var marker = L.marker([point.latitude, point.longitude], {icon: pointIcon}).addTo(linesGroup);
                        marker._jpBaseColor = pointColor;
                        marker._jpCourse = Number.isFinite(point.course) ? point.course : 0;
                        renderedPointMarkersById.set(point.puid, marker);
                        marker.on('click', function(event){
                            var accuracyCircle = L.circle([point.latitude, point.longitude], {
                                color: 'blue',
                                fillColor: '#f03',
                                fillOpacity: 0.5,
                                radius: point.gps_accuracy
                            }).addTo(map);
                            var popup = L.popup([point.latitude, point.longitude], {content: "<p>" + loadPopupContentforPoint(point.puid) + "</p>"});
                            popup.on('remove', function() {
                                accuracyCircle.remove();
                            });
                            popup.openOn(map);
                            loadPopupContentforPoint(point.puid);
                        });

                    });
                });
            }

            refreshLiveMarkers();

            renderSegmentList();
        }

        function loadPopupContentforPoint(pointPIUD) {
            let point;
            points.forEach((trackerPoints) => {
                if (trackerPoints.has(pointPIUD)) {
                    point = trackerPoints.get(pointPIUD);
                }
            });
            if (!point) {
                return "Point not found";
            }   
            var result = "";

            result += "<strong>" + new Date(point.time).toLocaleString() + "</strong><br>";
            result += "Latitude: " + point.latitude + "<br>";
            result += "Longitude: " + point.longitude + "<br>";
            result += "Velocity: " + point.velocity + "<br>";
            result += "Course: " + point.course + " degrees<br>";
            result += "Altitude: " + point.altitude + "<br>";
            result += "Accuracy: " + point.gps_accuracy + "<br>";
            result += "Battery: " + point.battery + "%<br>";
            result += "Acceleration: " + point.acceleration + "<br>";
            result += "Mode: " + point.mode + "<br>";
            return result;

        }

        function loadTrackersAndPoints() {
            saveSettings();
            const xhttp = new XMLHttpRequest();
            xhttp.onload = function() {
                try {
                    const response = JSON.parse(this.responseText);
                    const trackerGroups = Array.isArray(response.trackers) ? response.trackers : [];
                    processPoints(trackerGroups);
                    if (Array.isArray(response.tracker_ids)) {
                        processTrackers(response.tracker_ids);
                    }
                    showPoints();
                } catch (err) {
                    console.error("Failed to load points", err);
                    points = new Map();
                    showPoints();
                }
            }
            // Get the selected tracker ID from the query or the dropdown
            var selectedTrackerId = document.getElementById("selTrackers").value || new URLSearchParams(window.location.search).get('tracker_id') || "";
            xhttp.open("GET", "/points?tracker_id=" + encodeURIComponent(selectedTrackerId) + "&seconds_start=" + $('input[name="datetimes"]').data('daterangepicker').startDate.toDate().getTime()/1000 + "&seconds_end=" + $('input[name="datetimes"]').data('daterangepicker').endDate.toDate().getTime()/1000, true);
            xhttp.send();
        }

    
        function processPoints(pointsArr) {
            points = buildTrackerPointMap(pointsArr, true);
        }

        function getStopDetectionRadiusMeters() {
            const input = document.getElementById("stopDetectionRadiusInput");
            const value = parseFloat(input && input.value);
            return Number.isFinite(value) && value > 0 ? value : stopDetectionRadiusMeters;
        }

        function getStopDetectionMinSeconds() {
            const input = document.getElementById("stopDetectionMinSecondsInput");
            const value = parseInt(input && input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : stopDetectionMinSeconds;
        }

        function getStopDetectionWindowPoints() {
            const input = document.getElementById("stopDetectionWindowPointsInput");
            const value = parseInt(input && input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : stopDetectionWindowPoints;
        }

        function getStopDetectionExitPoints() {
            const input = document.getElementById("stopDetectionExitPointsInput");
            const value = parseInt(input && input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : stopDetectionExitPoints;
        }

        function getStopDetectionSampleIntervalSeconds() {
            const input = document.getElementById("stopDetectionSampleIntervalSecondsInput");
            const value = parseInt(input && input.value, 10);
            return Number.isFinite(value) && value > 0 ? value : stopDetectionSampleIntervalSeconds;
        }

        function samplePointsByTime(pointsList, intervalSeconds) {
            const sortedPoints = Array.from(pointsList).sort((a, b) => new Date(a.time) - new Date(b.time));
            if (sortedPoints.length <= 1 || intervalSeconds <= 0) {
                return sortedPoints;
            }

            const sampledPoints = [];
            let lastAcceptedTime = null;
            sortedPoints.forEach((point) => {
                const pointTime = new Date(point.time).getTime();
                if (lastAcceptedTime === null || (pointTime - lastAcceptedTime) >= intervalSeconds * 1000) {
                    sampledPoints.push(point);
                    lastAcceptedTime = pointTime;
                }
            });

            return sampledPoints;
        }

        function getCentroid(points) {
            if (!points.length) {
                return null;
            }
            const centerLat = points.reduce((sum, point) => sum + point.latitude, 0) / points.length;
            const centerLon = points.reduce((sum, point) => sum + point.longitude, 0) / points.length;
            return { latitude: centerLat, longitude: centerLon };
        }

        function processSegments2(pointsMap){
            const radiusMeters = getStopDetectionRadiusMeters();
            const minPoints = stopDetectionMinPoints;
            const minSeconds = getStopDetectionMinSeconds();
            const windowPoints = getStopDetectionWindowPoints();
            const exitPoints = getStopDetectionExitPoints();
            const sampleIntervalSeconds = getStopDetectionSampleIntervalSeconds();

            let warnedAboutOutOfOrder = false;

            const warnAboutOutOfOrder = (trackerId, orderedPoints) => {
                if (warnedAboutOutOfOrder) {
                    return;
                }

                const timestamps = orderedPoints.map((point) => new Date(point.time).getTime());
                for (let index = 1; index < timestamps.length; index++) {
                    if (timestamps[index] < timestamps[index - 1]) {
                        warnedAboutOutOfOrder = true;
                        console.warn(`Timestamps are out of order for tracker ${trackerId}.`);
                        window.alert(`Warning: timestamps are out of order for tracker ${trackerId}. Segment timing may be inaccurate.`);
                        break;
                    }
                }
            };

            pointsMap.forEach((trackerPoints, trackerId) => {
                const pointsArr = samplePointsByTime(trackerPoints.values(), sampleIntervalSeconds);
                if (pointsArr.length < minPoints) {
                    return;
                }

                warnAboutOutOfOrder(trackerId, pointsArr);

                const initialWindowSize = Math.min(windowPoints, pointsArr.length);
                const initialWindowPoints = pointsArr.slice(0, initialWindowSize);
                const initialWindowCenter = getCentroid(initialWindowPoints);
                const initialWindowMaxDistance = initialWindowCenter
                    ? initialWindowPoints.reduce((max, candidate) => {
                        const distance = calculateDistance(candidate.latitude, candidate.longitude, initialWindowCenter.latitude, initialWindowCenter.longitude, 'meters');
                        return Math.max(max, distance);
                    }, 0)
                    : Infinity;
                const startsInsideStopCluster = initialWindowPoints.length >= 2 && initialWindowMaxDistance <= radiusMeters;
                const initialPointTime = new Date(pointsArr[0].time).getTime();

                let currentMode = startsInsideStopCluster ? Mode.STOP : Mode.MOVING;
                let recentPoints = [];
                let currentSegmentPoints = [];
                let currentSegmentStartTime = null;
                let currentSegmentEndTime = null;
                let stopCenter = startsInsideStopCluster ? initialWindowCenter : null;
                let stopStartTime = startsInsideStopCluster ? initialPointTime : null;
                let stopPoint = null;
                let exitCount = 0;
                let previousStopEndTime = null;
                let currentStopStartTime = startsInsideStopCluster ? initialPointTime : null;
                let pendingTravelPoints = [];
                let pendingTravelStartPoint = null;
                let pendingTravelStartTime = null;

                const normalizeSegmentTime = (timeValue) => {
                    const time = new Date(timeValue).getTime();
                    return Number.isFinite(time) ? time : null;
                };

                const finalizeSegment = (type, points, startTime, endTime, center = null) => {
                    if (!points.length) {
                        return;
                    }

                    const startValue = normalizeSegmentTime(startTime);
                    const endValue = normalizeSegmentTime(endTime);
                    const segmentStartTime = startValue !== null && endValue !== null
                        ? Math.min(startValue, endValue)
                        : (startValue !== null ? startValue : endValue);
                    const segmentEndTime = startValue !== null && endValue !== null
                        ? Math.max(startValue, endValue)
                        : (endValue !== null ? endValue : startValue);

                    const segmentId = `segment-${detectedSegments.length + 1}`;
                    const label = type === Mode.STOP
                        ? `Stop ${new Date(segmentStartTime || startTime).toLocaleString()}`
                        : `Travel ${new Date(segmentStartTime || startTime).toLocaleString()}`;

                    let polyline = null;
                    const trackerColor = getTrackerColor(trackerId);
                    if (type === Mode.MOVING) {
                        polyline = L.polyline(points.map((point) => [point.latitude, point.longitude]), { color: trackerColor, weight: 2, opacity: 0.8 }).addTo(linesGroup);
                        segmentLayers.push(polyline);
                    } else {
                        const marker = L.marker([center.latitude, center.longitude], { icon: L.divIcon({ html: `<div style="background:${trackerColor};width:10px;height:10px;border-radius:50%;"></div>`, iconSize: [10, 10], iconAnchor: [5, 5] }) }).bindPopup(`Stop ${new Date(segmentStartTime || startTime).toLocaleString()}`).addTo(transitionGroup);
                        stopPoint = marker;
                        segmentLayers.push(marker);
                    }

                    detectedSegments.push({
                        id: segmentId,
                        trackerId: trackerId,
                        type: type === Mode.STOP ? 'stop' : 'travel',
                        label: label,
                        pointCount: points.length,
                        points: type === Mode.STOP ? [stopPoint] : points,
                        rawPoints: points,
                        center: center,
                        polyline: polyline,
                        startTime: segmentStartTime,
                        endTime: segmentEndTime,
                    });
                };

                pointsArr.forEach((point) => {
                    const pointTime = new Date(point.time).getTime();
                    recentPoints.push(point);
                    if (recentPoints.length > windowPoints) {
                        recentPoints.shift();
                    }

                    if (currentMode === Mode.MOVING) {
                        if (currentSegmentPoints.length === 0) {
                            currentSegmentPoints = [point];
                            currentSegmentStartTime = pointTime;
                            currentSegmentEndTime = pointTime;
                            return;
                        }

                        const windowCenter = getCentroid(recentPoints);
                        const maxDistanceFromCenter = recentPoints.reduce((max, candidate) => {
                            const distance = calculateDistance(candidate.latitude, candidate.longitude, windowCenter.latitude, windowCenter.longitude, 'meters');
                            return Math.max(max, distance);
                        }, 0);

                        if (maxDistanceFromCenter <= radiusMeters) {
                            exitCount = 0;
                            if (stopStartTime === null) {
                                stopStartTime = pointTime;
                                stopCenter = windowCenter;
                                currentStopStartTime = pointTime;
                            }

                            const durationSeconds = (pointTime - stopStartTime) / 1000;
                            if (durationSeconds >= minSeconds) {
                                const stopBoundaryTime = stopStartTime || pointTime;
                                const travelStartTime = previousStopEndTime || currentSegmentStartTime;
                                finalizeSegment(Mode.MOVING, currentSegmentPoints, travelStartTime, stopBoundaryTime);
                                currentSegmentPoints = [];
                                currentSegmentStartTime = null;
                                currentSegmentEndTime = null;
                                currentMode = Mode.STOP;
                                recentPoints = [];
                                stopStartTime = null;
                                stopCenter = null;
                                currentStopStartTime = stopBoundaryTime;
                            }
                        } else {
                            exitCount++;
                            currentSegmentPoints.push(point);
                            currentSegmentEndTime = pointTime;
                            if (exitCount >= exitPoints) {
                                stopStartTime = null;
                                stopCenter = null;
                                exitCount = 0;
                            }
                        }
                    } else if (currentMode === Mode.STOP) {
                        const windowCenter = getCentroid(recentPoints);
                        const stopReferenceCenter = stopCenter || windowCenter;
                        const currentPointDistanceMeters = stopReferenceCenter
                            ? calculateDistance(point.latitude, point.longitude, stopReferenceCenter.latitude, stopReferenceCenter.longitude, 'meters')
                            : 0;
                        const isCurrentPointOutsideStop = currentPointDistanceMeters > radiusMeters;

                        if (!isCurrentPointOutsideStop) {
                            exitCount = 0;
                            pendingTravelPoints = [];
                            pendingTravelStartPoint = null;
                            pendingTravelStartTime = null;
                            if (stopStartTime === null) {
                                stopStartTime = pointTime;
                                stopCenter = stopReferenceCenter || windowCenter;
                                currentStopStartTime = pointTime;
                            }
                            stopCenter = windowCenter || stopReferenceCenter;
                            currentSegmentPoints.push(point);
                            currentSegmentEndTime = pointTime;
                        } else {
                            exitCount++;
                            if (exitCount === 1) {
                                pendingTravelStartPoint = currentSegmentPoints.length ? currentSegmentPoints[currentSegmentPoints.length - 1] : point;
                                pendingTravelStartTime = currentSegmentEndTime || pointTime;
                            }
                            pendingTravelPoints.push(point);
                            if (exitCount >= exitPoints) {
                                const stopSegmentPoints = currentSegmentPoints.length ? currentSegmentPoints : [pendingTravelStartPoint || point];
                                const stopStartBoundaryTime = currentStopStartTime || pendingTravelStartTime || pointTime;
                                const stopEndTime = pendingTravelStartTime || pointTime;
                                finalizeSegment(Mode.STOP, stopSegmentPoints, stopStartBoundaryTime, stopEndTime, stopCenter);
                                const travelPoints = [];
                                if (pendingTravelStartPoint) {
                                    travelPoints.push(pendingTravelStartPoint);
                                }
                                travelPoints.push(...pendingTravelPoints);
                                currentSegmentPoints = travelPoints.length ? travelPoints : [point];
                                currentSegmentStartTime = stopEndTime;
                                currentSegmentEndTime = pointTime;
                                currentMode = Mode.MOVING;
                                stopStartTime = null;
                                stopCenter = null;
                                exitCount = 0;
                                previousStopEndTime = stopEndTime;
                                currentStopStartTime = null;
                                pendingTravelPoints = [];
                                pendingTravelStartPoint = null;
                                pendingTravelStartTime = null;
                            }
                        }
                    }
                });

                if (currentSegmentPoints.length) {
                    const segmentType = currentMode === Mode.STOP ? Mode.STOP : Mode.MOVING;
                    const fallbackStart = currentSegmentStartTime || pointsArr[0].time;
                    const fallbackEnd = currentSegmentEndTime || pointsArr[pointsArr.length - 1].time;
                    const effectiveStartTime = segmentType === Mode.MOVING
                        ? (previousStopEndTime || fallbackStart)
                        : (currentStopStartTime || fallbackStart);
                    finalizeSegment(segmentType, currentSegmentPoints, effectiveStartTime, fallbackEnd, stopCenter);
                }
            });
        }

        function processSegments(pointsMap) {

            var pointsArr = Array.from(pointsMap.values());

            var mode = Mode.MOVING; // Initial mode

            const runningAverageWindow = 5; // Number of points to consider for the running average
            var runningAveragePoints = [];
            var runningAverageLoc = {
                latitude: 0,
                longitude: 0,
            };
            var stoppedPointCount = 0;
            var movingPointCount = 0;
            const stoppedPointDistanceThreshold = 100; // Number of consecutive points below speed threshold to consider as stopped

            for (let i = 0; i < pointsArr.length; i++) {
                console.log(`Processing point ${i} with puid ${pointsArr[i].puid} in mode ${mode}`);
                console.log(`Current point: `, pointsArr[i]);
                console.log(`Running average location: `, runningAverageLoc);
                console.log(`Distance from running average: `, calculateDistance(pointsArr[i].latitude, pointsArr[i].longitude, runningAverageLoc.latitude, runningAverageLoc.longitude, 'meters'));
                console.log(`Stopped point count: ${stoppedPointCount}`);
                console.log(`Moving point count: ${movingPointCount}`);

                if (mode ===Mode.MOVING) {
                    runningAveragePoints.push(pointsArr[i]);
                    if (runningAveragePoints.length > runningAverageWindow) {
                        runningAveragePoints.shift(); // Remove the oldest point to maintain the window size
                    }
                    runningAverageLoc.latitude = runningAveragePoints.reduce((sum, p) => sum + p.latitude, 0) / runningAveragePoints.length;
                    runningAverageLoc.longitude = runningAveragePoints.reduce((sum, p) => sum + p.longitude, 0) / runningAveragePoints.length;

                    var distance = calculateDistance(pointsArr[i].latitude, pointsArr[i].longitude, runningAverageLoc.latitude, runningAverageLoc.longitude, 'meters');

                    if ((runningAverageLoc.latitude != 0) && (distance < stoppedPointDistanceThreshold)) {
                        stoppedPointCount++;
                    } else {
                        stoppedPointCount = 0; // Reset count if movement is detected
                    }

                    if (stoppedPointCount > runningAverageWindow) { // Threshold for stopping, adjust as needed
                        console.log(`Transition from STOP to MOVING at point ${pointsArr[i- runningAverageWindow].puid}`);
                        console.log(pointsArr[i- runningAverageWindow]);
                        //add a marker to the map for the stopped point
                        map.addLayer(L.marker([pointsArr[i- runningAverageWindow].latitude, pointsArr[i- runningAverageWindow].longitude]).bindPopup("Stopping Point: " + new Date(pointsArr[i- runningAverageWindow].time).toLocaleString()).addTo(map));
                        mode = Mode.STOP;
                        //i -= runningAverageWindow; // Re-evaluate points in the new moderunningAvergaePoints = [];
                        
                        // runningAveragePoints = [];
                        // runningAverageLoc = {
                        //     latitude: 0,
                        //     longitude: 0,
                        // }; //reset running average and location when stopping
                    }
                } else if (mode === Mode.STOP) {
                    runningAveragePoints.push(pointsArr[i]);
                    if (runningAveragePoints.length > runningAverageWindow) {
                        runningAveragePoints.shift(); // Remove the oldest point to maintain the window size
                    }
                    runningAverageLoc.latitude = runningAveragePoints.reduce((sum, p) => sum + p.latitude, 0) / runningAveragePoints.length;
                    runningAverageLoc.longitude = runningAveragePoints.reduce((sum, p) => sum + p.longitude, 0) / runningAveragePoints.length;

                    var distance = calculateDistance(pointsArr[i].latitude, pointsArr[i].longitude, runningAverageLoc.latitude, runningAverageLoc.longitude, 'meters');

                    if (distance >= stoppedPointDistanceThreshold) {
                        movingPointCount++;
                    } else {
                        movingPointCount = 0; // Reset count if movement is detected
                    }

                    if (movingPointCount > runningAverageWindow) { // Threshold for stopping, adjust as needed
                        console.log(`Transition from MOVING to STOP at point ${pointsArr[i- runningAverageWindow].puid}`);
                        console.log(pointsArr[i- runningAverageWindow]);
                        //add a marker to the map for the stopped point
                        map.addLayer(L.marker([pointsArr[i- runningAverageWindow].latitude, pointsArr[i- runningAverageWindow].longitude]).bindPopup("Moving Point: " + new Date(pointsArr[i- runningAverageWindow].time).toLocaleString()).addTo(map));
                        mode = Mode.MOVING;
                        //i -= runningAverageWindow; // Re-evaluate points in the new moderunningAvergaePoints = [];
                        
                        // runningAveragePoints = [];
                        // runningAverageLoc = {
                        //     latitude: 0,
                        //     longitude: 0,
                        // }; //reset running average and location when stopping
                    }
                }
            }
        }

        function renderTrackerColorControls() {
            const container = document.getElementById("trackerColorControls");
            if (!container) {
                return;
            }
            if (!trackers.length) {
                container.innerHTML = "<div style='font-size: 12px; color: #666;'>No trackers loaded yet.</div>";
                return;
            }

            container.innerHTML = trackers.map((trackerId) => {
                const color = getTrackerColor(trackerId);
                return `<label style='display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-size: 12px;'>
                    <span style='flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;'>${trackerId}</span>
                    <input type='color' value='${color}' data-tracker-id='${trackerId}' onchange='updateTrackerColor(this.getAttribute("data-tracker-id"), this.value); saveSettings(); refreshPoints();' />
                </label>`;
            }).join('');
        }

        function updateTrackerColor(trackerId, color) {
            if (!trackerId) {
                return;
            }
            trackerColors[trackerId] = color;
            saveSettings();
        }

        function processTrackers(trackersList) {
            // Process trackers as needed
            console.log("Received Trackers: ", trackersList);
            const incomingTrackers = Array.isArray(trackersList) ? trackersList : [];
            if (incomingTrackers.length) {
                allTrackers = incomingTrackers;
            }
            trackers = Array.isArray(allTrackers) ? allTrackers : [];
            const savedSettings = loadSettings();
            const queryTrackerId = new URLSearchParams(window.location.search).get('tracker_id');
            const previouslySelectedTracker = (savedSettings && savedSettings.trackerId) || document.getElementById("selTrackers").value || queryTrackerId || "";
            const selectedTrackerId = previouslySelectedTracker || "all_trackers";
            
            const selTrackers = document.getElementById("selTrackers");
            selTrackers.innerHTML = ""; // Clear existing options

            let option = document.createElement("option");
            option.value = "all_trackers";
            option.text = "All Trackers";
            if (selectedTrackerId === "all_trackers") {
                option.selected = true;
            }
            selTrackers.appendChild(option);
            
            trackers.forEach(function(tracker_id) {
                option = document.createElement("option");
                option.value = tracker_id;
                option.text = tracker_id;
                if (tracker_id === selectedTrackerId) {
                    option.selected = true;
                }
                selTrackers.appendChild(option);
            });
            if (!trackers.includes(selectedTrackerId) && trackers.length > 0) {
                selTrackers.value = "all_trackers";
            }
            applySettingsToForm(savedSettings || {});
            renderTrackerColorControls();
        }

