        }

        let segmentDrawerDragStartY = null;
        let segmentDrawerDragStartExpanded = false;

        function handleSegmentDrawerPointerDown(event) {
            const drawer = document.getElementById('segmentDrawer');
            if (!drawer || event.button === 2) {
                return;
            }
            if (event.target && event.target.closest && (event.target.closest('button') || event.target.closest('select'))) {
                return;
            }
            segmentDrawerDragStartY = event.clientY;
            segmentDrawerDragStartExpanded = drawer.classList.contains('expanded');
            if (event.currentTarget && event.currentTarget.setPointerCapture) {
                event.currentTarget.setPointerCapture(event.pointerId);
            }
        }

        function handleSegmentDrawerPointerUp(event) {
            if (segmentDrawerDragStartY === null) {
                return;
            }
            if (event.target && event.target.closest && (event.target.closest('button') || event.target.closest('select'))) {
                segmentDrawerDragStartY = null;
                return;
            }
            const drawer = document.getElementById('segmentDrawer');
            if (!drawer) {
                segmentDrawerDragStartY = null;
                return;
            }
            const deltaY = segmentDrawerDragStartY - event.clientY;
            const shouldExpand = deltaY < -40 ? true : deltaY > 40 ? false : !segmentDrawerDragStartExpanded;
            setSegmentDrawerExpanded(shouldExpand);
            segmentDrawerDragStartY = null;
        }

        function initMap() {
            const mapContainer = document.getElementById('theMap');
            if (mapContainer) {
                const isMobile = window.innerWidth <= 900;
                mapContainer.style.display = 'block';
                mapContainer.style.position = 'absolute';
                mapContainer.style.inset = '0';
                mapContainer.style.zIndex = '0';
                mapContainer.style.background = '#e5e5e5';
                mapContainer.style.borderRadius = '0';
                mapContainer.style.overflow = 'hidden';
                mapContainer.style.width = '100vw';
                mapContainer.style.maxWidth = '100vw';
                mapContainer.style.height = '100vh';
                mapContainer.style.minHeight = '100vh';
                mapContainer.style.marginLeft = '0';
            }

            const initializeLeaflet = () => {
                if (!mapContainer || map) {
                    return;
                }
                map = L.map(mapContainer, { zoomControl: true, preferCanvas: true }).setView([0, 0], 2);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                }).addTo(map);
            };
            
             // Define a custom circle icon
            circleIcon = L.divIcon({
                className: 'jpico',
                html: "<div style='background-color:#4838cc;' class='marker-pin'></div><i style='transform: rotate(GPS_COURSEdeg)' class='fa-regular fa-circle-up' style='--fa-rotate-angle: 25deg;'></i>",
                iconSize: [10, 10],
                iconAnchor: [5, 5],
                popupAnchor: [-3, -76],
            });

            const refreshMapLayout = () => {
                if (mapContainer) {
                    mapContainer.style.width = '100vw';
                    mapContainer.style.maxWidth = '100vw';
                    mapContainer.style.height = '100vh';
                    mapContainer.style.minHeight = '100vh';
                    mapContainer.style.marginLeft = '0';
                }
                if (map && map.invalidateSize) {
                    setTimeout(() => map.invalidateSize(), 0);
                    setTimeout(() => map.invalidateSize(), 100);
                }
            };

            setTimeout(refreshMapLayout, 0);
            setTimeout(refreshMapLayout, 150);
            setTimeout(() => {
                if (mapContainer) {
                    mapContainer.style.height = '100vh';
                    mapContainer.style.minHeight = '100vh';
                    mapContainer.style.width = '100vw';
                    mapContainer.style.maxWidth = '100vw';
                    mapContainer.style.marginLeft = '0';
                    initializeLeaflet();
                }
            }, 300);

            window.addEventListener('resize', refreshMapLayout);

            const drawerHandle = document.getElementById('segmentDrawerHandle');
            if (drawerHandle) {
                drawerHandle.addEventListener('pointerdown', handleSegmentDrawerPointerDown);
                drawerHandle.addEventListener('pointerup', handleSegmentDrawerPointerUp);
                drawerHandle.addEventListener('pointercancel', () => {
                    segmentDrawerDragStartY = null;
                });
            }

            // var circleIcon = L.icon({
            //     iconUrl: '/map-point.png',
            //     iconSize: [10, 10],
            //     iconAnchor: [5, 5],
            //     popupAnchor: [-3, -76],
            //     className: 'jpico'
            // });
        }

        function initDateTimePicker() {
            const picker = $('input[name="datetimes"]').daterangepicker({
                timePicker: true,
                startDate: moment().startOf('hour').add(-14, 'hour'),
                endDate: moment(),
                locale: {
                    format: 'M/DD hh:mm A'
                }
            });

            picker.on('apply.daterangepicker', function() {
                saveSettings();
            });
        }

        function loadTrackers() {
            const xhttp = new XMLHttpRequest();
            xhttp.onload = function() {
                try {
                    const response = JSON.parse(this.responseText);
                    processTrackers(Array.isArray(response) ? response : response.trackers || []);
                    loadTrackersAndPoints();
                } catch (err) {
                    console.error("Failed to load trackers", err);
                }
            }
            xhttp.open("GET", "/trackers", true);
            xhttp.send();
        }

        function getOrCreateManualUpdatesClientId() {
            if (manualUpdatesClientId) {
                return manualUpdatesClientId;
            }

            const storageKey = 'manualMqttUpdatesClientId';
            try {
                if (window.localStorage) {
                    const existingId = window.localStorage.getItem(storageKey);
                    if (existingId) {
                        manualUpdatesClientId = existingId;
                        return manualUpdatesClientId;
                    }
                }
            } catch (err) {
                console.warn('Unable to read manual update client ID from localStorage', err);
            }

            const randomPart = Math.random().toString(16).slice(2);
            manualUpdatesClientId = `viewer-${Date.now()}-${randomPart}`;
            try {
                if (window.localStorage) {
                    window.localStorage.setItem(storageKey, manualUpdatesClientId);
                }
            } catch (err) {
                console.warn('Unable to store manual update client ID to localStorage', err);
            }

            return manualUpdatesClientId;
        }

        function postJson(url, payload) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload || {}),
            });
        }

        function stopManualUpdatesKeepAlive() {
            if (manualUpdatesKeepAliveTimer) {
                clearInterval(manualUpdatesKeepAliveTimer);
                manualUpdatesKeepAliveTimer = null;
            }
        }

        function sendManualUpdatesKeepAlive() {
            const clientId = getOrCreateManualUpdatesClientId();
            postJson('/api/mqtt/manual-updates/keepalive', { clientId }).catch((err) => {
                console.warn('Manual MQTT keepalive failed', err);
            });
        }

        function startManualUpdatesKeepAlive() {
            stopManualUpdatesKeepAlive();
            sendManualUpdatesKeepAlive();
            manualUpdatesKeepAliveTimer = setInterval(sendManualUpdatesKeepAlive, manualUpdatesKeepAliveSeconds * 1000);
        }

        function getManualMqttIntervalSeconds() {
            const select = document.getElementById('manualMqttIntervalSelect');
            const intervalSeconds = parseInt(select && select.value, 10);
            return Number.isFinite(intervalSeconds) ? intervalSeconds : 0;
        }

        function updateManualUpdateWatcherFromUi() {
            const clientId = getOrCreateManualUpdatesClientId();
            const intervalSeconds = getManualMqttIntervalSeconds();

            if (intervalSeconds > 0) {
                postJson('/api/mqtt/manual-updates/watch', { clientId, intervalSeconds })
                    .then(() => {
                        startManualUpdatesKeepAlive();
                    })
                    .catch((err) => {
                        console.warn('Unable to register manual MQTT updates watcher', err);
                    });
                return;
            }

            stopManualUpdatesKeepAlive();
            postJson('/api/mqtt/manual-updates/unwatch', { clientId }).catch((err) => {
                console.warn('Unable to unregister manual MQTT updates watcher', err);
            });
        }

        window.addEventListener('beforeunload', function() {
            const clientId = getOrCreateManualUpdatesClientId();
            stopManualUpdatesKeepAlive();

            if (navigator.sendBeacon) {
                const payload = new Blob([JSON.stringify({ clientId })], { type: 'application/json' });
                navigator.sendBeacon('/api/mqtt/manual-updates/unwatch', payload);
                return;
            }

            fetch('/api/mqtt/manual-updates/unwatch', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ clientId }),
                keepalive: true,
            });
        });

        $(function(){

            initMap();
            initDateTimePicker();

            const settings = loadSettings();
            applySettingsToForm(settings);
            updateManualUpdateWatcherFromUi();

            const ensureMapReady = () => {
                if (!map) {
                    setTimeout(ensureMapReady, 50);
                    return;
                }
                linesGroup = L.layerGroup();
                linesGroup.addTo(map);
                transitionGroup = L.layerGroup();
                transitionGroup.addTo(map);
                liveMarkersGroup = L.layerGroup();
                liveMarkersGroup.addTo(map);
                loadTrackers();
            };

            ensureMapReady();

        });
        
        function debounce(callback, wait = 1000) {
            let timeout;
            return function executedFunction(...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => callback.apply(this, args), wait);
            };
        }

        // Usage
        const refreshPoints = debounce(() => {
            saveSettings();
            loadTrackersAndPoints();
        }, 150);

        function quickDaysAgoUpdated() {
            $("#inp_quick_days").val('')
            $("#inp_quick_hours").val('')
            let inputX = parseInt($("#inp_quick_days_ago").val());
            
            if (typeof inputX !== 'number' || inputX < 0) {
                console.error("Input must be >= 0");
                return;
            }

            $('#sel_datetimes').data('daterangepicker').setStartDate(moment().subtract(inputX, 'days').startOf('day'));
            $('#sel_datetimes').data('daterangepicker').setEndDate(moment().subtract(inputX-1, 'days').startOf('day'));

            refreshPoints();
        }

        function quickDaysUpdated() {
            $("#inp_quick_days_ago").val('')
            $("#inp_quick_hours").val('')
            let inputX = parseInt($("#inp_quick_days").val());
            
            if (typeof inputX !== 'number' || inputX < 1) {
                console.error("Input must be >= 1");
                return;
            }

            $('#sel_datetimes').data('daterangepicker').setStartDate(moment().subtract(inputX-1, 'days').startOf('day'));
            $('#sel_datetimes').data('daterangepicker').setEndDate(moment());

            refreshPoints();
        }

        function quickHoursUpdated() {
            $("#inp_quick_days").val('')
            $("#inp_quick_days_ago").val('')
            let inputX = parseInt($("#inp_quick_hours").val());
            
            if (typeof inputX !== 'number' || inputX < 1) {
                console.error("Input must be >= 1");
                return;
            }

            $('#sel_datetimes').data('daterangepicker').setStartDate(moment().subtract(inputX-1, 'hours').startOf('hour'));
            $('#sel_datetimes').data('daterangepicker').setEndDate(moment());

            refreshPoints();
        }



    </script>
